---
import newReleases from '../../new_releases.json';
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FANZA 最新AVランキング | 毎日自動更新</title>
  <style>
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      background-color: #121212;
      color: #ffffff;
      margin: 0;
      padding: 20px;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
    }
    h1 {
      text-align: center;
      color: #ff4757;
      margin-bottom: 30px;
      font-size: 1.8rem;
    }
    .card {
      background: #1e1e1e;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 25px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.5);
      display: flex;
      flex-direction: column;
      gap: 15px;
    }
    @media(min-width: 600px) {
      .card {
        flex-direction: row;
      }
    }
    .card-img {
      width: 100%;
      max-width: 240px;
      border-radius: 8px;
      object-fit: cover;
      margin: 0 auto;
    }
    .card-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .rank-badge {
      display: inline-block;
      background: #ff4757;
      color: #fff;
      font-weight: bold;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.9rem;
      margin-bottom: 8px;
    }
    .title {
      font-size: 1.1rem;
      font-weight: bold;
      line-height: 1.4;
      margin: 0 0 10px 0;
      color: #fff;
    }
    .meta {
      font-size: 0.85rem;
      color: #aaa;
      margin-bottom: 12px;
    }
    .ai-box {
      background: rgba(255, 71, 87, 0.1);
      border-left: 4px solid #ff4757;
      padding: 10px 14px;
      border-radius: 6px;
      margin-bottom: 15px;
      font-size: 0.9rem;
      line-height: 1.5;
      color: #ddd;
    }
    .ai-title {
      font-weight: bold;
      color: #ff6b81;
      font-size: 0.8rem;
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .btn {
      display: block;
      text-align: center;
      background: linear-gradient(135deg, #ff4757, #ff6b81);
      color: white;
      text-decoration: none;
      font-weight: bold;
      padding: 12px;
      border-radius: 8px;
      transition: opacity 0.2s;
    }
    .btn:hover {
      opacity: 0.9;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>🔥 FANZA 最新作ランキング</h1>
    <div class="list">
      {newReleases.map((item) => (
        <div class="card">
          <img src={item.image_url} alt={item.title} class="card-img" />
          <div class="card-content">
            <div>
              <span class="rank-badge">第 {item.no} 位</span>
              <h2 class="title">{item.title}</h2>
              <div class="meta">
                <p>出演: {item.actress && item.actress.length > 0 ? item.actress.join(', ') : '単体 / 不明'}</p>
                <p>メーカー: {item.maker}</p>
              </div>
              {item.comment && (
                <div class="ai-box">
                  <div class="ai-title">🤖 AI見どころレビュー</div>
                  <div>{item.comment}</div>
                </div>
              )}
            </div>
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="btn">
              作品の詳細・動画を見る ➔
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</body>
</html>
