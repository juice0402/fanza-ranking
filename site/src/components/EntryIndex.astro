---
// シリーズ・レーベルの一覧（/series/・/label/。2026-10-07）。作品数の多い順のタイル（メーカーの一覧と同じ形）
import Base from '../layouts/Base.astro';
import Breadcrumb from './Breadcrumb.astro';
import { SITE_NAME, breadcrumbLd } from '../lib/items.js';
import { listIndexable } from '../lib/plan.js';

// groups: groupByEntry のまとまり（作品数の多い順）。kind: 'series' か 'label'。path: この一覧のページ
const { groups, kind, path, today } = Astro.props;
const word = kind === 'series' ? 'シリーズ' : 'レーベル';
const ym = `${+today.slice(0, 4)}年${+today.slice(5, 7)}月`;
const trail = [
  { name: 'トップ', path: '/' },
  { name: `${word}から探す`, path },
];
const noindex = groups.length === 0 || !listIndexable(groups.flatMap((g) => g.items));
---

<Base
  title={`FANZAの${word}一覧（${groups.length}件）新作・作品【${ym}】｜${SITE_NAME}`}
  description={`FANZAの作品を、${word}ごとにまとめた一覧です（${groups.length}件・作品数の多い順）。${word}のページでは、次の新作・セール中の作品・人気の作品・よく出ている女優も見られます。毎日更新。`}
  path={path}
  noindex={noindex}
  jsonLd={[breadcrumbLd(trail)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">{word}から探す</h1>
      <p class="hero-lead">掲載している作品が3本以上ある{word}を、作品数の多い順に並べています。</p>
    </section>

    <section class="section" aria-labelledby="entry-list-title">
      <h2 id="entry-list-title" class="visually-hidden">{word}の一覧</h2>
      {groups.length > 0
        ? (
          <ul class="name-grid">
            {groups.map((g) => (
              <li>
                <a class="name-link" href={g.path} title={g.name}>
                  <span class="name-link-name">{g.name}</span>
                  <span class="name-link-count">{g.items.length}本</span>
                </a>
              </li>
            ))}
          </ul>
        )
        : <p class="empty">まだ一覧に載せられる{word}がありません。毎日の更新をお待ちください。</p>}
    </section>
  </div>
</Base>
