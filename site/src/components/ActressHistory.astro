---
// 女優のページの「歩み」（年表）。運営者の希望「世界一の女優深掘りサイトにしたい」。2026-10-27。部品は lib/history.js。
// 見せるもの: 紹介文（Claude が数字だけで書いたもの。あれば）・本数の1行・年ごとの本数の棒・年譜（いちばん古い作品・メーカーごと・VR・節目・いちばん新しい作品）・
// よく共演している人・多いジャンル・内訳。数字はどれも FANZA の作品から数えたもの（scripts/actress_history.py）。私生活・うわさは扱わない。
// 作品のタイトルは、このサイトに作品ページがあればリンクにする。未成年を連想させるタイトルは出さない（isMinorTitle）
import { paged, actressByName, contentGenres } from '../lib/data.js';
import { historyGenres, historyLine, historyTimeline, peakYear, yearBars, yearTicks } from '../lib/history.js';
import { isMinorTitle } from '../lib/gacha.js';
import { itemPath, truncate } from '../lib/items.js';

interface Props {
  name: string;
  history: any;
  story?: any;
}
const { name, history: h, story } = Astro.props;
const bars = yearBars(h);
const ticks = new Set(yearTicks(bars));
const peak = peakYear(h);
const max = Math.max(1, ...bars.map((b) => b.n));
const showValues = bars.length <= 12;
const timeline = historyTimeline(h);
const genres = historyGenres(h, contentGenres);
const checked = `${+h.checked.slice(5, 7)}月${+h.checked.slice(8, 10)}日`;
const titleOf = (row) => (row.t && !isMinorTitle(row.t) ? truncate(row.t, 48) : '');
const breakdown = [h.solo > 0 && `単体${h.solo}本`, h.best > 0 && `ベスト・総集編${h.best}本`, h.vr && `VR${h.vr.n}本`].filter(Boolean);
const barsLabel = bars.map((b) => `${b.year}年${b.n}本`).join('、');
---

<section class="section hist" aria-labelledby="hist-title">
  <div class="section-head">
    <h2 id="hist-title" class="section-title">{name}さんの歩み</h2>
    <p class="section-note note-source">FANZAの作品から数えています（{checked}時点）</p>
  </div>
  {story && <p class="hist-story">{story.text}</p>}
  <p class="hist-lead">{historyLine(h)}</p>

  {bars.length > 1 && (
    <figure class="hist-chart">
      <div class="hist-bars" style={`--cols:${bars.length}`} role="img" aria-label={`年ごとの本数: ${barsLabel}`}>
        {bars.map((b) => (
          <div class:list={['hist-col', { 'is-peak': peak && b.year === peak.year }]}>
            <span class="hist-val">{(showValues || (peak && b.year === peak.year) || b === bars[bars.length - 1]) && b.n > 0 ? b.n : ''}</span>
            <span class="hist-bar" style={`--h:${b.n > 0 ? Math.max(3, Math.round((b.n / max) * 100)) : 0}%`}></span>
          </div>
        ))}
      </div>
      <div class="hist-years" style={`--cols:${bars.length}`} aria-hidden="true">
        {bars.map((b) => <span>{ticks.has(b.year) ? b.year : ''}</span>)}
      </div>
      {peak && <figcaption class="hist-cap">いちばん多いのは{peak.year}年の{peak.n}本{peak.makers[0] ? `（${peak.makers[0].name}が${peak.makers[0].n}本）` : ''}</figcaption>}
    </figure>
  )}

  {timeline.length > 0 && (
    <dl class="hist-line">
      {timeline.map((row) => (
        <>
          <dt class="hist-when">{row.when}</dt>
          <dd class="hist-what">
            <span class="hist-label">{row.label}</span>
            {titleOf(row) && (paged.has(row.c) ? <a class="hist-title" href={itemPath(row.c)}>{titleOf(row)}</a> : <span class="hist-title">{titleOf(row)}</span>)}
            {!titleOf(row) && row.m && !row.label.startsWith(row.m) && <span class="hist-title">{row.m}</span>}
          </dd>
        </>
      ))}
    </dl>
  )}

  {(h.costars.length > 0 || genres.length > 0 || breakdown.length > 0) && (
    <dl class="spec hist-spec">
      {h.costars.length > 0 && (
        <>
          <dt class="spec-term">よく共演</dt>
          <dd class="spec-desc">
            {h.costars.map((c, i) => (
              <>
                {i > 0 && '、'}
                {actressByName.get(c.name) ? <a class="spec-link" href={actressByName.get(c.name).path}>{c.name}</a> : c.name}
                {`（${c.n}本）`}
              </>
            ))}
          </dd>
        </>
      )}
      {genres.length > 0 && (
        <>
          <dt class="spec-term">多いジャンル</dt>
          <dd class="spec-desc">{genres.map((g) => `${g.name}（${g.n}本）`).join('、')}</dd>
        </>
      )}
      {breakdown.length > 0 && (
        <>
          <dt class="spec-term">内訳</dt>
          <dd class="spec-desc">{breakdown.join('・')}</dd>
        </>
      )}
    </dl>
  )}
</section>
