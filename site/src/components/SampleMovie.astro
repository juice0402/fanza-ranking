---
// FANZAのサンプル動画（公式の埋め込み。476x306の再生ページ）。
// ページを開いた時点では、FANZAの再生ページ（重い）を読み込まず、パッケージ画像と「再生」ボタンだけを出す（表示を速くするため）。
// ボタンを押すと、site/public/movie.js が、その場に再生ページ（iframe）を入れる。
// 画面の幅に合わせて小さく（大きく）見せる処理も movie.js（枠の幅 ÷ 476 の倍率で、枠の中のiframeを拡大・縮小する）。
// JavaScript が使えないときは、<noscript> の中の再生ページが、そのまま出る。
// 見られない環境（国の制限・読み込み失敗）のために、FANZAで見るリンクを添える。
const { src, title = '', fallbackUrl = '', poster = '' } = Astro.props;
const frameTitle = `${title} のサンプル動画`;
---

<div class="movie" data-movie>
  <div class="movie-box">
    <button type="button" class="movie-play" data-movie-src={src} data-movie-title={frameTitle} aria-label="サンプル動画を再生する">
      {poster && <img class="movie-poster" src={poster} alt="" width="800" height="538" fetchpriority="high" />}
      <span class="movie-play-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M8 5.5v13l11-6.5z" /></svg></span>
      <span class="movie-play-label">サンプル動画を再生</span>
    </button>
    <noscript>
      <iframe class="movie-frame" src={src} width="476" height="306" title={frameTitle} loading="lazy" scrolling="no" frameborder="0" allowfullscreen></iframe>
    </noscript>
  </div>
  <p class="movie-note">
    サンプル動画（FANZA提供）
    {fallbackUrl && <>｜見られないときは <a class="movie-link" href={fallbackUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">FANZAで見る</a></>}
  </p>
</div>
