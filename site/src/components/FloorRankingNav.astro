---
// 同人・ゲームの「ランキング」の切りかえ（作品・サークル/ブランド・作家・同人の形式ごと。2026-10-09）。
// current: 'works'（作品の人気ランキング）・'maker'・'author'・同人の形式（'comic' など）。行き先のあるものだけ出す
import { FLOORS, floorEntityLabel, floorEntityRankingPath, floorRankingPath } from '../lib/floors.js';
import { floorCollectionGroups, floorEntityRankings } from '../lib/data.js';

const { floorKey, current = '' } = Astro.props;
const f = FLOORS[floorKey];
const ranks = floorEntityRankings[floorKey];
const links = [
  { key: 'works', name: '作品', href: floorRankingPath(floorKey) },
  ...['maker', 'author'].filter((by) => ranks[by]?.length > 0).map((by) => ({ key: by, name: floorEntityLabel(f, by), href: floorEntityRankingPath(floorKey, by) })),
  ...floorCollectionGroups[floorKey].type.map((g) => ({ key: g.slug, name: g.name, href: g.path })),
];
---

{links.length > 1 && (
  <nav class="floor-tabs rank-nav" aria-label="ランキングの種類">
    {links.map((l) => <a class="chip-link" href={l.href} aria-current={l.key === current ? 'page' : undefined}>{l.name}</a>)}
  </nav>
)}
