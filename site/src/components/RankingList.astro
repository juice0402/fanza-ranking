---
// 新着の人気ランキングのページの中身（/ranking/。lib/popularity.js）。「全体の人気ランキング」（/ranking/all/）は、運営者の判断でやめた（2026-10-05）。
// 順位は、毎日の更新が、その日のFANZAの人気順を取り直したもの。並べるのは、このサイトに載っている作品だけ（1位から順に番号をふり直す）
import Breadcrumb from './Breadcrumb.astro';
import VrToggle from './VrToggle.astro';
import ItemCard from './ItemCard.astro';
import { formatDateJp, filterAttrs } from '../lib/items.js';
import { NEW_RANK_DAYS } from '../lib/popularity.js';
import { popularity, rankHistory, reviewRanking } from '../lib/data.js';
import { rankNote } from '../lib/insights.js';
import { REVIEW_RANKING_MIN_ITEMS, REVIEW_RANKING_PATH } from '../lib/reviews.js';

// list: 並べる作品（順位の順）。date: 順位を取った日
const { list, date, trail } = Astro.props;
---

<div class="wrap">
  <Breadcrumb trail={trail} />

  <section class="hero">
    <h1 class="hero-title">新着の人気ランキング</h1>
    <p class="hero-lead">
      {`最近${NEW_RANK_DAYS === 7 ? '1週間' : `${NEW_RANK_DAYS}日`}に発売された作品の、その日の人気順です（毎日入れかわります）。`}
    </p>
    {reviewRanking.length >= REVIEW_RANKING_MIN_ITEMS && <p class="hero-links"><a class="spec-link" href={REVIEW_RANKING_PATH}>レビューの評価が高い作品は、高評価ランキングへ</a></p>}
  </section>

  <section class="section" aria-labelledby="ranking-title">
    <div class="section-head">
      <h2 id="ranking-title" class="section-title">新着の人気順{list.length > 0 && ` TOP${list.length}`}</h2>
      {date && <p class="section-note">{formatDateJp(date)}のFANZAの人気順（▲▼は前の日から・最高は記録を始めてからの最高順位）</p>}
    </div>
    {list.length > 0
      ? (
        <>
          <div class="list-tools">
            <VrToggle />
          </div>
          <ul class="shelf">
            {list.map((item, i) => (
              <li class="shelf-cell" {...filterAttrs(item)}><ItemCard item={item} level="h3" badge={`${i + 1}位`} eager={i < 4} note={rankNote(item, popularity.prevRank, rankHistory.get(item.cid))} noteKind="rank" /></li>
            ))}
          </ul>
        </>
      )
      : <p class="empty">人気順のデータは、毎日の更新（日付が変わった直後）のあとに表示されます。</p>}
  </section>
</div>
