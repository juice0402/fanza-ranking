---
// きょうの新着人気TOP3（トップ）。🥇🥈🥉のメダルで、スマホでも横に3本並べる（運営者の希望。2026-10-04 夜）。
// メダルは小さく、表紙の左下のふちに半分かける（表紙の上のほうの顔を隠さない。運営者の希望。2026-10-05）。
// データは TOP_DATA 本（6本）。画面に出すのは先頭の3本で、「VR作品を隠す」ときは、VRを除いて次の順位から差し替える
// （site/public/vr-filter.js が、rank-off・data-place（メダルの色）・順位の数字を付け直す。.rank-podium・.rank-cell・.rank-badge はその目印）
// 発売日（メダルの横）と、前の日からの順位の動き（▲3・▼1・→・初登場。表紙の右上のふちの小さな札）も出す（毎日見に来たとき、何が変わったかが分かるように）
import { paged, popularity } from '../lib/data.js';
import { itemHref, OUTBOUND_ATTRS } from '../lib/plan.js';
import { castLine, dateParts, filterAttrs, isSoloWork } from '../lib/items.js';
import { TOP_SHOWN, rankMove } from '../lib/topics.js';
import Thumb from './Thumb.astro';

// entries: 新着の人気順の作品（作品データの形）か、売れ筋ランキング（ranking.json）の作品
const { entries } = Astro.props;
const shown = Math.min(entries.length, TOP_SHOWN);
---

<ol class="medals rank-podium" data-show={TOP_SHOWN} data-visible={shown}>
  {entries.map((item, i) => {
    const link = itemHref(item, paged);
    const place = i < TOP_SHOWN ? i + 1 : undefined;
    const day = item.dateKey || item.date;
    const md = day ? dateParts(day) : null;
    const move = item.popNew ? rankMove(item.cid, item.popNew, popularity.prevRank) : null;
    return (
      <li class={`medal-cell rank-cell${i >= TOP_SHOWN ? ' rank-off' : ''}`} data-rank={i + 1} data-place={place} {...filterAttrs({ ...item, solo: item.solo ?? isSoloWork(item) })}>
        <a class="medal-card" href={link.href} {...(link.external ? OUTBOUND_ATTRS : {})}>
          <span class="medal-art">
            <span class="medal-cover">
              {item.image_url && <Thumb src={item.image_url} kind="card" loading={i < TOP_SHOWN ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />}
            </span>
            <span class="medal rank-badge">{i + 1}位</span>
            {move && <span class={`medal-move move-${move.kind}`} title={move.label}><span class="visually-hidden">{move.label}</span><span aria-hidden="true">{move.text}</span></span>}
          </span>
          <span class="medal-meta">{md && <span class="medal-date">{md.m}/{md.d}発売</span>}</span>
          <span class="medal-title">{item.title}</span>
          <span class="medal-cast">{castLine(item.actress, 2)}</span>
        </a>
      </li>
    );
  })}
</ol>
