---
// 小さな表紙の棚（作品ページの「同じ出演者・メーカーの作品」。2026-10-06）。
// 表紙・タイトル（2行）・出演者（1行）だけの小さなカードを、置かれた場所の幅に合わせて3〜6列に並べる（FANZAへのボタンは付けない。押すと作品ページへ。
// 作品ページが無い作品はFANZAへ）。大きなカードを8枚並べていたときより、すっきり見えて、次の作品を選びやすい（運営者の希望「スッキリした見た目に」）
import { paged } from '../lib/data.js';
import { itemHref, OUTBOUND_ATTRS } from '../lib/plan.js';
import { castLine, filterAttrs } from '../lib/items.js';
import Thumb from './Thumb.astro';

// rate: 出演者の代わりに、FANZAのレビューの評価（★4.71（31件））を出す（「評価の高い作品」の棚。2026-10-10）
// rank: タイトルの前に順位（1から。ジャンルの「FANZA全体で人気の作品」。2026-10-10）
// note: 出演者の代わりに出す短い文（作品 → 文。空なら出演者。読み物の「いまセール中」の割引・「新作と予約」の発売日。2026-10-28）
// saleEnd: セールの終わり（作品 → 時刻。すぎたらブラウザで隠す /sale.js。ページの側で読み込む）
// keepVr: 「VR作品を隠す」を選んでいても隠さない（VRの読み物。そこで全部が消えて空になるのを防ぐ）
const { items, level = 'h3', rate = false, rank = false, note = () => '', saleEnd = () => '', keepVr = false } = Astro.props;
const Heading = level;
---

<ul class="mini-shelf">
  {items.map((i, n) => {
    const link = itemHref(i, paged);
    const outbound = link.external ? OUTBOUND_ATTRS : {};
    return (
      <li class="shelf-cell mini-cell" {...filterAttrs(i, { vr: !keepVr })} {...(saleEnd(i) ? { 'data-sale-end': saleEnd(i) } : {})}>
        <a class="mini-card" href={link.href} {...outbound}>
          <span class="mini-cover">{i.image_url && <Thumb src={i.image_url} kind="tiny" class="item-img is-small" />}</span>
          <Heading class="mini-title">{rank && <span class="mini-rank">{n + 1}</span>}{i.title}</Heading>
          {rate && i.review
            ? <span class="mini-cast mini-rate"><span class="rate-star">★{i.review.avg.toFixed(2)}</span>（{i.review.count.toLocaleString('ja-JP')}件）</span>
            : note(i) ? <span class="mini-cast mini-note">{note(i)}</span>
            : <span class="mini-cast">{castLine(i.actress, 1, '')}</span>}
        </a>
      </li>
    );
  })}
</ul>
