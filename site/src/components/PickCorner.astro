---
// 発売中の新作の、きょうの日付のすぐ下に入れる「おすすめのコーナー」（運営者の希望。2026-10-05）:
//   今週のデビュー作（人気順に3本）→ 誕生日の近い女優（顔写真があり、このサイトに作品がある人）。
//   スマホ・タブレット（〜959px）では、CSS（.corner > #birthdays の order）で、誕生日の近い女優 → 今週のデビュー作 の順に見せる（運営者の希望。2026-10-06）
// 運命の作品は、スマホでは発売中の新作のいちばん下（予約受付中の真上）に分けた（GachaCorner.astro。運営者の希望。2026-10-05 夜）。
// 囲みの枠は付けない（運営者の希望「黄色の点線で囲む必要はない」。2026-10-05 夜）
import Face from './Face.astro';
import { actressByName, faceOfName, paged } from '../lib/data.js';
import { itemHref, OUTBOUND_ATTRS } from '../lib/plan.js';
import { SMALL_IMG_ONERROR, castLine, dateParts, filterAttrs, smallImage } from '../lib/items.js';
import { DEBUT_SHOWN } from '../lib/topics.js';
import { SEARCH_PATH } from '../lib/search.js';

// debuts: 今週のデビュー作（weekDebuts）／ birthdays: 誕生日の近い女優（birthdaySoon）
const { debuts, birthdays } = Astro.props;
const hrefOf = (name) => actressByName.get(name)?.path ?? `${SEARCH_PATH}?q=${encodeURIComponent(name)}`;
const mdText = (md) => `${+md.slice(0, 2)}月${+md.slice(3, 5)}日`;
const whenText = (b) => (b.days === 0 ? 'きょうが誕生日' : b.days === 1 ? `あす${mdText(b.md)}が誕生日` : `${mdText(b.md)}が誕生日（あと${b.days}日）`);
---

<div id="pick-corner" class="corner" aria-label="おすすめ">
  {debuts.length > 0 && (
    <section id="debuts" class="corner-block" aria-labelledby="debuts-title" data-rank-section>
      <div class="corner-head">
        <h3 id="debuts-title" class="corner-title">今週のデビュー作</h3>
        <p class="section-note">この7日間に発売・人気順</p>
      </div>
      <ol class="debut-list rank-podium" data-show={DEBUT_SHOWN} data-visible={Math.min(debuts.length, DEBUT_SHOWN)}>
        {debuts.map((item, i) => {
          const link = itemHref(item, paged);
          const md = dateParts(item.dateKey);
          return (
            <li class={`debut-cell rank-cell${i >= DEBUT_SHOWN ? ' rank-off' : ''}`} data-rank={i + 1} {...filterAttrs(item)}>
              <a class="debut-card" href={link.href} {...(link.external ? OUTBOUND_ATTRS : {})}>
                <span class="debut-cover">{item.image_url && <img class="item-img is-small" src={smallImage(item.image_url)} alt="" loading="lazy" decoding="async" onerror={SMALL_IMG_ONERROR} />}</span>
                <span class="debut-name">{castLine(item.actress, 1, item.maker !== '不明' ? item.maker : '')}</span>
                <span class="debut-date">{md.m}/{md.d}発売</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  )}

  {birthdays.length > 0 && (
    <section id="birthdays" class="corner-block" aria-labelledby="birthdays-title">
      <div class="corner-head">
        <h3 id="birthdays-title" class="corner-title">誕生日の近い女優</h3>
      </div>
      <ol class="hot bday">
        {birthdays.map((b) => (
          <li class="hot-cell">
            <a class="hot-link" href={hrefOf(b.name)}>
              <span class="hot-face"><Face name={b.name} src={faceOfName(b.name, true)} size="lg" /></span>
              <span class="hot-name">{b.name}</span>
              <span class={b.days === 0 ? 'bday-when is-today' : 'bday-when'}>{whenText(b)}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}
</div>
