---
// 作品ページの「発売後の人気の動き」（運営者の希望「独自の価値を足す」。2026-10-07。lib/insights.js の trendChart・trendLines）。
// 毎日の更新が記録した、新着の人気順（その日の上位500本）の毎日の順位。1日1点の線（対数の目盛り。1位が上）。
// 圏外の日は下のふちの小さな印、取れなかった日は何も描かない。点にふれると、その日の順位が出る（SVG の title）。
// 読み上げ用に、毎日の順位を文字の一覧でも入れておく（画面には出さない）。順位が分かる日が2日に満たないときは、文だけ
// 同人・ゲームの作品ページも、この部品を使う（2026-10-09。max・title・caption・lines を渡す。30日分なので、日付の目もりは間引く）
import { TREND_MAX_RANK, trendChart, trendLines } from '../lib/insights.js';
import { addDays } from '../lib/items.js';

const {
  hist,
  max = TREND_MAX_RANK,
  title = '発売後の人気の動き',
  caption = '新着の人気順（最近1週間に発売された作品の、その日のFANZAの人気順）の毎日の順位。毎日0時すぎの時点で記録しています。',
  lines: givenLines,
} = Astro.props;
const chart = trendChart(hist, { max });
const lines = givenLines ?? trendLines(hist);
const md = (d) => `${+d.slice(5, 7)}月${+d.slice(8, 10)}日`;
// 日付の目もり: はじめ・おわりと、every 日ごと（8日分なら1日おき。30日分なら5日おき）。おわりのすぐ手前の目もりは、数字が重なるので外す
const nDays = chart ? chart.days.length : 0;
const every = Math.max(2, Math.ceil(nDays / 6));
const showDay = (i) => i === 0 || i === nDays - 1 || nDays <= 5 || (i % every === 0 && nDays - 1 - i >= Math.ceil(every / 2));
---

{lines.length > 0 && (
  <section class="subsection" aria-labelledby="trend-title">
    <h2 id="trend-title" class="subsection-title">{title}</h2>
    <ul class="trend-facts">
      {lines.map((l) => <li>{l}</li>)}
    </ul>
    {chart && (
      <figure class="trend">
        <svg class="trend-svg" viewBox={`0 0 ${chart.w} ${chart.h}`} role="img" aria-labelledby="trend-cap">
          {chart.grid.map((g) => (
            <g class="trend-grid">
              <line x1={chart.left} x2={chart.right} y1={g.y} y2={g.y} />
              <text x={chart.left - 6} y={g.y + 3.5} text-anchor="end">{g.rank}位</text>
            </g>
          ))}
          {chart.days.map((d, i) => showDay(i) && (
            <text class="trend-day" x={d.x} y={chart.h - 6} text-anchor="middle">{d.label}</text>
          ))}
          <path class="trend-line" d={chart.path} />
          {chart.outs.map((o) => (
            <g class="trend-out"><title>{`${md(o.date)}: ${max}位より下`}</title><line x1={o.x - 4} x2={o.x + 4} y1={chart.bottom} y2={chart.bottom} /></g>
          ))}
          {chart.points.map((p) => (
            <g class={p === chart.best ? 'trend-pt is-best' : 'trend-pt'}>
              <title>{`${md(p.date)}: ${p.rank}位`}</title>
              <circle cx={p.x} cy={p.y} r="4" />
            </g>
          ))}
          {chart.best && (
            <text class="trend-best" x={Math.min(Math.max(chart.best.x, chart.left + 22), chart.right - 22)} y={Math.max(chart.best.y - 9, 10)} text-anchor="middle">{chart.best.rank}位</text>
          )}
        </svg>
        <figcaption id="trend-cap" class="fine">{caption}</figcaption>
        <ol class="visually-hidden">
          {hist.n.map((v, i) => <li>{md(addDays(hist.start, i))}: {v === null ? '記録なし' : v === 0 ? `${max}位より下` : `${v}位`}</li>)}
        </ol>
      </figure>
    )}
  </section>
)}
