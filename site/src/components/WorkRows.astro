---
// 作品の小さな行の一覧（作品検索の結果・週のまとめの全作品と同じ「小さな表紙＋タイトル・出演者」の形。スマホ1列・広い画面2列）。
// 出演者のページの「次の新作」「セール中の作品」で使う（2026-10-06）。note: 作品ごとの短い文（発売日・価格など）、saleEnd: セールの終わり（すぎたらブラウザで隠す）
import { paged } from '../lib/data.js';
import { itemHref, OUTBOUND_ATTRS } from '../lib/plan.js';
import { CAST_LIMIT, SMALL_IMG_ONERROR, castLine, filterAttrs, smallImage } from '../lib/items.js';

const { items, note = () => '', level = 'h3', saleEnd = () => '' } = Astro.props;
const Heading = level;
---

<ul class="ws-list work-rows">
  {items.map((i) => {
    const link = itemHref(i, paged);
    const outbound = link.external ? OUTBOUND_ATTRS : {};
    return (
      <li class="ws-row" {...filterAttrs(i)} {...(saleEnd(i) ? { 'data-sale-end': saleEnd(i) } : {})}>
        <article class="item">
          <a class="item-cover" href={link.href} tabindex="-1" aria-hidden="true" {...outbound}>
            {i.image_url && <img class="item-img is-small" src={smallImage(i.image_url)} alt="" loading="lazy" decoding="async" onerror={SMALL_IMG_ONERROR} />}
          </a>
          <Heading class="item-title"><a class="item-title-link" href={link.href} {...outbound}>{i.title}</a></Heading>
          <p class="item-cast">{castLine(i.actress, CAST_LIMIT, '出演者の記載なし')}</p>
          {note(i) && <p class="work-note">{note(i)}</p>}
        </article>
      </li>
    );
  })}
</ul>
