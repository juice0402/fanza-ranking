---
// 売れ筋ランキングの1本（トップページ用）。見た目は ItemCard と同じ（棚に並ぶカード）。
// 作品ページがある作品なら、作品ページへのリンク。無ければ、FANZAへのアフィリエイトリンク。
// ランキングの作品にはAIコメントを付けない（事実の情報だけを出す）。
import { itemPath } from '../lib/items.js';
import { paged } from '../lib/data.js';
import { OUTBOUND_ATTRS } from '../lib/plan.js';

// level: 見出しの階層（トップページでは「売れ筋」が h2 なので、既定は h3）
// first: 先頭（1位）の画像は、トップの最初の画面に入るので、すぐ・優先して読む
const { entry, level = 'h3', first = false } = Astro.props;
const Heading = level;
const inSite = paged.has(entry.cid);
const place = [1, 2, 3].includes(entry.rank) ? entry.rank : 0; // 1〜3位だけ、大きさを変える（見た目は site.css の .rank-1〜.rank-3）
const href = inSite ? itemPath(entry.cid) : entry.url;
const outbound = inSite ? {} : OUTBOUND_ATTRS;
---

<article class={`item rank-item rank-${place}`}>
  <a class="item-cover" href={href} tabindex="-1" aria-hidden="true" {...outbound}>
    {entry.image_url && (
      <img class="item-img" src={entry.image_url} alt="" loading={first ? 'eager' : 'lazy'} fetchpriority={first ? 'high' : undefined} decoding="async" onerror="this.style.visibility='hidden'" />
    )}
    <span class="rank-badge">{entry.rank}位</span>
  </a>
  <Heading class="item-title"><span class="visually-hidden">{entry.rank}位：</span><a class="item-title-link" href={href} {...outbound}>{entry.title}</a></Heading>
  <p class="item-cast">{entry.actress.length ? entry.actress.join('、') : '出演者の記載なし'}</p>
  {entry.maker && entry.maker !== '不明' && <p class="rank-maker">{entry.maker}</p>}
  <a class="btn btn-card btn-block" href={entry.url} target="_blank" rel="sponsored nofollow noopener noreferrer">FANZAで見る</a>
</article>
