---
// FANZA同人・FANZAゲームのページの上の案内（トップ・人気ランキング・セール・ジャンル・サークル/ブランド、もう一つの売り場へ。2026-10-09）。
// いまのページは aria-current。行き先が無いもの（セール中の作品が無い・サークル/ブランドのページが無い）は出さない
import { FLOORS, floorCollectionIndexPath, floorMakerIndexPath, floorPath, floorRankingPath, floorSalePath } from '../lib/floors.js';
import { activeFloors, floorCollectionGroups, floorMakerGroups, floors } from '../lib/data.js';
import { floorSaleItems } from '../lib/floors.js';

const { floorKey, current = '' } = Astro.props;
const f = FLOORS[floorKey];
const hasSale = floorSaleItems(floors[floorKey].items).length > 0;
const hasMakers = floorMakerGroups[floorKey].length > 0;
const hasGenres = floorCollectionGroups[floorKey].genre.length > 0;
const other = activeFloors.find((k) => k !== floorKey);
const tabs = [
  { key: 'hub', name: `${f.short}トップ`, href: floorPath(floorKey) },
  { key: 'ranking', name: '人気ランキング', href: floorRankingPath(floorKey) },
  ...(hasSale ? [{ key: 'sale', name: 'セール中', href: floorSalePath(floorKey) }] : []),
  ...(hasGenres ? [{ key: 'genre', name: 'ジャンルから探す', href: floorCollectionIndexPath(floorKey, 'genre') }] : []),
  ...(hasMakers ? [{ key: 'maker', name: `${f.maker}から探す`, href: floorMakerIndexPath(floorKey) }] : []),
  ...(other ? [{ key: 'other', name: `${FLOORS[other].label}へ`, href: floorPath(other) }] : []),
];
---

<nav class="floor-tabs" aria-label={`${f.label}の案内`}>
  {tabs.map((t) => <a class="chip-link" href={t.href} aria-current={t.key === current ? 'page' : undefined}>{t.name}</a>)}
</nav>
