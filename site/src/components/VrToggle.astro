---
// 「VR作品を隠す」「単体作品のみ表示」スイッチ（2つ並べる）。押したときの動きは site/public/vr-filter.js（JavaScriptが使えないときは出さない）。
// 状態は、この端末のブラウザの中（localStorage）にだけ保存して、サイト全体の一覧に効く（サーバーには送らない）。
// 「単体作品のみ表示」は運営者の希望（2026-10-05）。単体作品＝FANZAのジャンル「単体作品」（items.js の isSoloWork）
const { off = 'VR作品を隠す', on = 'VR作品を隠しています（解除する）', soloOff = '単体作品のみ表示', soloOn = '単体作品だけ表示しています（解除する）' } = Astro.props;
---

<button type="button" class="vr-toggle" hidden aria-pressed="false" data-vr-toggle data-off={off} data-on={on}>
  <span class="vr-toggle-mark" aria-hidden="true"></span><span class="vr-toggle-label">{off}</span>
</button>
<button type="button" class="vr-toggle" hidden aria-pressed="false" data-solo-toggle data-off={soloOff} data-on={soloOn}>
  <span class="vr-toggle-mark" aria-hidden="true"></span><span class="vr-toggle-label">{soloOff}</span>
</button>
