---
// いま人気の女優（トップ）: この1週間に発売された作品の、新着の人気TOP100によく出ている女優を3人（lib/topics.js の hotActresses）。
// 顔写真がある人だけ（運営者の希望。2026-10-05）。顔写真の丸・順位・名前（選んだ理由の数字は出さない。運営者の希望）。
// タップで出演者のページ（無ければ作品検索）へ。「VR作品を隠す」のときは、VR作品を数えない並び（.hot-novr）に入れかえる（並びが同じなら、1つだけ出す）
import Face from './Face.astro';
import { actressByName, faceOfName } from '../lib/data.js';
import { SEARCH_PATH } from '../lib/search.js';

const { list, listNoVr } = Astro.props;
const same = JSON.stringify(list.map((r) => r.name)) === JSON.stringify(listNoVr.map((r) => r.name));
const lists = same ? [{ rows: list, cls: 'hot' }] : [{ rows: list, cls: 'hot hot-all' }, { rows: listNoVr, cls: 'hot hot-novr' }];
const hrefOf = (name) => actressByName.get(name)?.path ?? `${SEARCH_PATH}?q=${encodeURIComponent(name)}`;
---

{lists.map(({ rows, cls }) => rows.length > 0 && (
  <ol class={cls}>
    {rows.map((r, i) => (
      <li class="hot-cell">
        <a class="hot-link" href={hrefOf(r.name)}>
          <span class="hot-face">
            <Face name={r.name} src={faceOfName(r.name, true)} size="lg" />
            <span class="hot-rank" aria-hidden="true">{i + 1}</span>
          </span>
          <span class="hot-name"><span class="visually-hidden">{i + 1}位 </span>{r.name}</span>
        </a>
      </li>
    ))}
  </ol>
))}
