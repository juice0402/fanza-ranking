---
// 同人・ゲームの「きょうの話題」（売り場のトップ。動画の TopicList.astro と同じ見た目・同じ CSS。lib/floors.js の floorTopics。2026-10-09）。
// 1つずつ、表紙・札（急上昇・新作で人気・セールで人気・予約で人気）・タイトル・データで決まった1行
import FloorImg from './FloorImg.astro';
import { floorItemPath, frameClass } from '../lib/floors.js';

const { topics } = Astro.props;
---

<ul class="topics">
  {topics.map((t) => (
    <li class={`topic topic-${t.kind}`}>
      <a class="topic-link" href={floorItemPath(t.item.floor, t.item.cid)}>
        <span class:list={['topic-thumb', frameClass(t.item.floor)]}>
          <FloorImg floor={t.item.floor} url={t.item.image_url} kind="tiny" />
        </span>
        <span class="topic-body">
          <span class="topic-tag">{t.label}</span>
          <span class="topic-title">{t.item.title}</span>
          <span class="topic-text">{t.text}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
