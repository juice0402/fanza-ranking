---
import '../styles/site.css';
import { SITE_NAME, SITE_URL, jsonLdScript, ACTRESS_INDEX_PATH, MAKER_INDEX_PATH } from '../lib/items.js';
import { GOOGLE_SITE_VERIFICATION } from '../config.js';
import { roundups, monthGroups, tagGroups, upcoming, upcomingEventList } from '../lib/data.js';
import { FAVORITES_PATH } from '../lib/favorites.js';
import { CALENDAR_PATH } from '../lib/calendar.js';
import { WEEKLY_INDEX_PATH } from '../lib/roundups.js';
import { MONTH_INDEX_PATH, TAG_INDEX_PATH } from '../lib/collections.js';
import { SEARCH_PATH } from '../lib/search.js';
import { RANKING_PATH } from '../lib/popularity.js';
import { SALE_PATH } from '../lib/sale.js';
import { EVENT_PATH } from '../lib/events.js';

const {
  title = SITE_NAME,
  description = '',
  path = '/',
  image = '',
  noindex = false,
  stickyCta = false,
  jsonLd = [], // 検索エンジン向けの構造化データ（オブジェクトの配列）
} = Astro.props;

const canonical = SITE_URL + path;
// 書体（Google Fonts）。表示を止めないよう、読み込み終わってから当てる（preload → onload で stylesheet に）。JavaScript が無いときは <noscript> の中のふつうの読み込み。
// 読み込むのは見出し用の Dela Gothic One だけ（2026-10-05。本文の書体は、端末に入っている日本語の書体を使う。
// 本文に日本語の書体を読み込むと、使う文字の分だけファイルが増えて重くなるため。運営者の「読み込みのストレスをフリーに」）
const FONTS_URL = 'https://fonts.googleapis.com/css2?family=Dela+Gothic+One&display=swap';
const hasUpcoming = upcoming.length > 0; // 予約の作品が無い日は、ヘッダー・フッターの「予約」（トップの #upcoming）を出さない（行き先が無いため）
import { assetUrl } from '../lib/assets.js';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="rating" content="adult" />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    <meta name="rating" content="RTA-5042-1996-1400-1577-RTA" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={jsonLdScript(data)} />)}

    {/* 「VR作品を隠す」「単体作品のみ表示」を選んでいる端末では、ページを開いた瞬間から隠す（チラつかないよう、ここで先に印を付ける）。スイッチの動きは /vr-filter.js。
         ページごとに送られる小さなスクリプトなので、説明はここ（Astro のコメント。出力されない）に書く */}
    <script is:inline>try{if(localStorage.getItem('hide-vr')==='1')document.documentElement.classList.add('hide-vr');if(localStorage.getItem('only-solo')==='1')document.documentElement.classList.add('only-solo')}catch(e){}</script>

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://pics.dmm.co.jp" />
    <link rel="preload" as="style" href={FONTS_URL} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={FONTS_URL} /></noscript>
  </head>
  <body class={stickyCta ? 'has-sticky' : ''}>
    <div id="age-gate" class="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title" hidden>
      <div class="gate-box" tabindex="-1">
        <p class="gate-mark">18+</p>
        <h2 id="gate-title" class="gate-title">18歳以上ですか？</h2>
        <p class="gate-text">このサイトにはアダルト作品の紹介が含まれます。18歳未満の方はご利用いただけません。</p>
        <div class="gate-actions">
          <button type="button" id="gate-yes" class="btn btn-hot">はい、18歳以上です</button>
          <a class="btn btn-quiet" href="https://www.google.co.jp/">いいえ（退出する）</a>
        </div>
      </div>
    </div>
    {/* 18歳確認の画面の動き（ページごとに送られるので、説明はここに書き、スクリプトは短くしてある）:
         ・確認済み（localStorage の age-ok）でなければ、画面を出し、後ろの本文を inert にして（キーボード・読み上げで触れない）、html に gate-open を付ける（後ろを動かさない）
         ・最初のフォーカスは、確認の箱そのもの（ボタンにすぐフォーカスすると、iPhone/iPad で黄色い輪が出て見えるため）。Tab で「はい」「いいえ」を行き来し、外に出ない
         ・このスクリプトは本文の途中で動くので、後ろの部品の inert は、読み込みが終わってから付ける
         ・「はい」で閉じて、確認済みを保存する（保存できない端末では、ページごとに確認が出る） */}
    <script is:inline>
      (function () {
        var gate = document.getElementById('age-gate');
        var ok = false;
        try {
          ok = localStorage.getItem('age-ok') === '1';
        } catch (e) {}
        if (ok || !gate) return;
        var box = gate.querySelector('.gate-box');
        var yes = document.getElementById('gate-yes');
        var no = gate.querySelector('a');
        function setInert(on) {
          for (var el = document.body.firstElementChild; el; el = el.nextElementSibling) {
            if (el === gate || el.tagName === 'SCRIPT') continue;
            if (on) el.setAttribute('inert', '');
            else el.removeAttribute('inert');
          }
        }
        gate.hidden = false;
        document.documentElement.classList.add('gate-open');
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () {
            if (!gate.hidden) setInert(true);
          });
        } else {
          setInert(true);
        }
        try {
          box.focus({ preventScroll: true });
        } catch (e) {
          box.focus();
        }
        gate.addEventListener('keydown', function (e) {
          if (e.key !== 'Tab') return;
          var at = document.activeElement;
          if (e.shiftKey ? at === yes || at === box : at === no) {
            e.preventDefault();
            (e.shiftKey ? no : yes).focus();
          } else if (at !== yes && at !== no) {
            e.preventDefault();
            yes.focus();
          }
        });
        yes.addEventListener('click', function () {
          try {
            localStorage.setItem('age-ok', '1');
          } catch (e) {}
          gate.hidden = true;
          document.documentElement.classList.remove('gate-open');
          setInert(false);
        });
      })();
    </script>

    <a class="skip" href="#main">本文へ移動</a>
    <noscript><p class="noscript-note">このサイトにはアダルト作品の紹介が含まれます。18歳未満の方はご利用いただけません。（JavaScriptが無効のため、年齢の確認画面を出せません）</p></noscript>

    <header class="site-head wrap">
      <div class="brand-row">
        <a class="brand" href="/">{SITE_NAME}</a>
        <span class="pr-chip">広告</span>
      </div>
      <nav class="site-nav" aria-label="メイン">
        <a class="site-nav-link" href="/#released">発売中</a>
        {hasUpcoming && <a class="site-nav-link" href="/#upcoming">予約</a>}
        <a class="site-nav-link" href={RANKING_PATH}>人気順</a>
        <a class="site-nav-link" href={SEARCH_PATH}>作品検索</a>
        <a class="site-nav-link" href={ACTRESS_INDEX_PATH}>女優検索</a>
        <a class="site-nav-link" href={FAVORITES_PATH}>★お気に入り</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <ul class="foot-list">
          <li>当サイトは18歳以上の方を対象としています。</li>
          <li>広告｜当サイトはアフィリエイト広告（FANZA）を利用しており、リンクにはアフィリエイト広告が含まれます。</li>
          <li>ひとことコメントは、出演者・メーカー・発売日などの作品情報をもとに自動で作成しており、内容の正確さは保証できません。作品の詳細は必ずFANZAの公式ページで確認してください。</li>
        </ul>
        <nav class="foot-nav" aria-label="サイト内の案内">
          <a class="foot-link" href="/#released">発売中</a>
          {hasUpcoming && <a class="foot-link" href="/#upcoming">予約</a>}
          <a class="foot-link" href={RANKING_PATH}>新着の人気ランキング</a>
          <a class="foot-link" href={SALE_PATH}>セール・キャンペーン</a>
          {upcomingEventList.length > 0 && <a class="foot-link" href={EVENT_PATH}>女優のイベント情報</a>}
          <a class="foot-link" href="/archive/1/">過去の作品</a>
          <a class="foot-link" href={SEARCH_PATH}>作品を探す</a>
          <a class="foot-link" href={FAVORITES_PATH}>お気に入り</a>
          <a class="foot-link" href={CALENDAR_PATH}>発売日カレンダー</a>
          {monthGroups.length > 0 && <a class="foot-link" href={MONTH_INDEX_PATH}>月ごとの新作</a>}
          {tagGroups.length > 0 && <a class="foot-link" href={TAG_INDEX_PATH}>ジャンルから探す</a>}
          <a class="foot-link" href={ACTRESS_INDEX_PATH}>女優検索（出演者から探す）</a>
          <a class="foot-link" href={MAKER_INDEX_PATH}>メーカーから探す</a>
          {roundups.length > 0 && <a class="foot-link" href={WEEKLY_INDEX_PATH}>週ごとのまとめ</a>}
        </nav>
        <p class="foot-credit">
          <a class="foot-link" href="https://affiliate.dmm.com/api/" target="_blank" rel="noopener noreferrer">Powered by FANZA Webサービス</a>
        </p>
      </div>
    </footer>
    <script is:inline src={assetUrl('/favorites.js')} defer></script>
    <script is:inline src={assetUrl('/vr-filter.js')} defer></script>
  </body>
</html>
