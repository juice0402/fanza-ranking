---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VrToggle from '../../components/VrToggle.astro';
import DaySection from '../../components/DaySection.astro';
import FavButton from '../../components/FavButton.astro';
import NextWorks from '../../components/NextWorks.astro';
import OnSaleWorks from '../../components/OnSaleWorks.astro';
import RatedShelf from '../../components/RatedShelf.astro';
import CastFaces from '../../components/CastFaces.astro';
import { inlineScript } from '../../lib/assets.js';
import { isMinorTitle } from '../../lib/gacha.js';
import { makerGroups, actressByName, contentGenres, sale, tagByName, today, seriesById, labelById } from '../../lib/data.js';
import { entryChips } from '../../lib/insights.js';
import EntryChips from '../../components/EntryChips.astro';
import { campaignSummary, offPercent, onSaleItems } from '../../lib/sale.js';
import {
  MAKER_INDEX_PATH,
  SITE_URL,
  breadcrumbLd,
  entityDescription,
  formatsOf,
  groupByDate,
  listLastmod,
  makerPageTitle,
  makerSummary,
  rankedNames,
  shortSpan,
} from '../../lib/items.js';
import { ENTITY_LIST_LIMIT } from '../../config.js';
import { entityListing, hasCalendar, listIndexable } from '../../lib/plan.js';
import { CALENDAR_PATH, makerIcsPath, webcalUrl } from '../../lib/calendar.js';

// 作品が2本以上あるメーカーごとに1ページ作る
export function getStaticPaths() {
  return makerGroups.map((group) => ({ params: { slug: group.slug }, props: { group } }));
}

const { group } = Astro.props;
const summary = makerSummary(group);
// 並べるのは新しい順に ENTITY_LIST_LIMIT 本まで（過去作品が多い人・メーカーで、ページが重くなりすぎないように）
const listing = entityListing(group.items, ENTITY_LIST_LIMIT);
const groups = groupByDate(listing.shown);
// 発売日カレンダーは、新作・予約が載っている人・メーカーだけ（lib/plan.js の hasCalendar）
const calendar = hasCalendar(group);
// コメントのある作品が1本も無いページ（過去作品だけ）は、検索エンジンには出さない
const noindex = !listIndexable(group.items);
// 出演者は、出演の多い順に CAST_LIMIT 人まで（過去作品の多いメーカーで、名前だけで画面が埋まらないように）
const CAST_LIMIT = 15;
const castRanked = rankedNames(group.items.flatMap((i) => i.actress), CAST_LIMIT);
const cast = castRanked.names;
const castTotal = new Set(group.items.flatMap((i) => i.actress)).size;
const formats = formatsOf(group.items);
// 女優のページと同じように強くする（運営者の希望「SEOを上位に」→「メーカーのページも。素晴らしいサイトを目指して完璧に」。2026-10-06）:
// 次の新作（予約受付中を近い順に）・セール中の作品と入っているセール・よく出ている女優（顔の丸）・多いジャンル・更新日・構造化データ
const NEXT_SHOWN = 6;
const SALE_SHOWN = 6;
const CAST_FACES = 6;
const GENRE_CHIPS = 8;
// 次の新作・セール中の作品は、こちらから案内する欄なので、未成年を連想させるタイトルの作品は入れない（下の「作品」の一覧には出る。2026-10-06）
const upcomingWorks = group.items.filter((i) => i.dateKey > today && !isMinorTitle(i.title)).sort((a, b) => a.dateKey.localeCompare(b.dateKey) || a.cid.localeCompare(b.cid));
const saleWorks = onSaleItems(group.items, sale, today).filter((i) => !isMinorTitle(i.title));
const saleMaxOff = Math.max(0, ...saleWorks.map((i) => offPercent(i.sale.price, i.sale.listPrice) ?? 0)) || null;
// よく出ている女優（出演者4人までの作品で2本以上の人）と多いジャンル（ページを作るジャンルだけ。ベスト・総集編を除く）。このサイトに載っている作品から数える
const counted = campaignSummary(group.items, { genres: contentGenres, limit: Math.max(CAST_FACES, GENRE_CHIPS) });
const castFaces = counted.actresses.slice(0, CAST_FACES);
const genreChips = counted.genres.slice(0, GENRE_CHIPS);
const md = (d) => `${Number(d.slice(5, 7))}月${Number(d.slice(8, 10))}日`;
// 最後に変わった日（sitemap の lastmod と同じ）。画面の「○月○日更新」と、構造化データの dateModified に使う
const modified = listLastmod(group.items, today);
const description = entityDescription(summary, { next: upcomingWorks[0] ?? null, saleCount: saleWorks.length, maxOff: saleMaxOff });
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${group.name}の新作・作品一覧`,
  url: SITE_URL + group.path,
  ...(modified ? { dateModified: modified } : {}),
  about: { '@type': 'Organization', name: group.name },
};
const trail = [
  { name: 'トップ', path: '/' },
  { name: 'メーカー一覧', path: MAKER_INDEX_PATH },
  { name: group.name, path: group.path },
];
---

<Base
  title={makerPageTitle(group, today)}
  description={description}
  path={group.path}
  noindex={noindex}
  jsonLd={[breadcrumbLd(trail), pageLd]}
>
  {/* セールの「終わったら隠す」（public/sale.js）を、ページの先頭にそのまま入れる。中身が読み込まれるそばから印を付けるので、終わったものが見えてから消えて下がずれない（2026-10-07） */}
  {saleWorks.length > 0 && <script is:inline id="sale-early" set:html={inlineScript('/sale.js')} />}
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">{group.name}の新作・作品一覧</h1>
      {modified && <p class="page-updated">{md(modified)}更新</p>}
      <div class="hero-actions">
        <FavButton type="maker" favKey={group.name} slug={group.slug} size="lead" off="お気に入り（新作をお知らせ）" on="お気に入り済み（新作をお知らせ）" />
        {calendar && (
          <span class="cal-set">
            <a class="cal-link" href={webcalUrl(makerIcsPath(group.slug))}>発売日をカレンダーで受け取る</a>
            <a class="cal-help" href={CALENDAR_PATH}>使い方</a>
          </span>
        )}
      </div>
    </section>

    <dl class="spec section">
      <dt class="spec-term">掲載作品</dt>
      <dd class="spec-desc">{group.items.length}本（{shortSpan(group.items)}発売）</dd>
      {cast.length > 0 && (
        <>
          <dt class="spec-term">出演</dt>
          <dd class="spec-desc">
            {cast.map((name, i) => (
              <>
                {i > 0 && '、'}
                {actressByName.get(name) ? <a class="spec-link" href={actressByName.get(name).path}>{name}</a> : name}
              </>
            ))}
            {castRanked.more && `ほか${castTotal - cast.length}人`}
          </dd>
        </>
      )}
      {formats.length > 0 && (
        <>
          <dt class="spec-term">形式</dt>
          <dd class="spec-desc">{formats.join('・')}</dd>
        </>
      )}
    </dl>

    <NextWorks items={upcomingWorks} shown={NEXT_SHOWN} />
    <OnSaleWorks items={saleWorks} shown={SALE_SHOWN} label="このメーカーの作品が入っているセール" />
    <RatedShelf items={group.items} title={`${group.name}の評価の高い作品`} />

    {castFaces.length > 0 && (
      <section class="section" aria-labelledby="cast-title">
        <div class="section-head">
          <h2 id="cast-title" class="section-title">よく出ている女優</h2>
          <p class="section-note">このサイトに載っている作品の本数</p>
        </div>
        <CastFaces rows={castFaces} />
      </section>
    )}

    {genreChips.length > 0 && (
      <section class="section" aria-labelledby="genre-title">
        <div class="section-head">
          <h2 id="genre-title" class="section-title">多いジャンル</h2>
        </div>
        <nav class="sale-jump genre-chips" aria-label={`${group.name}の多いジャンル`}>
          {genreChips.map((g) => (
            tagByName.get(g.name)
              ? <a class="chip-link" href={tagByName.get(g.name).path}>{g.name}<span class="chip-count">{g.count}本</span></a>
              : <span class="chip-link chip-static">{g.name}<span class="chip-count">{g.count}本</span></span>
          ))}
        </nav>
      </section>
    )}

    <EntryChips chips={entryChips(group.items, seriesById, 'series')} title="シリーズ" id="series-title" label={`${group.name}のシリーズ`} />
    <EntryChips chips={entryChips(group.items, labelById, 'label')} title="レーベル" id="label-title" label={`${group.name}のレーベル`} />

    <section class="section" aria-labelledby="works-title">
      <div class="section-head">
        <h2 id="works-title" class="section-title">作品（{group.items.length}本）</h2>
        <p class="section-note">{listing.hidden > 0 ? `発売日が新しい順に${listing.shown.length}本を表示（ほか${listing.hidden}本は「過去の作品」の一覧にあります）` : '発売日が新しい順'}</p>
      </div>
      <div class="list-tools">
        <VrToggle />
      </div>
      <DaySection groups={groups} />
    </section>
  </div>
</Base>
