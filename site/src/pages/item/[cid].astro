---
// コメントのある作品のページ（/item/<作品ID>/。検索エンジンに出す。sitemap にも入れる）。中身は components/ItemPage.astro。
// コメントの無い作品は /w/<作品ID>/（pages/w/[cid].astro。noindex で、robots.txt で検索エンジンに読ませない。案A。2026-11-10）。
// 作るのは lib/plan.js が選んだ作品だけ（サイト全体のファイル数を上限に収めるため。あふれた古い過去作品は、一覧からFANZAへ直接リンクする）
import ItemPage from '../../components/ItemPage.astro';
import { all, paged } from '../../lib/data.js';
import { hasComment } from '../../lib/items.js';

export function getStaticPaths() {
  return all.filter((item) => paged.has(item.cid) && hasComment(item)).map((item) => ({ params: { cid: item.cid }, props: { item } }));
}

const { item } = Astro.props;
---

<ItemPage item={item} />
