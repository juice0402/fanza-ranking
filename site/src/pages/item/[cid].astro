---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FavButton from '../../components/FavButton.astro';
import Face from '../../components/Face.astro';
import SampleMovie from '../../components/SampleMovie.astro';
import MiniShelf from '../../components/MiniShelf.astro';
import WorkRows from '../../components/WorkRows.astro';
import GachaCorner from '../../components/GachaCorner.astro';
import RankTrend from '../../components/RankTrend.astro';
import { all, paged, actressByName, makerByName, profilesByName, factsContext, monthByKey, tagByName, sale, saleCampaignBySlug, today, rankHistory, seriesById, labelById, roundups, genreTops, contentGenres } from '../../lib/data.js';
import { popularInGenre, roundupFor, sameSeries } from '../../lib/insights.js';
import { weekRangeShort, weeklyPath } from '../../lib/roundups.js';
import { campaignSlug, endIso, endLabel, offPercent, onSaleItems, saleHref } from '../../lib/sale.js';
import { nextWorksOf, relatedForPage } from '../../lib/stay.js';
import {
  breadcrumbLd,
  formatDateJp,
  itemPath,
  itemPageDescription,
  itemPageTitle,
  truncate,
} from '../../lib/items.js';
import { searchPath } from '../../lib/search.js';
import { productCode, itemFacts } from '../../lib/facts.js';
import { monthLinkFor, VR_TAG_NAME } from '../../lib/collections.js';
import { workFavoriteAttrs } from '../../lib/favorites.js';
import { faceUrl } from '../../lib/profiles.js';

// 作品ごとに1ページ作る（サイト全体を2万ファイル以内に収めるため、作るのは lib/plan.js が選んだ作品だけ。
// あふれた古い過去作品は、一覧からFANZAへ直接リンクする）
export function getStaticPaths() {
  return all.filter((item) => paged.has(item.cid)).map((item) => ({ params: { cid: item.cid }, props: { item } }));
}

const { item } = Astro.props;
// コメントがまだ無い作品（過去作品）は、FANZAの情報を並べただけのページなので、検索エンジンには出さない（noindex。sitemap にも入れない）。
// Claude がコメントを書くと、次のビルドから出す
const noindex = !item.comment.trim();
// 次に見るもの（運営者の希望「サイト滞在時間を伸ばしたい」。2026-10-06。lib/stay.js）:
// セール中なら札と価格（特集のページへ）・出演者の次の新作（お気に入りのボタンつき）・同じ出演者/メーカーの作品（小さな表紙の棚）・運命の作品
// 同じシリーズの作品（シリーズのページがあるときだけ。発売日の近い順に6本）・同じ出演者/メーカーの作品・同じジャンルで人気の作品（2026-10-07。内部リンクを増やす）。
// 同じ作品が2つの欄に出ないよう、先の欄に出た作品は後の欄から除く
const seriesGroup = item.series ? seriesById.get(item.series.id) : null;
const labelGroup = item.label ? labelById.get(item.label.id) : null;
const seriesWorks = sameSeries(item, seriesGroup);
const shownCids = new Set(seriesWorks.map((w) => w.cid));
const related = relatedForPage(item, all, 6 + seriesWorks.length).filter((w) => !shownCids.has(w.cid)).slice(0, 6);
for (const w of related) shownCids.add(w.cid);
const genrePop = popularInGenre(item, genreTops, contentGenres, shownCids);
// 人気の動き（毎日の更新が記録した、新着の人気順の毎日の順位。lib/popularity.js）
const hist = rankHistory.get(item.cid) ?? null;
// その作品の発売週の「週のまとめ」（あれば、この作品のデータの欄にリンク）
const weekly = roundupFor(item, roundups);
const next = nextWorksOf(item, actressByName, today);
const md = (d) => `${Number(d.slice(5, 7))}月${Number(d.slice(8, 10))}日`;
const saleNow = onSaleItems([item], sale, today)[0]?.sale ?? null;
const saleOff = saleNow ? offPercent(saleNow.price, saleNow.listPrice) : null;
const yen = (n) => n.toLocaleString('ja-JP');
const saleCampHref = saleNow ? saleCampaignBySlug.get(campaignSlug(saleNow.title))?.path ?? saleHref(saleNow.k) : '';
const samples = item.sample_images.slice(0, 8);
// サンプル動画がある作品は、動画を表紙の場所に出し、パッケージ写真は、サンプル画像の下に別の欄で大きく出す
// （サンプル画像の並びに混ぜると、枚数が増えて並びが崩れやすいため）。
// 動画が無い作品は、これまでどおり表紙を上に出す
const hasMovie = Boolean(item.sample_movie);
const coverBelow = hasMovie && Boolean(item.image_url);
const gallery = samples.map((src, i) => ({ src, label: `サンプル画像 ${i + 1}` }));
const zoomable = gallery.length > 0 || coverBelow; // 拡大表示（lightbox）を使う画像がある
const trail = [
  { name: 'トップ', path: '/' },
  { name: truncate(item.title, 30), path: itemPath(item.cid) },
];
const makerPage = makerByName.get(item.maker)?.path;
const code = productCode(item.cid); // 品番（作れないときは ''）
// 出演者が多い作品（6人以上）は、先頭の4人だけを出し、残りは「ほか○人を見る」で開く（ページの上のほうが、名前だけで埋まらないように）
const CAST_FOLD_AT = 6;
const CAST_SHOWN = 4;
const castShown = item.actress.length >= CAST_FOLD_AT ? item.actress.slice(0, CAST_SHOWN) : item.actress;
const castRest = item.actress.length >= CAST_FOLD_AT ? item.actress.slice(CAST_SHOWN) : [];
// 「この作品のデータ」欄: 保存してある作品データから数えた事実だけ（リンク先は、ページがあるものだけ）
const facts = itemFacts(item, factsContext, {
  month: (dateKey) => monthLinkFor(monthByKey, dateKey),
  maker: new Map([...makerByName].map(([name, g]) => [name, g.path])),
  actress: new Map([...actressByName].map(([name, g]) => [name, g.path])),
  vr: tagByName.get(VR_TAG_NAME)?.path ?? '',
});
if (weekly) {
  facts.push({ key: 'weekly', label: '週のまとめ', text: `${weekRangeShort(weekly.roundup.week_start)}の新作まとめ${weekly.pick ? '（注目の作品として紹介）' : ''}`, href: weeklyPath(weekly.roundup.week_start), linkLabel: '記事を見る' });
}
import { assetUrl, inlineScript } from '../../lib/assets.js';
---

<Base
  title={itemPageTitle(item, code)}
  description={itemPageDescription(item, code)}
  path={itemPath(item.cid)}
  image={item.image_url}
  stickyCta={Boolean(item.url)}
  noindex={noindex}
  jsonLd={[breadcrumbLd(trail)]}
>
  {/* セールの「終わったら隠す」（public/sale.js）を、ページの先頭にそのまま入れる。中身が読み込まれるそばから印を付けるので、終わったものが見えてから消えて下がずれない（2026-10-07） */}
  {saleNow && <script is:inline id="sale-early" set:html={inlineScript('/sale.js')} />}
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <article class="detail-grid">
      <div class="detail-media">
        {hasMovie
          ? <SampleMovie src={item.sample_movie} title={truncate(item.title, 60)} fallbackUrl={item.url} />
          : item.image_url && (
            <img
              class="detail-cover"
              src={item.image_url}
              alt={`${truncate(item.title, 60)} のパッケージ画像`}
              width="800"
              height="538"
              fetchpriority="high"
            />
          )}
      </div>

      <div class="detail-body">
        <h1 class="detail-title">{item.title}</h1>

        {item.isAi
          ? (
            <div class="note-card">
              <p class="note-card-label">ひとこと</p>
              <p class="note-card-text">{item.comment}</p>
            </div>
          )
          : item.comment && <p class="plain-comment">{item.comment}</p>}


        <dl class="spec">
          <dt class="spec-term">発売日</dt>
          <dd class="spec-desc">{formatDateJp(item.dateKey)}</dd>
          {code && (
            <>
              <dt class="spec-term">品番</dt>
              <dd class="spec-desc">{code}</dd>
            </>
          )}
          <dt class="spec-term">メーカー</dt>
          <dd class="spec-desc">
            {makerPage ? <a class="spec-link" href={makerPage}>{item.maker}</a> : item.maker}
            {item.maker !== '不明' && <FavButton type="maker" favKey={item.maker} slug={makerByName.get(item.maker)?.slug ?? ''} size="mini" />}
          </dd>
          {item.series && (
            <>
              <dt class="spec-term">シリーズ</dt>
              <dd class="spec-desc">{seriesGroup ? <a class="spec-link" href={seriesGroup.path}>{item.series.name}</a> : item.series.name}</dd>
            </>
          )}
          {item.label && item.label.name !== item.maker && (
            <>
              <dt class="spec-term">レーベル</dt>
              <dd class="spec-desc">{labelGroup ? <a class="spec-link" href={labelGroup.path}>{item.label.name}</a> : item.label.name}</dd>
            </>
          )}
          {item.actress.length > 0 && (
            <>
              <dt class="spec-term">出演</dt>
              <dd class="spec-desc">
                <ul class="cast-list">
                  {castShown.map((name) => (
                    <li class="cast-person">
                      <Face name={name} src={faceUrl(profilesByName.get(name))} size="sm" />
                      {actressByName.get(name) ? <a class="spec-link" href={actressByName.get(name).path}>{name}</a> : <span>{name}</span>}
                      <FavButton type="actress" favKey={name} slug={actressByName.get(name)?.slug ?? ''} size="mini" />
                    </li>
                  ))}
                </ul>
                {castRest.length > 0 && (
                  <details class="cast-more">
                    <summary class="cast-more-toggle">ほか{castRest.length}人</summary>
                    <ul class="cast-list">
                      {castRest.map((name) => (
                        <li class="cast-person">
                          <Face name={name} src={faceUrl(profilesByName.get(name))} size="sm" />
                          {actressByName.get(name) ? <a class="spec-link" href={actressByName.get(name).path}>{name}</a> : <span>{name}</span>}
                          <FavButton type="actress" favKey={name} slug={actressByName.get(name)?.slug ?? ''} size="mini" />
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </dd>
            </>
          )}
          {item.duration_min && (
            <>
              <dt class="spec-term">収録時間</dt>
              <dd class="spec-desc">{item.duration_min}分</dd>
            </>
          )}
          {item.genres.length > 0 && (
            <>
              <dt class="spec-term">ジャンル</dt>
              <dd class="spec-desc">
                <ul class="chips">
                  {item.genres.map((g) => <li class="chip"><a class="chip-tag" href={tagByName.get(g)?.path ?? searchPath(g)}>{g}</a></li>)}
                </ul>
              </dd>
            </>
          )}
        </dl>

        {/* セール中なら、札と価格といつまで（終わりの時刻をすぎたら、ブラウザで隠す。/sale.js）。特集のページへ */}
        {saleNow && (
          <p class="sale-strip" data-sale-end={endIso(saleNow.end)}>
            <span class="sale-strip-off">{saleOff ? `${saleOff}%OFF` : 'セール中'}</span>
            {saleNow.price && <span class="sale-strip-price"><strong>{yen(saleNow.price)}円〜</strong><s>{yen(saleNow.listPrice)}円〜</s></span>}
            <span class="sale-strip-end">{endLabel(saleNow.end)}まで</span>
            <a class="sale-strip-link" href={saleCampHref}>{saleNow.title}</a>
          </p>
        )}

        {/* FANZAへのボタンと、お気に入りのボタン（すき間をあけて並べる。せまい画面でFANZAへのボタンは、画面の下に固定のものを使う） */}
        <div class="detail-actions">
          {item.url && (
            <a class="btn btn-hot btn-lg detail-cta" href={item.url} target="_blank" rel="sponsored nofollow noopener noreferrer">FANZAで詳細を見る</a>
          )}
          <FavButton type="work" favKey={item.cid} attrs={workFavoriteAttrs(item)} off="この作品をお気に入りに追加" on="お気に入りに追加済み" />
        </div>
      </div>
    </article>

    {gallery.length > 0 && (
      <section class="subsection" aria-labelledby="samples-title">
        <h2 id="samples-title" class="subsection-title">サンプル画像</h2>
        <ul class="samples">
          {gallery.map((g) => (
            <li>
              <a class="sample-link" href={g.src} data-label={g.label} target="_blank" rel="noopener noreferrer" aria-label={`${g.label} を拡大して見る`}>
                <img class="sample-img" src={g.src} alt={g.label} loading="lazy" decoding="async" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {coverBelow && (
      <section class="subsection package" aria-labelledby="package-title">
        <h2 id="package-title" class="subsection-title">パッケージ写真</h2>
        <a class="sample-link" href={item.image_url} data-label="パッケージ画像" target="_blank" rel="noopener noreferrer" aria-label="パッケージ写真を拡大して見る">
          <img
            class="package-img"
            src={item.image_url}
            alt={`${truncate(item.title, 60)} のパッケージ画像`}
            width="800"
            height="538"
            loading="lazy"
            decoding="async"
          />
        </a>
      </section>
    )}

    <section class="subsection" aria-labelledby="facts-title">
      <h2 id="facts-title" class="subsection-title">この作品のデータ</h2>
      <ul class="facts">
        {facts.map((row) => (
          <li class="facts-row">
            <span class="facts-label">{row.label}</span>
            <span class="facts-text">{row.text}{row.href && <> <a class="facts-link" href={row.href}>{row.linkLabel}</a></>}</span>
          </li>
        ))}
      </ul>
    </section>

    <RankTrend hist={hist} />

    {zoomable && (
      <dialog id="lightbox" class="lightbox" aria-label="画像の拡大表示" tabindex="-1">
        <div class="lightbox-stage">
          <div class="lightbox-view"><img class="lightbox-img" alt="" /></div>
          {/* 前・次のボタンは、画像に重ならないよう、画像の下の帯に（運営者の希望。2026-10-05。親指でも押しやすい） */}
          <div class="lightbox-bar">
            <button type="button" class="lightbox-btn lightbox-prev" data-lightbox="prev" aria-label="前の画像"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-6 7 6 7" /></svg></button>
            <p class="lightbox-count" aria-live="polite"></p>
            <button type="button" class="lightbox-btn lightbox-next" data-lightbox="next" aria-label="次の画像"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l6 7-6 7" /></svg></button>
          </div>
          <button type="button" class="lightbox-btn lightbox-close" data-lightbox="close" aria-label="閉じる"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19" /></svg></button>
        </div>
      </dialog>
    )}

    {next.items.length > 0 && (
      <section class="subsection" aria-labelledby="next-title">
        <div class="subsection-head">
          <h2 id="next-title" class="subsection-title">{next.names.length === 1 ? `${next.names[0]}の次の新作` : '出演者の次の新作'}</h2>
          {next.names.length === 1 && (
            <FavButton type="actress" favKey={next.names[0]} slug={actressByName.get(next.names[0])?.slug ?? ''} off="お気に入りに追加" on="お気に入り済み" />
          )}
        </div>
        <WorkRows items={next.items} note={(i) => `${md(i.dateKey)}発売（予約受付中）`} />
      </section>
    )}

    {seriesWorks.length > 0 && (
      <section class="subsection" aria-labelledby="series-title" data-vr-group>
        <div class="subsection-head">
          <h2 id="series-title" class="subsection-title">同じシリーズの作品</h2>
          <a class="subsection-more" href={seriesGroup.path}>「{seriesGroup.name}」の{seriesGroup.items.length}本を見る</a>
        </div>
        <MiniShelf items={seriesWorks} />
      </section>
    )}

    {related.length > 0 && (
      <section class="subsection" aria-labelledby="related-title" data-vr-group>
        <h2 id="related-title" class="subsection-title">同じ出演者・メーカーの作品</h2>
        <MiniShelf items={related} />
      </section>
    )}

    {genrePop.items.length > 0 && (
      <section class="subsection" aria-labelledby="genre-pop-title" data-vr-group>
        <div class="subsection-head">
          <h2 id="genre-pop-title" class="subsection-title">「{genrePop.genre}」で人気の作品</h2>
          {tagByName.get(genrePop.genre) && <a class="subsection-more" href={tagByName.get(genrePop.genre).path}>ジャンルのページへ</a>}
        </div>
        <MiniShelf items={genrePop.items} />
      </section>
    )}

    <GachaCorner src="/data/gacha.json" exclude={item.cid} />
  </div>

  {zoomable && <script is:inline src={assetUrl('/lightbox.js')} defer></script>}
  <script is:inline src={assetUrl('/gacha.js')} defer></script>
  {hasMovie && <script is:inline src={assetUrl('/movie.js')} defer></script>}

  {item.url && (
    <div class="sticky-cta">
      <a class="btn btn-hot btn-block" href={item.url} target="_blank" rel="sponsored nofollow noopener noreferrer">FANZAで詳細を見る</a>
    </div>
  )}
</Base>
