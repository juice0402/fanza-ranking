---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_NAME, breadcrumbLd } from '../lib/items.js';
import { FAVORITES_PATH } from '../lib/favorites.js';
import { CALENDAR_PATH } from '../lib/calendar.js';

const trail = [
  { name: 'トップ', path: '/' },
  { name: 'お気に入り', path: FAVORITES_PATH },
];
// お気に入りは、見る人ごとの内容なので、検索には載せない（noindex）
---

<Base
  title={`お気に入り｜${SITE_NAME}`}
  description="お気に入りに入れた作品・出演者・メーカーと、その新作・予約の一覧です。"
  path={FAVORITES_PATH}
  noindex={true}
  jsonLd={[breadcrumbLd(trail)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">お気に入り</h1>
      <p class="hero-lead">☆ を押した作品・出演者・メーカーと、その新作・予約がここに集まります。</p>
    </section>

    <div id="fav-root">
      <noscript><p class="empty">お気に入りを使うには、ブラウザのJavaScriptを有効にしてください。</p></noscript>
      {/* お気に入りがまだ無い人（html.fav-none。Base.astro の <head> が付ける）には、はじめから出しておく（あとから出てきて下がずれないように。favorites.js も同じ文を出す。2026-10-07） */}
      <p class="empty" data-fav-empty>まだお気に入りがありません。作品・出演者・メーカーのページにある ☆ を押すと、ここに集まります。</p>
    </div>

    <p class="fine">お気に入りは、この端末のブラウザの中にだけ保存されます（別の端末には引き継がれません）。</p>
    <p class="fine">発売日をカレンダーに自動で入れたいときは、<a class="spec-link" href={CALENDAR_PATH}>発売日カレンダー</a>のページを見てください。</p>
  </div>
</Base>
