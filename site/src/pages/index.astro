---
import Base from '../layouts/Base.astro';
import DaySection from '../components/DaySection.astro';
import { released, upcoming } from '../lib/data.js';
import {
  groupByDate,
  archivePath,
  websiteLd,
  SITE_NAME,
  HOME_RELEASED_LIMIT,
  HOME_UPCOMING_LIMIT,
  ACTRESS_INDEX_PATH,
  MAKER_INDEX_PATH,
} from '../lib/items.js';

const releasedGroups = groupByDate(released.slice(0, HOME_RELEASED_LIMIT));
const upcomingGroups = groupByDate(upcoming.slice(0, HOME_UPCOMING_LIMIT));
const hasMore = released.length > HOME_RELEASED_LIMIT;
---

<Base
  title={`${SITE_NAME}｜毎日更新のFANZA新作・予約作品まとめ`}
  description="FANZAの新作・新着と予約中の作品を、発売日ごとにまとめて毎日更新。AIがひとこと添えます。"
  path="/"
  jsonLd={[websiteLd()]}
>
  <div class="wrap">
    <section class="hero">
      <h1 class="hero-title"><span class="phrase">FANZAの新作を、</span><span class="phrase">発売日ごとに。</span></h1>
      <p class="hero-lead"><span class="phrase">発売日ごとに新作をまとめて、</span><span class="phrase">AIがひとこと添えます。</span><span class="phrase">毎日更新。</span></p>
      <nav class="hero-jump" aria-label="ページ内の移動">
        {released.length > 0 && <a class="chip-link" href="#released">発売中の新作 {released.length}本</a>}
        {upcoming.length > 0 && <a class="chip-link" href="#upcoming">予約受付中 {upcoming.length}本</a>}
        <a class="chip-link" href={ACTRESS_INDEX_PATH}>出演者から探す</a>
        <a class="chip-link" href={MAKER_INDEX_PATH}>メーカーから探す</a>
      </nav>
    </section>

    <section id="released" class="section" aria-labelledby="released-title">
      <div class="section-head">
        <h2 id="released-title" class="section-title">発売中の新作</h2>
        <p class="section-note">発売日が新しい順</p>
      </div>
      {releasedGroups.length > 0
        ? <DaySection groups={releasedGroups} />
        : <p class="empty">発売中の作品を準備しています。毎日の更新をお待ちください。</p>}
      {hasMore && (
        <p class="more"><a class="btn btn-quiet" href={archivePath(1)}>過去の作品をすべて見る</a></p>
      )}
    </section>

    {upcomingGroups.length > 0 && (
      <section id="upcoming" class="section" aria-labelledby="upcoming-title">
        <div class="section-head">
          <h2 id="upcoming-title" class="section-title">予約受付中</h2>
          <p class="section-note">発売日が近い順</p>
        </div>
        <DaySection groups={upcomingGroups} />
      </section>
    )}
  </div>
</Base>
