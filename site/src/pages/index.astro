---
import Base from '../layouts/Base.astro';
import DaySection from '../components/DaySection.astro';
import TopThree from '../components/TopThree.astro';
import TopicList from '../components/TopicList.astro';
import HotActresses from '../components/HotActresses.astro';
import HotGenres from '../components/HotGenres.astro';
import VrToggle from '../components/VrToggle.astro';
import SaleCampaigns from '../components/SaleCampaigns.astro';
import TenYenHero from '../components/TenYenHero.astro';
import { all, sale, today, released, upcoming, roundups, ranking, monthGroups, tagGroups, paged, popularity, todayData, faceOfName, birthOfName, coverOfName, contentGenres, events, upcomingEventList, activeFloors, tenYenNow, campaignHrefOf } from '../lib/data.js';
import { FLOORS, floorPath } from '../lib/floors.js';
import { EVENT_PATH } from '../lib/events.js';
import { itemHref } from '../lib/plan.js';
import { RANKING_PATH } from '../lib/popularity.js';
import { SALE_PATH, saleGroups } from '../lib/sale.js';
import { TOP_SHOWN, birthdaySoon, buildTopics, hotActresses, hotGenres, topEntries, weekDebuts } from '../lib/topics.js';
import { gachaPool } from '../lib/gacha.js';
import PickCorner from '../components/PickCorner.astro';
import GachaCorner from '../components/GachaCorner.astro';
import SideWeekly from '../components/SideWeekly.astro';
import SideMonths from '../components/SideMonths.astro';
import { MONTH_INDEX_PATH, TAG_INDEX_PATH } from '../lib/collections.js';
import { weeklyPath } from '../lib/roundups.js';
import { SEARCH_PATH } from '../lib/search.js';
import {
  dateParts,
  groupByDate,
  countByDate,
  archivePath,
  websiteLd,
  SITE_NAME,
  HOME_RELEASED_LIMIT,
  HOME_UPCOMING_LIMIT,
  HOME_UPCOMING_SHOWN,
  ACTRESS_INDEX_PATH,
  MAKER_INDEX_PATH,
} from '../lib/items.js';

const releasedGroups = groupByDate(released.slice(0, HOME_RELEASED_LIMIT), countByDate(released));
const upcomingGroups = groupByDate(upcoming.slice(0, HOME_UPCOMING_LIMIT), countByDate(upcoming));
const upcomingShown = Math.min(upcoming.length, HOME_UPCOMING_LIMIT); // 「予約受付中 N本」は、下に並ぶ数と同じにする
// 予約受付中は、発売日が近い HOME_UPCOMING_SHOWN 本だけを先に見せ、残りは「もっと見る」で出す（運営者の「下のほうが重い」。2026-10-07）。
// 残りもHTMLには入れておく（予約の一覧ページは無いため。検索エンジンと、JavaScript が使えない人には全部見える）
const upcomingFold = upcomingShown > HOME_UPCOMING_SHOWN ? HOME_UPCOMING_SHOWN : 0;
const hasMore = released.length > HOME_RELEASED_LIMIT;
const latestRoundup = roundups[0]; // いちばん新しい週のまとめ（無ければ undefined）
const day = dateParts(today);

// きょうの新着人気TOP3（この1週間に発売された作品の、その日のFANZAの人気順）。まだ集まっていないあいだは、売れ筋（FANZAの人気順の上位）で代わりにする
const newTop = topEntries(all, today);
const topIsNew = newTop.length > 0;
const top = topIsNew ? newTop : (ranking?.items ?? []);
const topDay = topIsNew ? (popularity.date ? dateParts(popularity.date) : day) : ranking ? dateParts(ranking.date) : null;

// きょうの話題（毎日の更新が集めた人気順・予約の人気順・セールから、データで決まった形の文を作る。TOP3に出ている作品は除く。
// VR作品を隠したときにTOP3に繰り上がる作品も除き、話題の作品がVR作品なら、VRでない次の作品も用意する）
const topVrOff = top.filter((i) => !i.vr).slice(0, TOP_SHOWN).map((i) => i.cid);
const topics = buildTopics({
  items: all,
  today,
  popularity,
  todayData,
  sale,
  roundup: latestRoundup ?? null,
  events,
  linkOf: (item) => itemHref(item, paged),
  faceOf: (name) => faceOfName(name),
  coverOf: coverOfName,
  campaignHref: campaignHrefOf,
  skip: new Set([...top.slice(0, TOP_SHOWN).map((i) => i.cid), ...topVrOff]),
  skipVrOff: new Set(topVrOff),
});

// いま人気の女優（新着の人気TOP100によく出ている3人。VR作品を隠すときは、VR作品を数えない並び）
// （顔写真がある人だけ。運営者の希望。2026-10-05）
const hasFace = (name) => Boolean(faceOfName(name));
const hot = hotActresses(all, today, { hasFace });
const hotNoVr = hotActresses(all, today, { excludeVr: true, hasFace });
// 人気のジャンル（いま人気の女優の真下。ジャンルのページの一覧から、同じ数え方で3つ）
const genres = hotGenres(all, today, { allowed: contentGenres });

// 発売中の新作の、きょうの日付のすぐ下のコーナー（運営者の希望。2026-10-05）: 今週のデビュー作・誕生日の近い女優
// 運命の作品（スロットで3本。public/gacha.js）は、スマホでは発売中の新作のいちばん下（予約受付中の真上。運営者の希望。2026-10-05 夜）
const gacha = gachaPool(all, paged, today);
const debuts = weekDebuts(all, today);
const birthdays = birthdaySoon(all, today, { birthOf: birthOfName, hasFace });
const hasCorner = debuts.length > 0 || birthdays.length > 0;
const hasGacha = gacha.length >= 3 && released.length > 0;

// セール中の特集（FANZAのキャンペーンごとのカード。終わりが近い順。終わった時刻をすぎたものは、ブラウザで隠して次を繰り上げる /sale.js）
const saleCamps = saleGroups(all, sale, today, 0, { genres: contentGenres });
const saleTotal = saleCamps.reduce((n, g) => n + g.total, 0);
const saleDay = sale.date ? dateParts(sale.date) : null;
import { assetUrl, inlineScript } from '../lib/assets.js';
// パソコン（960px〜）の右の欄（作品を探す → きょうの話題 → いま人気の女優 → 人気のジャンル → 週のまとめ → おすすめのコーナー → 月のまとめ）。
// 運営者の希望「右のカラム（きょうの話題）の下に全て並べる」「作品を探すも右のカラムの上に」。2026-10-05。作品を探すがいつもあるので、右の欄はいつもある。
// 右の欄は、左の欄（TOP3・セール・発売中・予約）の行をまたいで縦に伸ばす。またぐ行の数 = 左の欄の欄の数（site.css の .home.has-side）
const mainCount = [top.length > 0, saleCamps.length > 0, true, upcomingGroups.length > 0].filter(Boolean).length;
// おすすめのコーナー・運命の作品を、パソコンでは右の欄（#side-corner）へ移す小さなスクリプト（それぞれのすぐ後ろで動くので、表示がずれない。幅が変われば戻す）。
// 運命の作品は、HTMLではコーナーより後ろにあるが、右の欄ではいちばん上（first: 先頭に入れる）
const moveJs = (id, home, first = false) =>
  `(function(){var c=document.getElementById('${id}'),s=document.getElementById('side-corner'),h=document.getElementById('${home}');if(!c||!s||!h||!window.matchMedia)return;var m=window.matchMedia('(min-width: 960px)');function place(){var t=m.matches?s:h;if(c.parentNode===t)return;if(t===s&&${first ? 'true' : 'false'})t.insertBefore(c,t.firstChild);else t.appendChild(c);}place();if(m.addEventListener)m.addEventListener('change',place);else if(m.addListener)m.addListener(place);})();`;
const CORNER_MOVE_JS = moveJs('pick-corner', 'corner-home');
const GACHA_MOVE_JS = moveJs('gacha', 'gacha-home', true);
---

<Base
  tenYenBar={false}
  title={`${SITE_NAME}｜毎日更新のFANZA新作・予約作品まとめ`}
  description="FANZAの新作・新着と予約中の作品を、発売日ごとにまとめて毎日更新。きょうの新着人気TOP3と話題も、毎日入れかわります。"
  path="/"
  jsonLd={[websiteLd()]}
>
  {/* セールの「終わったら隠す」（public/sale.js）を、ページの先頭にそのまま入れる。中身が読み込まれるそばから印を付けるので、終わったものが見えてから消えて下がずれない（2026-10-07） */}
  {(saleCamps.length > 0 || tenYenNow.total > 0) && <script is:inline id="sale-early" set:html={inlineScript('/sale.js')} />}
  <div class="wrap">
    {/* お気に入りの出演者・メーカーがある人だけに出る（html.has-favs。はじめから場所を取り、新作・予約があれば本数に書きかわる。favorites.js） */}
    <a id="fav-banner" class="fav-banner" href="/favorites/" hidden>★ お気に入りの新作・予約を見る</a>

    {/* スマホ: 見出し → TOP3 → 作品を探す → いま人気の女優 → 人気のジャンル → きょうの話題 → セール → 発売中（いちばん新しい日付の下におすすめのコーナー）→ 予約 の1列
        （右の欄の中の並びは site.css の order。週のまとめ・月のまとめの欄は、パソコンだけ。スマホは「作品を探す」のリンクから）。
        パソコン: 見出しを横いっぱいに、左に TOP3 → セール → 発売中 → 予約、右の欄（.home-side）に 作品を探す → きょうの話題 → いま人気の女優 → 人気のジャンル → 週のまとめ → おすすめのコーナー → 月のまとめ */}
    {/* 10円セールの開催中は、見出しのすぐ下（パソコンは横いっぱい）に大きな案内（運営者の希望「ものすごく訴求したい」。2026-10-09）。右の欄は、その下の行から */}
    <div class="home has-side" style={`--side-span: ${mainCount}${tenYenNow.total > 0 ? '; --side-start: 3' : ''}`}>
      <header class="today-head">
        <p class="today-date"><time datetime={today}>{day.m}月{day.d}日（{day.wd}）</time>の更新</p>
        <h1 class="today-title">きょうのFANZA新作</h1>
        <div class="list-tools today-tools">
          <VrToggle />
        </div>
      </header>

      <TenYenHero />

      {top.length > 0 && (
        <section id="ranking" class="today-top" aria-labelledby="ranking-title">
          <div class="today-sec-head">
            <h2 id="ranking-title" class="today-sec-title">{topIsNew ? 'きょうの新着人気TOP3' : '売れ筋TOP3'}</h2>
            <p class="section-note">
              {topIsNew ? 'この1週間に発売された作品の人気順' : 'FANZAの人気順'}｜{topDay.m}月{topDay.d}日時点<span class="rank-vr-note" hidden>｜VRを除く</span>
            </p>
          </div>
          <TopThree entries={top} />
        </section>
      )}

      <div class="home-side">
      {/* 「月ごと」「週のまとめ」のリンク（only-narrow）は、スマホだけ。パソコンは、右の欄に専用の欄がある */}
      <section class="find" aria-labelledby="find-title">
        <h2 id="find-title" class="find-title">作品を探す</h2>
        <form class="hero-search search-bar" action={SEARCH_PATH} method="get" role="search">
          <svg class="search-bar-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 20 20" /></svg>
          <label class="visually-hidden" for="hero-q">作品を探す（タイトル・出演者・メーカー・品番）</label>
          <input id="hero-q" class="search-bar-input" type="search" name="q" placeholder="タイトル・出演者・品番" enterkeyhint="search" autocomplete="off" />
          <button class="search-bar-btn" type="submit">探す</button>
        </form>
        <nav class="hero-jump" aria-label="探し方">
          {/* 新着の人気ランキングは、横いっぱいの1つ目（運営者の希望。前は「予約○本」があった所。2026-10-05） */}
          <a class="chip-link chip-link-wide" href={RANKING_PATH}>新着の人気ランキング</a>
          {/* 1行目: ○○検索の3つ。2行目（スマホだけ）: 週のまとめ（左）・月のまとめ（右）。運営者の希望。2026-10-05 */}
          {tagGroups.length > 0 && <a class="chip-link" href={TAG_INDEX_PATH}>ジャンル検索</a>}
          <a class="chip-link" href={ACTRESS_INDEX_PATH}>女優検索</a>
          <a class="chip-link" href={MAKER_INDEX_PATH}>メーカー検索</a>
          {latestRoundup && <a class="chip-link only-narrow" href={weeklyPath(latestRoundup.week_start)}>週のまとめ</a>}
          {monthGroups.length > 0 && <a class="chip-link only-narrow" href={MONTH_INDEX_PATH}>月のまとめ</a>}
        </nav>
        {/* FANZA同人・FANZAゲーム（運営者の希望。2026-10-09。データがある売り場だけ。2つを横に並べる） */}
        {activeFloors.length > 0 && (
          <nav class="hero-jump floor-jump" aria-label="同人・ゲーム">
            {activeFloors.map((k) => <a class="chip-link" href={floorPath(k)}>{FLOORS[k].label}</a>)}
          </nav>
        )}
      </section>
      {hot.length > 0 && (
        <section id="hot" class="today-hot" aria-labelledby="hot-title">
          <div class="today-sec-head">
            <h2 id="hot-title" class="today-sec-title">いま人気の女優</h2>
          </div>
          <HotActresses list={hot} listNoVr={hotNoVr} />
        </section>
      )}

      {genres.length > 0 && (
        <section id="genres" class="today-genres" aria-labelledby="genres-title">
          <div class="today-sec-head">
            <h2 id="genres-title" class="today-sec-title">人気のジャンル</h2>
          </div>
          <HotGenres list={genres} />
        </section>
      )}

      {topics.length > 0 && (
        <section id="topics" class="today-topics" aria-labelledby="topics-title">
          <div class="today-sec-head">
            <h2 id="topics-title" class="today-sec-title">きょうの話題</h2>
            <p class="section-note">毎日入れかわります</p>
          </div>
          <TopicList topics={topics} />
          {upcomingEventList.length > 0 && (
            <ul class="side-links topic-more">
              <li><a class="side-link" href={EVENT_PATH}>女優のイベントの予定（{upcomingEventList.length}件）</a></li>
            </ul>
          )}
        </section>
      )}
      {/* 運命の作品・おすすめのコーナーは、パソコンのときだけ、ここへ移す（下の小さなスクリプト。スマホでは、発売中の新作の中のまま） */}
      <SideWeekly />
      {(hasCorner || hasGacha) && <div id="side-corner" class="side-corner"></div>}
      <SideMonths />
      </div>


    {saleCamps.length > 0 && (
      <section id="sale" class="section" aria-labelledby="sale-title" data-sale-group>
        <div class="section-head">
          <h2 id="sale-title" class="section-title">セール中の特集</h2>
          <p class="section-note">FANZAのキャンペーン{saleDay && `｜${saleDay.m}月${saleDay.d}日時点`}</p>
        </div>
        <SaleCampaigns groups={saleCamps} />
        <p class="more"><a class="btn btn-quiet" href={SALE_PATH}>セール・キャンペーンをすべて見る（{saleTotal.toLocaleString('ja-JP')}本）</a></p>
      </section>
    )}

    <section id="released" class="section" aria-labelledby="released-title">
      <div class="section-head">
        <h2 id="released-title" class="section-title">発売中の新作</h2>
        <p class="section-note">発売日が新しい順{released.length > 0 && `・全${released.length}本`}</p>
      </div>
      {releasedGroups.length > 0
        ? <>
            <DaySection groups={releasedGroups.slice(0, 1)} />
            {hasCorner && (
              <div id="corner-home" class="corner-home">
                <PickCorner debuts={debuts} birthdays={birthdays} />
              </div>
            )}
            {/* パソコン（960px〜）では、おすすめのコーナーを右の欄（#side-corner）へ移す。ページを読みながらすぐ動かすので、表示がずれない。画面の幅が変わったら（iPadの縦横など）戻す */}
            {hasCorner && <script is:inline set:html={CORNER_MOVE_JS} />}
            <DaySection groups={releasedGroups.slice(1)} />
          </>
        : <p class="empty">発売中の作品を準備しています。毎日の更新をお待ちください。</p>}
      {hasMore && (
        <p class="more"><a class="btn btn-quiet" href={archivePath(1)}>過去の作品をすべて見る</a></p>
      )}
      {/* 運命の作品: スマホでは、発売中の新作を見終わったところ（予約受付中の真上）。パソコンでは右の欄のいちばん上へ移す */}
      {hasGacha && (
        <div id="gacha-home" class="gacha-home">
          <GachaCorner gacha={gacha} />
        </div>
      )}
      {hasGacha && <script is:inline set:html={GACHA_MOVE_JS} />}
    </section>

    {upcomingGroups.length > 0 && (
      <section id="upcoming" class="section" aria-labelledby="upcoming-title" data-fold={upcomingFold || undefined}>
        <div class="section-head">
          <h2 id="upcoming-title" class="section-title">予約受付中</h2>
          <p class="section-note">発売日が近い順・{upcomingShown}本</p>
        </div>
        <DaySection groups={upcomingGroups} fold={upcomingFold} />
        {upcomingFold > 0 && (
          <p class="more"><button type="button" class="btn btn-quiet more-btn" data-fold-more>もっと見る（あと<span data-fold-rest>{upcomingShown - upcomingFold}</span>本）</button></p>
        )}
      </section>
    )}
    </div>
  </div>
  {hasGacha && <script is:inline src={assetUrl('/gacha.js')} defer></script>}
</Base>
