---
import Base from '../layouts/Base.astro';
import DaySection from '../components/DaySection.astro';
import TodayStats from '../components/TodayStats.astro';
import TopThree from '../components/TopThree.astro';
import TopicList from '../components/TopicList.astro';
import VrToggle from '../components/VrToggle.astro';
import ItemCard from '../components/ItemCard.astro';
import {
  all,
  sale,
  today,
  released,
  upcoming,
  roundups,
  ranking,
  monthGroups,
  tagGroups,
  paged,
  popularity,
  todayData,
  actressByName,
  profilesByName,
} from '../lib/data.js';
import { itemHref } from '../lib/plan.js';
import { faceUrl } from '../lib/profiles.js';
import { RANKING_ALL_PATH, RANKING_PATH } from '../lib/popularity.js';
import { SALE_PATH, endIso, saleBadge, saleCount, saleHighlights, salePriceNote } from '../lib/sale.js';
import { TOP_SHOWN, buildTopics, todayStats, topEntries } from '../lib/topics.js';
import { MONTH_INDEX_PATH, TAG_INDEX_PATH } from '../lib/collections.js';
import { weeklyPath } from '../lib/roundups.js';
import { SEARCH_PATH } from '../lib/search.js';
import {
  dateParts,
  groupByDate,
  countByDate,
  vrAttrs,
  archivePath,
  websiteLd,
  SITE_NAME,
  HOME_RELEASED_LIMIT,
  HOME_UPCOMING_LIMIT,
  ACTRESS_INDEX_PATH,
  MAKER_INDEX_PATH,
} from '../lib/items.js';

const releasedGroups = groupByDate(released.slice(0, HOME_RELEASED_LIMIT), countByDate(released));
const upcomingGroups = groupByDate(upcoming.slice(0, HOME_UPCOMING_LIMIT), countByDate(upcoming));
const upcomingShown = Math.min(upcoming.length, HOME_UPCOMING_LIMIT); // 「予約受付中 N本」は、下に並ぶ数と同じにする
const hasMore = released.length > HOME_RELEASED_LIMIT;
const latestRoundup = roundups[0]; // いちばん新しい週のまとめ（無ければ undefined）
const day = dateParts(today);

// きょうの新着人気TOP3（この1週間に発売された作品の、その日のFANZAの人気順）。まだ集まっていないあいだは、売れ筋（FANZAの人気順の上位）で代わりにする
const newTop = topEntries(all, today);
const topIsNew = newTop.length > 0;
const top = topIsNew ? newTop : (ranking?.items ?? []);
const topDay = topIsNew ? (popularity.date ? dateParts(popularity.date) : day) : ranking ? dateParts(ranking.date) : null;

// きょうの数字（FANZA動画全体の発売本数・予約受付中の本数）。今日のデータが無ければ出さない
const stats = todayStats(todayData, today);

// きょうの話題（毎日の更新が集めた人気順・予約の人気順・セールから、データで決まった形の文を作る。TOP3に出ている作品は除く）
const topics = buildTopics({
  items: all,
  today,
  popularity,
  todayData,
  sale,
  roundup: latestRoundup ?? null,
  linkOf: (item) => itemHref(item, paged),
  actressPage: (name) => actressByName.get(name)?.path ?? '',
  faceOf: (name) => faceUrl(profilesByName.get(name)),
  skip: new Set(top.slice(0, TOP_SHOWN).map((i) => i.cid)),
});

// セール中（FANZAのキャンペーン。人気の高い作品から数本。終わった時刻をすぎたものは、ブラウザで隠す /sale.js）
const saleShown = saleHighlights(all, sale, today);
const saleTotal = saleCount(all, sale, today);
---

<Base
  title={`${SITE_NAME}｜毎日更新のFANZA新作・予約作品まとめ`}
  description="FANZAの新作・新着と予約中の作品を、発売日ごとにまとめて毎日更新。きょうの新着人気TOP3・発売本数・話題も、毎日入れかわります。"
  path="/"
  jsonLd={[websiteLd()]}
>
  <div class="wrap">
    <a id="fav-banner" class="fav-banner" href="/favorites/" hidden></a>

    <div class={stats ? 'today has-stats' : 'today'}>
      <header class="today-head">
        <p class="today-date"><time datetime={today}>{day.m}月{day.d}日（{day.wd}）</time>の更新</p>
        <h1 class="today-title">きょうのFANZA新作</h1>
        <p class="today-lead">新作・予約を発売日ごとにまとめて、人気の順位と話題を毎日入れかえています。</p>
        <div class="list-tools today-tools">
          <VrToggle />
        </div>
      </header>

      {top.length > 0 && (
        <section id="ranking" class="today-top" aria-labelledby="ranking-title">
          <div class="today-sec-head">
            <h2 id="ranking-title" class="today-sec-title">{topIsNew ? 'きょうの新着人気TOP3' : '売れ筋TOP3'}</h2>
            <p class="section-note">
              {topIsNew ? 'この1週間に発売された作品の人気順' : 'FANZAの人気順'}｜{topDay.m}月{topDay.d}日時点<span class="rank-vr-note" hidden>｜VRを除く</span>
            </p>
          </div>
          <TopThree entries={top} />
          <p class="today-links">
            <a class="chip-link" href={RANKING_PATH}>新着の人気ランキング</a>
            <a class="chip-link" href={RANKING_ALL_PATH}>全体の人気ランキング</a>
          </p>
        </section>
      )}

      {stats && <TodayStats stats={stats} />}

      {topics.length > 0 && (
        <section id="topics" class="today-topics" aria-labelledby="topics-title">
          <div class="today-sec-head">
            <h2 id="topics-title" class="today-sec-title">きょうの話題</h2>
            <p class="section-note">FANZAの人気順・予約・セールから｜毎日入れかわります</p>
          </div>
          <TopicList topics={topics} />
        </section>
      )}
    </div>

    <section class="find" aria-labelledby="find-title">
      <h2 id="find-title" class="find-title">作品を探す</h2>
      <form class="hero-search" action={SEARCH_PATH} method="get" role="search">
        <label class="visually-hidden" for="hero-q">作品を探す（タイトル・出演者・メーカー・品番）</label>
        <input id="hero-q" class="hero-search-input" type="search" name="q" placeholder="タイトル・出演者・品番" enterkeyhint="search" autocomplete="off" />
        <button class="hero-search-btn" type="submit">探す</button>
      </form>
      <nav class="hero-jump" aria-label="探し方">
        {tagGroups.length > 0 && <a class="chip-link" href={TAG_INDEX_PATH}>ジャンル</a>}
        <a class="chip-link" href={ACTRESS_INDEX_PATH}>女優検索</a>
        <a class="chip-link" href={MAKER_INDEX_PATH}>メーカー</a>
        {monthGroups.length > 0 && <a class="chip-link" href={MONTH_INDEX_PATH}>月ごと</a>}
        {upcoming.length > 0 && <a class="chip-link" href="#upcoming">予約 {upcomingShown}本</a>}
        {latestRoundup && <a class="chip-link" href={weeklyPath(latestRoundup.week_start)}>週のまとめ</a>}
      </nav>
    </section>

    {saleShown.length > 0 && (
      <section id="sale" class="section" aria-labelledby="sale-title" data-sale-group data-vr-group>
        <div class="section-head">
          <h2 id="sale-title" class="section-title">セール中</h2>
          <p class="section-note">FANZAのキャンペーン｜人気の高い作品から</p>
        </div>
        <ul class="shelf">
          {saleShown.map((item) => (
            <li class="shelf-cell" data-sale-end={endIso(sale.campaigns[item.sale.k].end)} {...vrAttrs(item)}>
              <ItemCard item={item} level="h3" badge={saleBadge(item.sale)} note={salePriceNote(item.sale)} />
            </li>
          ))}
        </ul>
        <p class="more"><a class="btn btn-quiet" href={SALE_PATH}>セール・キャンペーンをすべて見る（{saleTotal}本）</a></p>
      </section>
    )}

    <section id="released" class="section" aria-labelledby="released-title">
      <div class="section-head">
        <h2 id="released-title" class="section-title">発売中の新作</h2>
        <p class="section-note">発売日が新しい順{released.length > 0 && `・全${released.length}本`}</p>
      </div>
      {releasedGroups.length > 0
        ? <DaySection groups={releasedGroups} />
        : <p class="empty">発売中の作品を準備しています。毎日の更新をお待ちください。</p>}
      {hasMore && (
        <p class="more"><a class="btn btn-quiet" href={archivePath(1)}>過去の作品をすべて見る</a></p>
      )}
    </section>

    {upcomingGroups.length > 0 && (
      <section id="upcoming" class="section" aria-labelledby="upcoming-title">
        <div class="section-head">
          <h2 id="upcoming-title" class="section-title">予約受付中</h2>
          <p class="section-note">発売日が近い順・{upcomingShown}本</p>
        </div>
        <DaySection groups={upcomingGroups} />
      </section>
    )}
  </div>
  {saleShown.length > 0 && <script is:inline src="/sale.js" defer></script>}
</Base>
