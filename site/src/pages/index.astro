---
import Base from '../layouts/Base.astro';
import DaySection from '../components/DaySection.astro';
import RankCard from '../components/RankCard.astro';
import VrToggle from '../components/VrToggle.astro';
import { released, upcoming, roundups, ranking, monthGroups, tagGroups } from '../lib/data.js';
import { MONTH_INDEX_PATH, TAG_INDEX_PATH } from '../lib/collections.js';
import { weeklyPath } from '../lib/roundups.js';
import { SEARCH_PATH } from '../lib/search.js';
import {
  dateParts,
  groupByDate,
  countByDate,
  vrAttrs,
  rankHasHero,
  RANKING_SHOWN,
  archivePath,
  websiteLd,
  SITE_NAME,
  HOME_RELEASED_LIMIT,
  HOME_UPCOMING_LIMIT,
  ACTRESS_INDEX_PATH,
  MAKER_INDEX_PATH,
} from '../lib/items.js';

const releasedGroups = groupByDate(released.slice(0, HOME_RELEASED_LIMIT), countByDate(released));
const upcomingGroups = groupByDate(upcoming.slice(0, HOME_UPCOMING_LIMIT), countByDate(upcoming));
const upcomingShown = Math.min(upcoming.length, HOME_UPCOMING_LIMIT); // 「予約受付中 N本」は、下に並ぶ数と同じにする
const hasMore = released.length > HOME_RELEASED_LIMIT;
const latestRoundup = roundups[0]; // いちばん新しい週のまとめ（無ければ undefined）
const rankingDay = ranking ? dateParts(ranking.date) : null;
// 売れ筋は、データに多め（最大6本）に入っていて、画面に出すのは先頭の RANKING_SHOWN 本（残りは rank-off で隠しておく）。
// 「VR作品を隠す」を押すと、VRを除いた先頭の RANKING_SHOWN 本に差し替える（site/public/vr-filter.js の rankLayout）。
// 並べ方の印（data-visible = 見えている本数、先頭の .is-hero = 大きく出す1本）も、そのとき付け直す
const rankShownCount = ranking ? Math.min(ranking.items.length, RANKING_SHOWN) : 0;
const rankFirstIsHero = rankHasHero(rankShownCount);
---

<Base
  title={`${SITE_NAME}｜毎日更新のFANZA新作・予約作品まとめ`}
  description="FANZAの新作・新着と予約中の作品を、発売日ごとにまとめて毎日更新。作品ごとにひとこと添えています。"
  path="/"
  jsonLd={[websiteLd()]}
>
  <div class="wrap">
    <a id="fav-banner" class="fav-banner" href="/favorites/" hidden></a>

    <section class="hero">
      <h1 class="hero-title"><span class="phrase">FANZAの新作を、</span><span class="phrase">発売日ごとに。</span></h1>
      <p class="hero-lead">発売日ごとに新作をまとめて、作品ごとにひとこと添えています。毎日更新。</p>
      <form class="hero-search" action={SEARCH_PATH} method="get" role="search">
        <label class="visually-hidden" for="hero-q">作品を探す（タイトル・出演者・メーカー・品番）</label>
        <input id="hero-q" class="hero-search-input" type="search" name="q" placeholder="タイトル・出演者・品番" enterkeyhint="search" autocomplete="off" />
        <button class="hero-search-btn" type="submit">探す</button>
      </form>
      <nav class="hero-jump" aria-label="探し方">
        {tagGroups.length > 0 && <a class="chip-link" href={TAG_INDEX_PATH}>ジャンル</a>}
        <a class="chip-link" href={ACTRESS_INDEX_PATH}>出演者</a>
        <a class="chip-link" href={MAKER_INDEX_PATH}>メーカー</a>
        {monthGroups.length > 0 && <a class="chip-link" href={MONTH_INDEX_PATH}>月ごと</a>}
        {upcoming.length > 0 && <a class="chip-link" href="#upcoming">予約 {upcomingShown}本</a>}
        {latestRoundup && <a class="chip-link" href={weeklyPath(latestRoundup.week_start)}>週のまとめ</a>}
      </nav>
    </section>

    <div class="list-tools">
      <VrToggle />
    </div>

    {ranking && (
      <section id="ranking" class="section" aria-labelledby="ranking-title">
        <div class="section-head">
          <h2 id="ranking-title" class="section-title">売れ筋TOP3</h2>
          <p class="section-note">FANZAの人気順｜{rankingDay.m}月{rankingDay.d}日時点<span class="rank-vr-note" hidden>｜VRを除く</span></p>
        </div>
        <ul class="shelf rank-podium" data-show={RANKING_SHOWN} data-visible={rankShownCount}>
          {ranking.items.map((entry, i) => (
            <li class={`shelf-cell rank-cell${i === 0 && rankFirstIsHero ? ' is-hero' : ''}${i >= RANKING_SHOWN ? ' rank-off' : ''}`} data-rank={entry.rank} {...vrAttrs(entry)}>
              <RankCard entry={entry} first={i === 0} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <section id="released" class="section" aria-labelledby="released-title">
      <div class="section-head">
        <h2 id="released-title" class="section-title">発売中の新作</h2>
        <p class="section-note">発売日が新しい順{released.length > 0 && `・全${released.length}本`}</p>
      </div>
      {releasedGroups.length > 0
        ? <DaySection groups={releasedGroups} />
        : <p class="empty">発売中の作品を準備しています。毎日の更新をお待ちください。</p>}
      {hasMore && (
        <p class="more"><a class="btn btn-quiet" href={archivePath(1)}>過去の作品をすべて見る</a></p>
      )}
    </section>

    {upcomingGroups.length > 0 && (
      <section id="upcoming" class="section" aria-labelledby="upcoming-title">
        <div class="section-head">
          <h2 id="upcoming-title" class="section-title">予約受付中</h2>
          <p class="section-note">発売日が近い順・{upcomingShown}本</p>
        </div>
        <DaySection groups={upcomingGroups} />
      </section>
    )}
  </div>
</Base>
