---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_NAME, SITE_URL, breadcrumbLd } from '../../lib/items.js';
import { CALENDAR_PATH, UPCOMING_ICS_PATH, webcalUrl } from '../../lib/calendar.js';
import { FAVORITES_PATH } from '../../lib/favorites.js';

const trail = [
  { name: 'トップ', path: '/' },
  { name: '発売日カレンダー', path: CALENDAR_PATH },
];
// 使い方の説明ページなので、検索には載せない（noindex）
---

<Base
  title={`発売日カレンダー｜${SITE_NAME}`}
  description="FANZAの新作の発売日を、iPad・iPhone・Googleカレンダーに自動で入れる方法です。"
  path={CALENDAR_PATH}
  noindex={true}
  jsonLd={[breadcrumbLd(trail)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">発売日カレンダー</h1>
      <p class="hero-lead">発売日を、カレンダーアプリに自動で入れられます。</p>
    </section>

    <section class="section" aria-labelledby="cal-all-title">
      <h2 id="cal-all-title" class="section-title">すべての発売予定</h2>
      <p class="summary">予約・新作の発売日が、まとめて入ります。</p>
      <p><a class="btn btn-hot cal-btn" href={webcalUrl(UPCOMING_ICS_PATH)}>カレンダーに追加する</a></p>
      <p class="fine">Android・Googleカレンダーでは、このアドレスを使います。</p>
      <div class="cal-url-row">
        <code class="cal-url">{SITE_URL + UPCOMING_ICS_PATH}</code>
        <button type="button" class="btn btn-quiet cal-copy" data-copy={SITE_URL + UPCOMING_ICS_PATH} hidden>アドレスをコピー</button>
      </div>
    </section>

    <section class="section" aria-labelledby="cal-fav-title">
      <h2 id="cal-fav-title" class="section-title">お気に入りの出演者・メーカーだけ</h2>
      <p class="summary">出演者・メーカーのページ（と<a class="spec-link" href={FAVORITES_PATH}>お気に入り</a>）の「発売日をカレンダーで受け取る」から入れられます。</p>
    </section>

    <section class="section" aria-labelledby="cal-how-title">
      <h2 id="cal-how-title" class="section-title">使い方（iPad・iPhone）</h2>
      <ol class="steps">
        <li>上の「カレンダーに追加する」を押します。</li>
        <li>「カレンダーを購読しますか？」と出たら、「購読」を押します。</li>
        <li>「追加」を押すと、カレンダーに発売日が入ります。</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="cal-google-title">
      <h2 id="cal-google-title" class="section-title">使い方（Android・Googleカレンダー）</h2>
      <p class="summary">Googleカレンダーは、パソコンのブラウザからだけ追加できます（追加すれば、スマホにも出ます）。</p>
      <ol class="steps">
        <li>上の「アドレスをコピー」で、アドレスをコピーします。</li>
        <li>パソコンのブラウザで、Googleカレンダー（calendar.google.com）を開きます。</li>
        <li>左の「他のカレンダー」の「＋」から「URLで追加」を選び、アドレスを貼り付けて「カレンダーを追加」を押します。</li>
        <li>スマホのGoogleカレンダーで見えないときは、アプリの設定で、このカレンダーの「同期」をオンにします。</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="cal-note-title">
      <h2 id="cal-note-title" class="section-title">知っておいてほしいこと</h2>
      <ul class="notes">
        <li>予定の題名は「【発売】○○の新作」です（作品のタイトルは、予定の詳細に入っています）。</li>
        <li>発売日の朝9時に通知します（鳴るかどうかは、アプリの設定しだい）。</li>
        <li>新しい作品が入るまで、時間がかかることがあります。</li>
        <li>やめるときは、カレンダーアプリで、このカレンダーを削除します。</li>
      </ul>
    </section>
  </div>

  {/* 「アドレスをコピー」: コピーの機能がある端末でだけ出す。押すと「コピーしました」に変わる（ページの中だけの小さな動き） */}
  <script is:inline>
    (function () {
      if (!navigator.clipboard || !navigator.clipboard.writeText) return;
      document.querySelectorAll('.cal-copy').forEach(function (button) {
        button.hidden = false;
        button.addEventListener('click', function () {
          navigator.clipboard.writeText(button.getAttribute('data-copy') || '').then(
            function () {
              button.textContent = 'コピーしました';
              setTimeout(function () {
                button.textContent = 'アドレスをコピー';
              }, 2000);
            },
            function () {
              button.textContent = 'コピーできませんでした';
              setTimeout(function () {
                button.textContent = 'アドレスをコピー';
              }, 2000);
            }
          );
        });
      });
    })();
  </script>
</Base>
