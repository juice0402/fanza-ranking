---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Face from '../../components/Face.astro';
import { actressGroups, actressSearchIndex, actressIndexCoverage, profilesByName } from '../../lib/data.js';
import { ACTRESS_INDEX_PATH, SITE_NAME, ENTITY_MIN_ITEMS, breadcrumbLd } from '../../lib/items.js';
import { ACTRESS_SEARCH_INDEX_PATH, compactSpec, faceUrl } from '../../lib/profiles.js';

const trail = [
  { name: 'トップ', path: '/' },
  { name: '女優検索', path: ACTRESS_INDEX_PATH },
];
const hasSearch = actressSearchIndex.actresses.length > 0;
const cov = actressIndexCoverage;
const fmt = (n) => n.toLocaleString('ja-JP');

// 数字の条件（下限・上限を、数字で入れる）。name は actress-search.js の RANGES と同じ
const RANGES = [
  { name: 'age', label: '年齢', unit: '歳', min: 18, max: 80 },
  { name: 'height', label: '身長', unit: 'cm', min: 120, max: 210 },
  { name: 'bust', label: 'バスト', unit: 'cm', min: 50, max: 160 },
  { name: 'waist', label: 'ウエスト', unit: 'cm', min: 40, max: 130 },
  { name: 'hip', label: 'ヒップ', unit: 'cm', min: 50, max: 160 },
];
const CUPS = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K'];
const SORTS = [
  ['works', 'このサイトの作品の多い順'],
  ['bust', 'バストの大きい順'],
  ['cup', 'カップの大きい順'],
  ['young', '年齢の若い順'],
  ['old', '年齢の高い順'],
  ['tall', '身長の高い順'],
  ['short', '身長の低い順'],
  ['waist', 'ウエストの細い順'],
  ['hip', 'ヒップの大きい順'],
  ['newest', 'FANZAに新しく登録された順'],
  ['name', '名前（五十音）順'],
];
---

<Base
  title={`女優検索｜年齢・身長・スリーサイズ・カップで探す｜${SITE_NAME}`}
  description="FANZAのAV女優を、名前・年齢・身長・スリーサイズ（バスト・ウエスト・ヒップ）・カップで検索できます。プロフィールはFANZA公式のデータです。"
  path={ACTRESS_INDEX_PATH}
  jsonLd={[breadcrumbLd(trail)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">女優検索</h1>
      <p class="hero-lead">
        {hasSearch
          ? <>FANZA公式のプロフィールが載っている{fmt(cov.total)}人から、名前・年齢・身長・スリーサイズ（バスト・ウエスト・ヒップ）・カップで探せます。このサイトに作品が{ENTITY_MIN_ITEMS}本以上ある人は専用ページ、それ以外の人はFANZAの作品一覧にリンクします。</>
          : <>掲載している作品が{ENTITY_MIN_ITEMS}本以上ある出演者の一覧です。作品数の多い順に並べています。</>}
      </p>
    </section>

    {hasSearch && (
      <section id="actress-search" class="actress-search section" data-index={ACTRESS_SEARCH_INDEX_PATH} aria-labelledby="as-title" hidden>
        <h2 id="as-title" class="section-title">条件で探す</h2>
        <form class="as-form" role="search" autocomplete="off">
          <label class="as-field as-field-wide">
            名前（ひらがな・カタカナでもOK）
            <input type="search" name="q" placeholder="例: さくら" enterkeyhint="search" />
          </label>
          {/* 年齢・身長・スリーサイズ・カップ・並び順は、たためる（スマホで、結果がすぐ見えるように。広い画面・条件つきで開いたときは開く。actress-search.js） */}
          <details id="as-filters" class="ws-filters">
            <summary class="ws-filters-toggle">年齢・身長・スリーサイズ・カップで絞り込む<span id="as-filter-note" class="ws-filter-note"></span></summary>
            <div class="as-ranges">
              {RANGES.map((r) => (
                <fieldset class="as-range">
                  <legend class="as-range-label">{r.label}</legend>
                  <div class="as-range-inputs">
                    <input type="number" name={`${r.name}_min`} inputmode="numeric" min={r.min} max={r.max} placeholder="下限" aria-label={`${r.label}の下限（${r.unit}）`} />
                    <span class="as-range-sep" aria-hidden="true">〜</span>
                    <input type="number" name={`${r.name}_max`} inputmode="numeric" min={r.min} max={r.max} placeholder="上限" aria-label={`${r.label}の上限（${r.unit}）`} />
                    <span class="as-range-unit">{r.unit}</span>
                  </div>
                </fieldset>
              ))}
            </div>
            <fieldset class="as-cups">
              <legend class="as-range-label">カップ（いくつでも選べます）</legend>
              <div class="as-cup-list">
                {CUPS.map((c) => (
                  <label class="as-cup"><input type="checkbox" name="cup" value={c} /><span>{c}</span></label>
                ))}
                <label class="as-cup"><input type="checkbox" name="cup" value="L+" /><span>L〜</span></label>
              </div>
            </fieldset>
            <div class="as-checks">
              <label class="as-check"><input type="checkbox" name="site" value="1" /> このサイトに作品がある人だけ</label>
              <label class="as-check"><input type="checkbox" name="face" value="1" /> 顔写真がある人だけ</label>
            </div>
          </details>
          <label class="as-field as-field-wide">
            並び順
            <select name="sort">
              {SORTS.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
          <div class="as-actions">
            <button type="reset" class="btn btn-quiet">条件をクリア</button>
          </div>
        </form>
        <p id="as-count" class="as-count" aria-live="polite"></p>
        <p id="as-note" class="as-note" hidden>年齢・身長・スリーサイズ・カップで絞り込むと、FANZAにその情報が載っていない人は結果に出ません。</p>
        <ul id="as-list" class="actress-list"></ul>
        <p class="more"><button id="as-more" type="button" class="btn btn-quiet more-btn" hidden>もっと見る</button></p>
        <p class="as-coverage">
          プロフィールは、FANZA公式の出演者データです（ほかのサイトの情報や推測は使っていません）。いま探せる{fmt(cov.total)}人のうち、年齢が分かるのは{fmt(cov.withAge)}人、身長は{fmt(cov.withHeight)}人、スリーサイズは{fmt(cov.withSize)}人、カップは{fmt(cov.withCup)}人です。年齢は、FANZAに載っている生年月日から毎日計算しています。データは毎日、少しずつ新しくなります。
        </p>
      </section>
    )}

    <section id="actress-static" class="actress-static section" aria-labelledby="actress-list-title">
      <h2 id="actress-list-title" class="visually-hidden">出演者の一覧</h2>
      {actressGroups.length > 0
        ? (
          <ul class="actress-list">
            {actressGroups.map((g) => {
              const profile = profilesByName.get(g.name);
              const spec = compactSpec(profile);
              return (
                <li class="actress-row">
                  <a class="actress-row-link" href={g.path}>
                    <Face name={g.name} src={faceUrl(profile)} size="md" />
                    <span class="actress-row-text">
                      <span class="actress-row-name">{g.name}</span>
                      {spec && <span class="actress-row-spec">{spec}</span>}
                      <span class="actress-row-meta">掲載{g.items.length}本 ›</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        )
        : <p class="empty">まだ一覧に載せられる出演者がいません。毎日の更新をお待ちください。</p>}
    </section>
  </div>

  {hasSearch && <script is:inline src="/actress-search.js" defer></script>}
</Base>
