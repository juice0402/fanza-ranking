---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VrToggle from '../../components/VrToggle.astro';
import DaySection from '../../components/DaySection.astro';
import FavButton from '../../components/FavButton.astro';
import Face from '../../components/Face.astro';
import EventList from '../../components/EventList.astro';
import NextWorks from '../../components/NextWorks.astro';
import OnSaleWorks from '../../components/OnSaleWorks.astro';
import RatedShelf from '../../components/RatedShelf.astro';
import ActressHistory from '../../components/ActressHistory.astro';
import { HISTORY_TOP_MIN, historyDescriptionHead, nenkanDescription, nenkanIndexable, nenkanPageTitle } from '../../lib/history.js';
import MiniShelf from '../../components/MiniShelf.astro';
import { inlineScript } from '../../lib/assets.js';
import { isMinorTitle } from '../../lib/gacha.js';
import { actressByName, actressPageGroups, actressReading, agencyOfName, events, eventsOfName, historyByName, makerByName, profilesByName, sale, storiesByName, today, seriesById } from '../../lib/data.js';
import { readingLine } from '../../lib/kana.js';
import { entryChips } from '../../lib/insights.js';
import EntryChips from '../../components/EntryChips.astro';
import { offPercent, onSaleItems } from '../../lib/sale.js';
import { EVENT_ACTRESS_LIMIT, EVENT_PATH } from '../../lib/events.js';
import {
  ACTRESS_INDEX_PATH,
  entityDescription,
  actressPageTitle,
  SITE_URL,
  listLastmod,
  actressSummary,
  breadcrumbLd,
  formatsOf,
  groupByDate,
  rankedNames,
  shortSpan,
} from '../../lib/items.js';
import { ENTITY_LIST_LIMIT, SITE_NAME } from '../../config.js';
import { entityListing, hasCalendar, listIndexable } from '../../lib/plan.js';
import { CALENDAR_PATH, actressIcsPath, webcalUrl } from '../../lib/calendar.js';
import { faceUrl, profileFacts } from '../../lib/profiles.js';
import { instagramUrl, xUrl } from '../../lib/agencies.js';

// 作品が2本以上ある出演者ごとに1ページ作る。＋女優検索の名簿にいて、年表（FANZA全体で50本以上）を集めた人（作品が0本でも。女優名鑑その3。2026-10-27 #173）
export function getStaticPaths() {
  return actressPageGroups.map((group) => ({ params: { slug: group.slug }, props: { group } }));
}

const { group } = Astro.props;
// 名簿の人のページ（このサイトの作品が0〜1本。プロフィールは名簿の値。年表と紹介文の両方がそろうまで noindex。#173）
const nenkan = Boolean(group.nenkan);
const summary = group.items.length > 0 ? actressSummary(group) : '';
// 並べるのは新しい順に ENTITY_LIST_LIMIT 本まで（過去作品が多い人・メーカーで、ページが重くなりすぎないように）
const listing = entityListing(group.items, ENTITY_LIST_LIMIT);
const groups = groupByDate(listing.shown);
// 発売日カレンダーは、新作・予約が載っている人・メーカーだけ（lib/plan.js の hasCalendar）
const calendar = hasCalendar(group);
// 女優の歩み（年表。FANZAの全作品から数えたもの。集めてある人だけ。2026-10-27）
const history = historyByName.get(group.name) ?? null;
const story = history ? storiesByName.get(group.name) ?? null : null;
// コメントのある作品が1本も無いページ（過去作品だけ）は、検索エンジンには出さない。名簿の人は、年表と紹介文の両方がそろってから
const noindex = nenkan ? !nenkanIndexable(history, story) : !listIndexable(group.items);
// メーカーは、作品の多い順に8社まで（ほかは「ほか○社」。名前だけで画面が埋まらないように。2026-10-06）
const MAKERS_SHOWN = 8;
const makersAll = rankedNames(group.items.map((i) => i.maker).filter((m) => m !== '不明'), Infinity).names;
const makers = makersAll.slice(0, MAKERS_SHOWN);
const formats = formatsOf(group.items);
const profile = profilesByName.get(group.name) ?? group.profile ?? null; // FANZA公式の出演者データ（無い人もいる。名簿の人は名簿の値）
// 年齢・身長・サイズ・血液型・出身地・趣味（あるものだけ。趣味・出身地に未成年を連想させる言葉があれば出さない。2026-10-27「女優名鑑」）
const facts = profileFacts(profile, { skip: isMinorTitle });
// 所属事務所とSNS（事務所の公式サイトの所属女優のページに載っているものだけ。scripts/agency_links.py が週1回集める）。無い人もいる
const agency = agencyOfName(group.name);
const seenDay = agency ? `${Number(agency.seen.slice(5, 7))}月${Number(agency.seen.slice(8, 10))}日` : '';
// イベントの予定（所属事務所の公式サイトのイベントの一覧から。scripts/agency_events.py が毎日集める）。無い人がほとんど
const myEvents = eventsOfName.get(group.name) ?? [];
const eventsDay = events.updated ? `${Number(events.updated.slice(5, 7))}月${Number(events.updated.slice(8, 10))}日` : '';
// 次の新作（予約受付中。発売日が近い順に3本）と、いまセール中の作品（人気の高い順に6本）（運営者の希望「SEOを上位に」→ ②女優のページを強く。2026-10-06）
const NEXT_SHOWN = 3;
const SALE_SHOWN = 6;
// 次の新作・セール中の作品は、こちらから案内する欄なので、未成年を連想させるタイトルの作品は入れない（下の「作品」の一覧には出る。2026-10-06）
const upcomingWorks = group.items.filter((i) => i.dateKey > today && !isMinorTitle(i.title)).sort((a, b) => a.dateKey.localeCompare(b.dateKey) || a.cid.localeCompare(b.cid));
// セールのデータに出演者が入っていれば、このサイトに無いセール中の作品も入れる（作品ページが無いので FANZA へ。2026-10-27）
const groupCids = new Set(group.items.map((i) => i.cid));
const saleExtras = sale.extras.filter((i) => !groupCids.has(i.cid) && i.actress.includes(group.name));
const saleWorks = onSaleItems([...group.items, ...saleExtras], sale, today).filter((i) => !isMinorTitle(i.title));
const saleMaxOff = Math.max(0, ...saleWorks.map((i) => offPercent(i.sale.price, i.sale.listPrice) ?? 0)) || null;
const md = (d) => `${Number(d.slice(5, 7))}月${Number(d.slice(8, 10))}日`;
// 最後に変わった日（sitemap の lastmod と同じ）。画面の「○月○日更新」と、構造化データの dateModified に使う
const modified = nenkan ? [listLastmod(group.items, today), history.checked].sort().pop() : listLastmod(group.items, today);
// 人気作ベスト10・評価の高い作品（FANZA全体の人気順・評価順。集めてある人だけ。3本から。2026-10-27）。評価のほうは、無い人だけ、このサイトの作品からの棚
const popularTop = history && history.popular.length >= HISTORY_TOP_MIN ? history.popular : [];
const ratedTop = history && history.rated.length >= HISTORY_TOP_MIN ? history.rated : [];
const description = nenkan ? nenkanDescription(group.name, history, story) : entityDescription(summary, { next: upcomingWorks[0] ?? null, saleCount: saleWorks.length, maxOff: saleMaxOff, head: historyDescriptionHead(history) });
// 読みがな（FANZAのプロフィール・名簿から。見出しの下と、構造化データの alternateName に。2026-10-10）
const ruby = readingLine(group.name, actressReading(group.name));
const sameAs = agency ? [agency.x && `https://x.com/${agency.x}`, agency.instagram && `https://www.instagram.com/${agency.instagram}/`].filter(Boolean) : [];
const profileLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: SITE_URL + group.path,
  ...(modified ? { dateModified: modified } : {}),
  mainEntity: {
    '@type': 'Person',
    name: group.name,
    ...(ruby ? { alternateName: ruby } : {}),
    ...(faceUrl(profile, true) ? { image: faceUrl(profile, true) } : {}),
    ...(sameAs.length ? { sameAs } : {}),
    // schema.org の Person にある項目だけ（身長・出身地。2026-10-27「女優名鑑」）
    ...(profile?.height ? { height: { '@type': 'QuantitativeValue', value: profile.height, unitCode: 'CMT' } } : {}),
    ...(facts.some(([k]) => k === '出身地') ? { birthPlace: { '@type': 'Place', name: profile.birthplace } } : {}),
  },
};
const trail = [
  { name: 'トップ', path: '/' },
  { name: '女優検索', path: ACTRESS_INDEX_PATH },
  { name: group.name, path: group.path },
];
---

<Base
  title={nenkan ? nenkanPageTitle(group.name, history, facts.length > 0, SITE_NAME) : actressPageTitle(group, today, Boolean(history), facts.length > 0)}
  description={description}
  path={group.path}
  noindex={noindex}
  jsonLd={[breadcrumbLd(trail), profileLd]}
>
  {/* セールの「終わったら隠す」（public/sale.js）を、ページの先頭にそのまま入れる。中身が読み込まれるそばから印を付けるので、終わったものが見えてから消えて下がずれない（2026-10-07） */}
  {saleWorks.length > 0 && <script is:inline id="sale-early" set:html={inlineScript('/sale.js')} />}
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <div class="profile">
        <Face name={group.name} src={faceUrl(profile, true)} size="lg" eager />
        <div class="profile-body">
          {nenkan
            ? <h1 class="hero-title" data-nenkan="1"><span class="phrase">{group.name}の</span><span class="phrase">年表と人気作</span></h1>
            : <h1 class="hero-title"><span class="phrase">{group.name}の</span><span class="phrase">新作・出演作品</span></h1>}
          {ruby && <p class="hero-ruby">{ruby}</p>}
        </div>
      </div>
      {modified && <p class="page-updated">{md(modified)}更新</p>}
      <div class="hero-actions">
        {profile?.listUrl && (
          <a class="btn btn-hot" href={profile.listUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">FANZAで{group.name}の全作品を見る</a>
        )}
        {!nenkan && <FavButton type="actress" favKey={group.name} slug={group.slug} size="lead" off="お気に入り（新作をお知らせ）" on="お気に入り済み（新作をお知らせ）" />}
        {calendar && (
          <span class="cal-set">
            <a class="cal-link" href={webcalUrl(actressIcsPath(group.slug))}>発売日をカレンダーで受け取る</a>
            <a class="cal-help" href={CALENDAR_PATH}>使い方</a>
          </span>
        )}
      </div>
    </section>

    {facts.length > 0 && (
      <div class="section-head profile-head">
        <h2 id="profile-title" class="section-title">プロフィール</h2>
      </div>
    )}
    <dl class="spec section" aria-labelledby={facts.length > 0 ? 'profile-title' : undefined}>
      {group.items.length > 0 && (
        <>
          <dt class="spec-term">掲載作品</dt>
          <dd class="spec-desc">{group.items.length}本（{shortSpan(group.items)}発売）</dd>
        </>
      )}
      {agency && (
        <>
          <dt class="spec-term">所属</dt>
          <dd class="spec-desc"><a class="spec-link" href={agency.source} target="_blank" rel="nofollow noopener noreferrer">{agency.agency}</a></dd>
        </>
      )}
      {agency && (agency.x || agency.instagram) && (
        <>
          <dt class="spec-term">SNS</dt>
          <dd class="spec-desc sns-links">
            {agency.x && <a class="chip-link sns-link" href={xUrl(agency.x)} target="_blank" rel="nofollow noopener noreferrer" aria-label={`${group.name}さんのX（公式アカウント）`}>X（公式）</a>}
            {agency.instagram && <a class="chip-link sns-link" href={instagramUrl(agency.instagram)} target="_blank" rel="nofollow noopener noreferrer" aria-label={`${group.name}さんのInstagram（公式アカウント）`}>Instagram（公式）</a>}
          </dd>
        </>
      )}
      {facts.map(([label, value]) => (
        <>
          <dt class="spec-term">{label}</dt>
          <dd class="spec-desc">{value}</dd>
        </>
      ))}
      {makers.length > 0 && (
        <>
          <dt class="spec-term">メーカー</dt>
          <dd class="spec-desc">
            {makers.map((m, i) => (
              <>
                {i > 0 && '、'}
                {makerByName.get(m) ? <a class="spec-link" href={makerByName.get(m).path}>{m}</a> : m}
              </>
            ))}
            {makersAll.length > makers.length && `ほか${makersAll.length - makers.length}社`}
          </dd>
        </>
      )}
      {formats.length > 0 && (
        <>
          <dt class="spec-term">形式</dt>
          <dd class="spec-desc">{formats.join('・')}</dd>
        </>
      )}
    </dl>

    {agency && <p class="profile-source">所属とSNSは、所属事務所（{agency.agency}）の公式サイトに載っている情報です（{seenDay}時点）。</p>}
    {facts.length > 0 && <p class="profile-source">年齢から趣味までは、FANZAの情報です。</p>}

    <NextWorks items={upcomingWorks} shown={NEXT_SHOWN} />
    <OnSaleWorks items={saleWorks} shown={SALE_SHOWN} label="出演作品が入っているセール" title="セール中の出演作" />
    {history && <ActressHistory name={group.name} history={history} story={story} />}

    {popularTop.length > 0 && (
      <section class="section" aria-labelledby="fanza-popular-title" data-vr-group>
        <div class="section-head">
          <h2 id="fanza-popular-title" class="section-title">{group.name}さんの人気作ベスト{popularTop.length}</h2>
          <p class="section-note">FANZAの人気順｜{md(history.checked)}時点</p>
        </div>
        <MiniShelf items={popularTop} rank />
      </section>
    )}
    {ratedTop.length > 0 ? (
      <section class="section" aria-labelledby="fanza-rated-title" data-vr-group>
        <div class="section-head">
          <h2 id="fanza-rated-title" class="section-title">{group.name}さんの評価の高い作品</h2>
          <p class="section-note">FANZA全体のレビューの評価順｜{md(history.checked)}時点</p>
        </div>
        <MiniShelf items={ratedTop} rate />
      </section>
    ) : (
      <RatedShelf items={group.items} title={`${group.name}さんの評価の高い作品`} />
    )}

    {myEvents.length > 0 && (
      <section class="section" aria-labelledby="events-title">
        <div class="section-head">
          <h2 id="events-title" class="section-title">イベントの予定</h2>
          <p class="section-note">所属事務所の公式サイトから{eventsDay && `｜${eventsDay}時点`}</p>
        </div>
        <EventList
          events={myEvents.slice(0, EVENT_ACTRESS_LIMIT)}
          today={today}
          showDay
          faces={false}
          self={group.name}
          pageOf={(n) => actressByName.get(n)?.path ?? ''}
        />
        <p class="side-more"><a class="spec-link" href={EVENT_PATH}>{myEvents.length > EVENT_ACTRESS_LIMIT ? `ほか${myEvents.length - EVENT_ACTRESS_LIMIT}件と、` : ''}ほかの女優のイベントの予定</a></p>
      </section>
    )}

    <EntryChips chips={entryChips(group.items, seriesById, 'series')} title="出演しているシリーズ" id="series-title" label={`${group.name}さんが出演しているシリーズ`} />

    {group.items.length > 0 && (
    <section class="section" aria-labelledby="works-title">
      <div class="section-head">
        <h2 id="works-title" class="section-title">出演作品（{group.items.length}本）</h2>
        <p class="section-note">{listing.hidden > 0 ? `新しい順に${listing.shown.length}本。残りは「過去の作品」に` : '発売日が新しい順'}</p>
      </div>
      <div class="list-tools">
        <VrToggle />
      </div>
      <DaySection groups={groups} />
    </section>
    )}
  </div>
</Base>
