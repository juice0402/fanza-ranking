---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VrToggle from '../../components/VrToggle.astro';
import DaySection from '../../components/DaySection.astro';
import FavButton from '../../components/FavButton.astro';
import Face from '../../components/Face.astro';
import EventList from '../../components/EventList.astro';
import { actressByName, actressGroups, agencyOfName, events, eventsOfName, makerByName, profilesByName, today } from '../../lib/data.js';
import { EVENT_ACTRESS_LIMIT, EVENT_PATH } from '../../lib/events.js';
import {
  ACTRESS_INDEX_PATH,
  actressPageTitle,
  actressSummary,
  breadcrumbLd,
  formatsOf,
  groupByDate,
  summaryDescription,
} from '../../lib/items.js';
import { ENTITY_LIST_LIMIT } from '../../config.js';
import { entityListing, hasCalendar, listIndexable } from '../../lib/plan.js';
import { CALENDAR_PATH, actressIcsPath, webcalUrl } from '../../lib/calendar.js';
import { faceUrl, profileFacts } from '../../lib/profiles.js';
import { instagramUrl, xUrl } from '../../lib/agencies.js';

// 作品が2本以上ある出演者ごとに1ページ作る
export function getStaticPaths() {
  return actressGroups.map((group) => ({ params: { slug: group.slug }, props: { group } }));
}

const { group } = Astro.props;
const summary = actressSummary(group);
// 並べるのは新しい順に ENTITY_LIST_LIMIT 本まで（過去作品が多い人・メーカーで、ページが重くなりすぎないように）
const listing = entityListing(group.items, ENTITY_LIST_LIMIT);
const groups = groupByDate(listing.shown);
// 発売日カレンダーは、新作・予約が載っている人・メーカーだけ（lib/plan.js の hasCalendar）
const calendar = hasCalendar(group);
// コメントのある作品が1本も無いページ（過去作品だけ）は、検索エンジンには出さない
const noindex = !listIndexable(group.items);
const makers = [...new Set(group.items.map((i) => i.maker).filter((m) => m !== '不明'))];
const formats = formatsOf(group.items);
const profile = profilesByName.get(group.name); // FANZA公式の出演者データ（無い人もいる）
const facts = profileFacts(profile);
// 所属事務所とSNS（事務所の公式サイトの所属女優のページに載っているものだけ。scripts/agency_links.py が週1回集める）。無い人もいる
const agency = agencyOfName(group.name);
const seenDay = agency ? `${Number(agency.seen.slice(5, 7))}月${Number(agency.seen.slice(8, 10))}日` : '';
// イベントの予定（所属事務所の公式サイトのイベントの一覧から。scripts/agency_events.py が毎日集める）。無い人がほとんど
const myEvents = eventsOfName.get(group.name) ?? [];
const eventsDay = events.updated ? `${Number(events.updated.slice(5, 7))}月${Number(events.updated.slice(8, 10))}日` : '';
const trail = [
  { name: 'トップ', path: '/' },
  { name: '女優検索', path: ACTRESS_INDEX_PATH },
  { name: group.name, path: group.path },
];
---

<Base
  title={actressPageTitle(group)}
  description={summaryDescription(summary)}
  path={group.path}
  noindex={noindex}
  jsonLd={[breadcrumbLd(trail)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <div class="profile">
        <Face name={group.name} src={faceUrl(profile, true)} size="lg" eager />
        <div class="profile-body">
          <h1 class="hero-title"><span class="phrase">{group.name}の</span><span class="phrase">新作・出演作品</span></h1>
        </div>
      </div>
      <p class="summary">{summary}</p>
      <div class="hero-actions">
        {profile?.listUrl && (
          <a class="btn btn-hot" href={profile.listUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">FANZAで{group.name}の全作品を見る</a>
        )}
        <FavButton type="actress" favKey={group.name} slug={group.slug} off="この出演者をお気に入りに追加" on="お気に入り済み（新作が「お気に入り」に出ます）" />
        {calendar && (
          <span class="cal-set">
            <a class="cal-link" href={webcalUrl(actressIcsPath(group.slug))}>発売日をカレンダーで受け取る</a>
            <a class="cal-help" href={CALENDAR_PATH}>使い方</a>
          </span>
        )}
      </div>
    </section>

    <dl class="spec section">
      <dt class="spec-term">掲載作品</dt>
      <dd class="spec-desc">{group.items.length}本</dd>
      {agency && (
        <>
          <dt class="spec-term">所属</dt>
          <dd class="spec-desc"><a class="spec-link" href={agency.source} target="_blank" rel="nofollow noopener noreferrer">{agency.agency}</a></dd>
        </>
      )}
      {agency && (agency.x || agency.instagram) && (
        <>
          <dt class="spec-term">SNS</dt>
          <dd class="spec-desc sns-links">
            {agency.x && <a class="chip-link sns-link" href={xUrl(agency.x)} target="_blank" rel="nofollow noopener noreferrer" aria-label={`${group.name}さんのX（公式アカウント）`}>X（公式）</a>}
            {agency.instagram && <a class="chip-link sns-link" href={instagramUrl(agency.instagram)} target="_blank" rel="nofollow noopener noreferrer" aria-label={`${group.name}さんのInstagram（公式アカウント）`}>Instagram（公式）</a>}
          </dd>
        </>
      )}
      {facts.map(([label, value]) => (
        <>
          <dt class="spec-term">{label}</dt>
          <dd class="spec-desc">{value}</dd>
        </>
      ))}
      {makers.length > 0 && (
        <>
          <dt class="spec-term">メーカー</dt>
          <dd class="spec-desc">
            {makers.map((m, i) => (
              <>
                {i > 0 && '、'}
                {makerByName.get(m) ? <a class="spec-link" href={makerByName.get(m).path}>{m}</a> : m}
              </>
            ))}
          </dd>
        </>
      )}
      {formats.length > 0 && (
        <>
          <dt class="spec-term">形式</dt>
          <dd class="spec-desc">{formats.join('・')}</dd>
        </>
      )}
    </dl>

    {agency && <p class="profile-source">所属とSNSは、所属事務所（{agency.agency}）の公式サイトに載っている情報です（{seenDay}時点）。移籍などで変わることがあります。</p>}
    {facts.length > 0 && <p class="profile-source">年齢・身長・サイズは、FANZAに載っている情報にもとづきます（載っていない項目は表示していません）。年齢は、FANZAに載っている生年月日から毎日計算しています。</p>}

    {myEvents.length > 0 && (
      <section class="section" aria-labelledby="events-title">
        <div class="section-head">
          <h2 id="events-title" class="section-title">イベントの予定</h2>
          <p class="section-note">所属事務所の公式サイトから{eventsDay && `｜${eventsDay}時点`}</p>
        </div>
        <EventList
          events={myEvents.slice(0, EVENT_ACTRESS_LIMIT)}
          today={today}
          showDay
          faces={false}
          self={group.name}
          pageOf={(n) => actressByName.get(n)?.path ?? ''}
        />
        <p class="side-more"><a class="spec-link" href={EVENT_PATH}>{myEvents.length > EVENT_ACTRESS_LIMIT ? `ほか${myEvents.length - EVENT_ACTRESS_LIMIT}件と、` : ''}ほかの女優のイベントの予定</a></p>
      </section>
    )}

    <section class="section" aria-labelledby="works-title">
      <div class="section-head">
        <h2 id="works-title" class="section-title">出演作品（{group.items.length}本）</h2>
        <p class="section-note">{listing.hidden > 0 ? `発売日が新しい順に${listing.shown.length}本を表示（ほか${listing.hidden}本は「過去の作品」の一覧にあります）` : '発売日が新しい順'}</p>
      </div>
      <div class="list-tools">
        <VrToggle />
      </div>
      <DaySection groups={groups} />
    </section>
  </div>
</Base>
