---
// FANZA同人・FANZAゲームのコレクションのページ（運営者の希望「動画のページと同じレベルのコレクションを同人とゲームにも。SEO対策も徹底的に」。2026-10-09）。
//   /doujin/genre/<印>/（ジャンル。おだやかなジャンルだけ）・/doujin/series/<FANZAの id>/（シリーズ）・/game/author/<印>/（作家）・/doujin/month/2026-10/（発売月）
// 中身: 見出し・数字（本数・セール中・最大○%OFF）・ジャンルのチップ → 人気の作品（人気の高い順に60本）→ おもなサークル/ブランド → ほかの月（発売月だけ）。
// コメントのある作品が無いあいだは、検索エンジンに出さない（FANZAの情報を並べただけのページにしない。ほかのページと同じ決まり）
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FloorCard from '../../../components/FloorCard.astro';
import FloorMoreNav from '../../../components/FloorMoreNav.astro';
import { activeFloors, floorCollectionGroups, floorMakerById, floors, readings, today } from '../../../lib/data.js';
import { readingLine } from '../../../lib/kana.js';
import {
  FLOORS, FLOOR_COLLECTIONS, FLOOR_COLLECTION_KINDS, FLOOR_COLLECTION_LIST, collectionDescription, collectionFacts, collectionHeading, collectionIndexable, collectionTitle,
  floorCollectionIndexPath, floorItemListLd, floorPath, priceNote, relatedFloorGenres, saleBadgeOf, topGenres, topMakersIn,
} from '../../../lib/floors.js';
import { SITE_NAME, SITE_URL, breadcrumbLd, dateParts } from '../../../lib/items.js';

export function getStaticPaths() {
  return activeFloors.flatMap((floor) => FLOOR_COLLECTION_KINDS.flatMap((kind) => floorCollectionGroups[floor][kind].map((group) => ({
    params: { floor, kind, slug: group.slug },
    props: { group, floor },
  }))));
}

const { group, floor: key } = Astro.props;
const f = FLOORS[key];
const c = FLOOR_COLLECTIONS[group.kind];
const data = floors[key];
const shown = group.items.slice(0, FLOOR_COLLECTION_LIST);
const facts = collectionFacts(group.items, today);
const genreByName = new Map(floorCollectionGroups[key].genre.map((g) => [g.name, g]));
const genres = (group.kind === 'genre' ? relatedFloorGenres(group.items, group.name, 8) : topGenres(group.items, 8)).filter((g) => g.count >= 2).map((g) => ({ ...g, path: genreByName.get(g.name)?.path }));
const makers = group.kind === 'series' && topMakersIn(group.items, 2).length <= 1 ? [] : topMakersIn(group.items, 8).filter((m) => m.count >= 2).map((m) => ({ ...m, path: floorMakerById[key].get(m.id)?.path }));
const months = floorCollectionGroups[key].month;
const at = group.kind === 'month' ? months.findIndex((g) => g.slug === group.slug) : -1;
const older = at >= 0 ? months[at + 1] ?? null : null;
const newer = at > 0 ? months[at - 1] : null;
const day = data.updated ? dateParts(data.updated) : dateParts(today);
const ym = `${day.y}年${day.m}月`;
const trail = [
  { name: 'トップ', path: '/' },
  { name: f.label, path: floorPath(key) },
  { name: c.find, path: floorCollectionIndexPath(key, group.kind) },
  { name: group.name, path: group.path },
];
const noindex = !collectionIndexable(group);
// 読みがな（ジャンル・シリーズ・作家。FANZA公式のAPIから。見出しの下と、構造化データの alternateName に。2026-10-10）
const ruby = ['genre', 'series', 'author'].includes(group.kind) ? readingLine(group.name, readings.of(key, group.kind, group.kind === 'series' ? group.slug : group.name)) : '';
const alt = ruby ? { alternateName: ruby } : {};
const about = group.kind === 'series' ? { '@type': 'CreativeWorkSeries', name: group.name, ...alt }
  : group.kind === 'author' ? { '@type': 'Person', name: group.name, ...alt }
    : group.kind === 'genre' ? { '@type': 'Thing', name: group.name, ...alt } : undefined;
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: collectionHeading(f, group),
  url: SITE_URL + group.path,
  ...(about ? { about } : {}),
  ...(data.updated ? { dateModified: data.updated } : {}),
};
---

<Base
  title={collectionTitle(f, group, ym, SITE_NAME)}
  description={collectionDescription(f, group, facts)}
  path={group.path}
  noindex={noindex}
  jsonLd={[breadcrumbLd(trail), pageLd, floorItemListLd(shown, SITE_URL)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">{collectionHeading(f, group)}</h1>
      {ruby && <p class="hero-ruby">{ruby}</p>}
      <p class="page-facts">{facts.total}本{facts.sale > 0 && `・セール中${facts.sale}本`}{facts.maxOff > 0 && `（最大${facts.maxOff}%OFF）`}{facts.upcoming > 0 && `・予約${facts.upcoming}本`}</p>
      {data.updated && <p class="page-updated">{day.m}月{day.d}日更新</p>}
    </section>

    {makers.length > 0 && (
      <section class="section" aria-labelledby="fl-col-makers-title">
        <div class="section-head">
          <h2 id="fl-col-makers-title" class="section-title">おもな{f.maker}</h2>
        </div>
        <nav class="sale-jump genre-chips" aria-label={`おもな${f.maker}`}>
          {makers.map((m) => (m.path
            ? <a class="chip-link" href={m.path}>{m.name}<span class="chip-count">{m.count}本</span></a>
            : <span class="chip-link chip-static">{m.name}<span class="chip-count">{m.count}本</span></span>))}
        </nav>
      </section>
    )}

    {genres.length > 0 && (
      <section class="section" aria-labelledby="fl-col-genres-title">
        <div class="section-head">
          <h2 id="fl-col-genres-title" class="section-title">{group.kind === 'genre' ? 'いっしょに付いていることが多いジャンル' : '多いジャンル'}</h2>
        </div>
        <nav class="sale-jump genre-chips" aria-label="ジャンル">
          {genres.map((g) => (g.path
            ? <a class="chip-link" href={g.path}>{g.name}<span class="chip-count">{g.count}本</span></a>
            : <span class="chip-link chip-static">{g.name}<span class="chip-count">{g.count}本</span></span>))}
        </nav>
      </section>
    )}

    <section class="section" aria-labelledby="fl-col-works-title">
      <div class="section-head">
        <h2 id="fl-col-works-title" class="section-title">{group.kind === 'type' ? `人気順 TOP${shown.filter((i) => i.rank).length}` : `作品（${group.total}本）`}</h2>
        <p class="section-note">人気の高い順{group.total > shown.length && `（上位${shown.length}本）`}</p>
      </div>
      <ul class="shelf">
        {shown.map((item, i) => <li class="shelf-cell"><FloorCard item={item} badge={group.kind === 'type' && item.rank ? `${i + 1}位` : saleBadgeOf(item)} note={priceNote(item)} eager={i < 4} /></li>)}
      </ul>
    </section>

    {group.kind === 'month' && (
      <nav class="month-nav" aria-label="ほかの月">
        {older ? <a class="month-nav-link" href={older.path}>← {older.name}</a> : <span></span>}
        <a class="month-nav-link" href={floorCollectionIndexPath(key, 'month')}>月の一覧</a>
        {newer ? <a class="month-nav-link" href={newer.path}>{newer.name} →</a> : <span></span>}
      </nav>
    )}
    {group.kind === 'type' && <FloorMoreNav floorKey={key} current={group.slug} />}
    {group.kind !== 'month' && group.kind !== 'type' && (
      <p class="more"><a class="btn btn-quiet" href={floorCollectionIndexPath(key, group.kind)}>ほかの{c.label}を見る</a></p>
    )}
  </div>
</Base>
