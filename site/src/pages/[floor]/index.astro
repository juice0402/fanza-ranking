---
// FANZA同人（/doujin/）・FANZAゲーム（/game/）の売り場のトップ（運営者の希望「同人・ゲームのページも」。2026-10-09。lib/floors.js）。
// データは毎日の更新が集める doujin.json・game.json（人気順の上から 同人1,000本・ゲーム500本。未成年を連想させる作品は入れていない）。
// 形は動画のトップ（pages/index.astro）と同じ（運営者の希望「動画のページは完成度が高いので、ほぼ同じ要領で同人とゲームも」。2026-10-09。CSS も同じものを使う）:
//   スマホ: 見出し → きょうの人気TOP3 → 作品を探す → きょうの話題 → いま人気のサークル/ブランド・作家 → 特集 → セール中 → 人気ランキング（4位から）→ 形式別（同人）→ 新作で人気 → 運命の作品 → 予約（ゲーム）
//   パソコン（960px〜）: 見出しは横いっぱい、左に TOP3 → セール中 → 人気ランキング → 形式別 → 新作で人気 → 予約、右の欄に 作品を探す → きょうの話題 → いま人気のサークル → 特集 → 運命の作品
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FloorCard from '../../components/FloorCard.astro';
import FloorTop3 from '../../components/FloorTop3.astro';
import FloorTopics from '../../components/FloorTopics.astro';
import FloorHotSquares from '../../components/FloorHotSquares.astro';
import FloorSaleCards from '../../components/FloorSaleCards.astro';
import GachaCorner from '../../components/GachaCorner.astro';
import TenYenHero from '../../components/TenYenHero.astro';
import { activeFloors, floorCollectionGroups, floorEntityRankings, floorGachaPools, floorMakerGroups, floorRankHistory, floorSaleHistory, floorSalePageGroups, floors, tenYenNow } from '../../lib/data.js';
import {
  DOUJIN_TYPES, FLOORS, FLOOR_HUB_SHOWN, floorCollectionIndexPath, floorEntityLabel, floorEntityRankingPath, floorItemListLd, floorMakerIndexPath, floorMaxOff, floorNewPopular,
  floorPath, floorRankNote, floorRanking, floorRankingPath, floorSaleHistoryPath, floorSaleItems, floorSalePath, floorSearchPath, floorTopics, floorUpcoming, hubThemes, priceNote,
} from '../../lib/floors.js';
import { listIndexable } from '../../lib/plan.js';
import { SITE_NAME, SITE_URL, breadcrumbLd, dateParts } from '../../lib/items.js';
import { assetUrl, inlineScript } from '../../lib/assets.js';

export function getStaticPaths() {
  return activeFloors.map((floor) => ({ params: { floor } }));
}

const { floor: key } = Astro.params;
const f = FLOORS[key];
const data = floors[key];
const items = data.items;
const day = data.updated ? dateParts(data.updated) : null;
const dayLabel = day ? `${day.m}月${day.d}日` : '毎日';
const ranking = floorRanking(items, FLOOR_HUB_SHOWN + 3);
const top3 = ranking.slice(0, 3);
const rest = ranking.slice(3);
const hist = floorRankHistory[key];
const since = floorRankHistory.since[key];
const restNotes = rest.map((item) => (data.updated ? floorRankNote(hist.get(item.cid), data.updated, since) : ''));
const sale = floorSaleItems(items);
const maxOff = floorMaxOff(sale);
const salePages = floorSalePageGroups[key];
const topics = floorTopics(items, hist, data.updated);
const newPop = data.updated ? floorNewPopular(items, data.updated) : [];
const upcomingList = floorUpcoming(items);
const cols = floorCollectionGroups[key];
const types = cols.type;
const themes = hubThemes(cols.theme);
const hot = ['maker', 'author'].filter((by) => floorEntityRankings[key][by]?.length >= 3).map((by) => ({ by, label: floorEntityLabel(f, by), path: floorEntityRankingPath(key, by), rows: floorEntityRankings[key][by].slice(0, 3) }));
const other = activeFloors.find((k) => k !== key);
const gacha = floorGachaPools[key];
const hasGacha = gacha.length >= 3;
// 運命の作品のスマホの置き場所（新作で人気の下。無ければ人気ランキングの下）
const gachaIn = newPop.length > 0 ? 'new' : 'rank';
// 左の欄の欄の数（右の欄は、この数の行をまたいで縦に伸ばす。site.css の .home.has-side）。いちばん下の注記も1つに数える
const mainCount = [top3.length > 0, salePages.length > 0, rest.length > 0, types.length > 0, newPop.length > 0, upcomingList.length > 0].filter(Boolean).length + 1;
// 運命の作品を、パソコンでは右の欄（#side-corner）へ移す小さなスクリプト（動画のトップと同じ。幅が変われば戻す）
const GACHA_MOVE_JS = "(function(){var c=document.getElementById('gacha'),s=document.getElementById('side-corner'),h=document.getElementById('gacha-home');if(!c||!s||!h||!window.matchMedia)return;var m=window.matchMedia('(min-width: 960px)');function place(){var t=m.matches?s:h;if(c.parentNode===t)return;t.appendChild(c);}place();if(m.addEventListener)m.addEventListener('change',place);else if(m.addListener)m.addListener(place);})();";
const trail = [
  { name: 'トップ', path: '/' },
  { name: f.label, path: floorPath(key) },
];
// コメントのある作品が1本も無いあいだは、検索エンジンに出さない（FANZAの情報を並べただけのページにしない）
const noindex = !listIndexable([...ranking, ...sale.slice(0, 12), ...newPop, ...upcomingList]) || items.every((i) => !i.comment);
// この売り場の10円セールの開催中は、タイトルにも出す（検索結果で目に入るように。2026-10-09）
const tenLive = tenYenNow.counts[key] > 0;
const title = `${f.label}の人気作品・セール情報【${tenLive ? '10円セール開催中' : `${dayLabel}更新`}】${maxOff && !tenLive ? `最大${maxOff}%OFF` : ''}｜${SITE_NAME}`;
const description = `${f.label}の人気作品${items.length}本を、毎日のFANZAの人気順でまとめています。人気TOP3・${f.maker}ランキング・セール中の作品${sale.length}本${maxOff ? `（最大${maxOff}%OFF）` : ''}${upcomingList.length ? '・予約受付中の作品' : ''}も。毎日、日付が変わったあとに更新します。`;
const pageLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${f.label}の人気作品・セール情報`, url: SITE_URL + floorPath(key), ...(data.updated ? { dateModified: data.updated } : {}) };
---

<Base title={title} description={description} path={floorPath(key)} noindex={noindex} jsonLd={[breadcrumbLd(trail), pageLd, floorItemListLd(ranking, SITE_URL, 15)]} tenYenBar={false}>
  {tenYenNow.total > 0 && <script is:inline id="sale-early" set:html={inlineScript('/sale.js')} />}
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <div class="home has-side" style={`--side-span: ${mainCount}${tenYenNow.total > 0 ? '; --side-start: 3' : ''}`}>
      <header class="today-head">
        {day && <p class="today-date"><time datetime={data.updated}>{day.m}月{day.d}日（{day.wd}）</time>の更新</p>}
        <h1 class="today-title">{f.label}の人気作品</h1>
      </header>

      <TenYenHero first={key} />

      {top3.length > 0 && (
        <section class="today-top" aria-labelledby="fl-top-title">
          <div class="today-sec-head">
            <h2 id="fl-top-title" class="today-sec-title">きょうの人気TOP3</h2>
            <p class="section-note">FANZAの人気順{day && `｜${dayLabel}時点`}</p>
          </div>
          <FloorTop3 items={top3} hist={hist} day={data.updated} since={since} />
        </section>
      )}

      <div class="home-side">
        <section class="find" aria-labelledby="fl-find-title">
          <h2 id="fl-find-title" class="find-title">作品を探す</h2>
          <form class="hero-search search-bar" action={floorSearchPath(key)} method="get" role="search">
            <svg class="search-bar-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 20 20" /></svg>
            <label class="visually-hidden" for="fl-q">{f.label}の作品を探す（タイトル・{f.maker}{key === 'game' ? '・作家' : ''}）</label>
            <input id="fl-q" class="search-bar-input" type="search" name="q" placeholder={key === 'game' ? 'タイトル・ブランド・作家' : 'タイトル・サークル'} enterkeyhint="search" autocomplete="off" />
            <button class="search-bar-btn" type="submit">探す</button>
          </form>
          <nav class="hero-jump" aria-label="探し方">
            <a class="chip-link chip-link-wide" href={floorRankingPath(key)}>人気ランキング</a>
            {cols.genre.length > 0 && <a class="chip-link" href={floorCollectionIndexPath(key, 'genre')}>ジャンル検索</a>}
            {floorMakerGroups[key].length > 0 && <a class="chip-link" href={floorMakerIndexPath(key)}>{f.maker}検索</a>}
            {sale.length > 0 && <a class="chip-link" href={floorSalePath(key)}>セール</a>}
          </nav>
          <nav class="hero-jump floor-jump" aria-label="ほかの売り場">
            <a class="chip-link" href="/">FANZA動画</a>
            {other && <a class="chip-link" href={floorPath(other)}>{FLOORS[other].label}</a>}
          </nav>
        </section>

        {topics.length > 0 && (
          <section class="today-topics" aria-labelledby="fl-topics-title">
            <div class="today-sec-head">
              <h2 id="fl-topics-title" class="today-sec-title">きょうの話題</h2>
              <p class="section-note">毎日入れかわります</p>
            </div>
            <FloorTopics topics={topics} />
          </section>
        )}

        {hot.map((h) => (
          <section class="today-hot" aria-labelledby={`fl-hot-${h.by}`}>
            <div class="today-sec-head">
              <h2 id={`fl-hot-${h.by}`} class="today-sec-title">いま人気の{h.label}</h2>
              <a class="subsection-more" href={h.path}>ランキングを見る</a>
            </div>
            <FloorHotSquares rows={h.rows} />
          </section>
        ))}

        {themes.length > 0 && (
          <section class="today-themes" aria-labelledby="fl-theme-title">
            <div class="today-sec-head">
              <h2 id="fl-theme-title" class="today-sec-title">特集</h2>
              <a class="subsection-more" href={floorCollectionIndexPath(key, 'theme')}>特集の一覧</a>
            </div>
            <ul class="name-grid">
              {themes.map((g) => (
                <li>
                  <a class="name-link" href={g.path} title={g.heading}>
                    <span class="name-link-name">{g.name}</span>
                    <span class="name-link-count">{g.total}本</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {hasGacha && <div id="side-corner" class="side-corner"></div>}
      </div>

      {salePages.length > 0 && (
        <section class="section" aria-labelledby="fl-sale-title">
          <div class="section-head">
            <h2 id="fl-sale-title" class="section-title">セール中</h2>
            <a class="subsection-more" href={floorSalePath(key)}>{sale.length}本を見る</a>
          </div>
          <FloorSaleCards pages={salePages.slice(0, 4)} key={key} />
          <p class="section-note sale-note"><a class="spec-link" href={floorSaleHistoryPath(key)}>{f.label}のセールはいつ？</a></p>
        </section>
      )}

      {rest.length > 0 && (
        <section class="section" aria-labelledby="fl-rank-title">
          <div class="section-head">
            <h2 id="fl-rank-title" class="section-title">人気ランキング</h2>
            <a class="subsection-more" href={floorRankingPath(key)}>TOP100を見る</a>
          </div>
          <ul class="shelf">
            {rest.map((item, i) => <li class="shelf-cell"><FloorCard item={item} badge={`${i + 4}位`} note={priceNote(item)} rankNote={restNotes[i]} /></li>)}
          </ul>
          {hasGacha && gachaIn === 'rank' && (
            <div id="gacha-home" class="gacha-home">
              <GachaCorner gacha={gacha} floor={key} level="h2" />
              <script is:inline set:html={GACHA_MOVE_JS} />
            </div>
          )}
        </section>
      )}

      {types.length > 0 && (
        <section class="section" aria-labelledby="fl-type-title">
          <div class="section-head">
            <h2 id="fl-type-title" class="section-title">形式別ランキング</h2>
          </div>
          {/* 形式ごとの上位3本は、きょうの人気TOP3と同じメダルの3つ並び（画面の幅に合わせて大きさが変わる。運営者の指摘「端末によってはものすごく小さく見える」。2026-10-09） */}
          <div class="type-grid">
            {types.map((g) => (
              <div class="type-block">
                <div class="subsection-head">
                  <h3 class="subsection-title">{DOUJIN_TYPES.find((t) => t.slug === g.slug)?.short ?? g.name}</h3>
                  <a class="subsection-more" href={g.path}>TOPを見る</a>
                </div>
                <FloorTop3 items={g.items.slice(0, 3)} eager={false} />
              </div>
            ))}
          </div>
        </section>
      )}

      {newPop.length > 0 && (
        <section class="section" aria-labelledby="fl-new-title">
          <div class="section-head">
            <h2 id="fl-new-title" class="section-title">新作で人気</h2>
            <p class="section-note">最近30日の発売</p>
          </div>
          <ul class="shelf">
            {newPop.map((item) => <li class="shelf-cell"><FloorCard item={item} note={priceNote(item)} /></li>)}
          </ul>
          {hasGacha && gachaIn === 'new' && (
            <div id="gacha-home" class="gacha-home">
              <GachaCorner gacha={gacha} floor={key} level="h2" />
              <script is:inline set:html={GACHA_MOVE_JS} />
            </div>
          )}
        </section>
      )}

      {upcomingList.length > 0 && (
        <section class="section" aria-labelledby="fl-up-title">
          <div class="section-head">
            <h2 id="fl-up-title" class="section-title">予約受付中</h2>
            <p class="section-note">発売日の近い順</p>
          </div>
          <ul class="shelf">
            {upcomingList.map((item) => <li class="shelf-cell"><FloorCard item={item} note={priceNote(item)} /></li>)}
          </ul>
        </section>
      )}

      <p class="section-note run-note">価格・セールは{dayLabel}の時点の情報です。くわしくはFANZAで確かめてください。</p>
    </div>
  </div>

  {hasGacha && <script is:inline src={assetUrl('/gacha.js')} defer></script>}
</Base>
