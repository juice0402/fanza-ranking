---
// FANZA同人・FANZAゲームの人気ランキング（/doujin/ranking/・/game/ranking/。2026-10-09。lib/floors.js）。
// 毎日の更新が取った、その日のFANZAの人気順（発売済み）の上から100本。未成年を連想させる作品は入れていないので、順位は、このサイトに載っている作品の中で1位から数え直す
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FloorCard from '../../components/FloorCard.astro';
import FloorMoreNav from '../../components/FloorMoreNav.astro';
import { activeFloors, floorRankHistory, floors } from '../../lib/data.js';
import { FLOORS, FLOOR_PERIODS, FLOOR_RANKING_LIMIT, floorItemListLd, floorPath, floorPeriodPath, floorRankNote, floorRanking, floorRankingName, floorRankingPath, priceNote } from '../../lib/floors.js';
import { listIndexable } from '../../lib/plan.js';
import { SITE_NAME, SITE_URL, breadcrumbLd, dateParts, formatDateJp } from '../../lib/items.js';

export function getStaticPaths() {
  return activeFloors.map((floor) => ({ params: { floor } }));
}

const { floor: key } = Astro.params;
const f = FLOORS[key];
const data = floors[key];
const list = floorRanking(data.items, FLOOR_RANKING_LIMIT);
const day = data.updated ? dateParts(data.updated) : null;
const trail = [
  { name: 'トップ', path: '/' },
  { name: f.label, path: floorPath(key) },
  { name: floorRankingName(key), path: floorRankingPath(key) },
];
// 素人は「女の子ランキング（日刊）」（作品のタイトルが女の子の名前。運営者の希望「公式サイトの日刊女の子ランキングのように」。2026-10-12）
const name = f.girls ? '女の子ランキング（日刊）' : '人気ランキング';
const noindex = list.length === 0 || !listIndexable(list);
// 前日からの動きと、最近30日の最高順位（人気の動きの記録。scripts/floor_history.py。2026-10-09）
const hist = floorRankHistory[key];
const notes = list.map((item) => (data.updated ? floorRankNote(hist.get(item.cid), data.updated, floorRankHistory.since[key]) : ''));
const hasNotes = notes.some(Boolean);
---

<Base
  title={`${f.label}${f.girls ? ' ' : 'の'}${name}TOP${list.length}【${day ? `${day.m}月${day.d}日` : '毎日'}更新】｜${SITE_NAME}`}
  description={`${f.label}の${f.kind}を、その日のFANZAの人気順に${list.length}本並べたランキングです。${hasNotes ? '前日からの順位の動き・最近30日の最高順位、' : ''}価格・セール中の作品・${f.maker}も。毎日、日付が変わったあとに更新します。`}
  path={floorRankingPath(key)}
  noindex={noindex}
  jsonLd={[breadcrumbLd(trail), floorItemListLd(list, SITE_URL)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">{f.girls ? name : `${f.label}の人気ランキング`}</h1>
      <p class="hero-lead">その日のFANZAの人気順です。</p>
      {f.girls && (
        <nav class="sale-jump genre-chips" aria-label="週間・月間">
          {FLOOR_PERIODS.map((p) => <a class="chip-link" href={floorPeriodPath(key, p.span)}>{p.name}ランキング</a>)}
        </nav>
      )}
    </section>

    <section class="section" aria-labelledby="fl-ranking-title">
      <div class="section-head">
        <h2 id="fl-ranking-title" class="section-title">人気順 TOP{list.length}</h2>
        {data.updated && <p class="section-note">{formatDateJp(data.updated)}の人気順{hasNotes && '。▲▼は前の日との差'}</p>}
      </div>
      <ul class="shelf">
        {list.map((item, i) => <li class="shelf-cell"><FloorCard item={item} badge={`${i + 1}位`} eager={i < 4} note={priceNote(item)} rankNote={notes[i]} /></li>)}
      </ul>
    </section>

    <FloorMoreNav floorKey={key} current="works" />
  </div>
</Base>
