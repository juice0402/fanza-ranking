---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VrToggle from '../../components/VrToggle.astro';
import { all, itemsIndex, paged, today } from '../../lib/data.js';
import { ACTRESS_INDEX_PATH, MAKER_INDEX_PATH, SITE_NAME, archivePath, breadcrumbLd } from '../../lib/items.js';
import Thumb from '../../components/Thumb.astro';
import { ITEMS_INDEX_PATH, SEARCH_COUNT_BLANK, SEARCH_COUNT_BLANK_NOTE, SEARCH_PATH, searchFirstPage } from '../../lib/search.js';

const trail = [
  { name: 'トップ', path: '/' },
  { name: '作品を探す', path: SEARCH_PATH },
];
const hasWorks = all.some((i) => paged.has(i.cid));
// 条件なし（新しい順・すべて）のときの、はじめの一覧・ジャンルのボタン。索引を待たずに、ページを開いたときから見える（2026-10-07。lib/search.js）
const first = hasWorks ? searchFirstPage(itemsIndex(), today) : null;
// 検索画面は、条件の組み合わせごとに内容が変わる（JavaScriptで作る）ので、検索エンジンには載せない（noindex）
import { assetUrl } from '../../lib/assets.js';
---

<Base
  title={`作品を探す｜${SITE_NAME}`}
  description="FANZAの新作・予約作品を、タイトル・出演者・メーカー・ジャンル（タグ）で絞り込んで探せます。VR作品を隠すこともできます。"
  path={SEARCH_PATH}
  noindex={true}
  jsonLd={[breadcrumbLd(trail)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero search-hero">
      <h1 class="hero-title">作品を探す</h1>
    </section>

    {hasWorks && (
      <section id="work-search" class="work-search section search-layout" data-index={ITEMS_INDEX_PATH} aria-labelledby="ws-title">
        {/* 作品検索（運営者の希望「スタイリッシュじゃない。ほかの雰囲気と合わせて刷新」。2026-10-06）:
            紙の色の検索バー（赤い「探す」）→ 発売・並び順は押して選ぶ丸いボタン（選んだものは黄色）→ ジャンル（スマホは横に流れる1行。「すべて」で全部）→ 結果。
            スマホは「条件 → 結果」の1列、パソコン（960px〜）は「左に条件（画面に固定）｜右に結果」の2列 */}
        <div class="search-side">
        <h2 id="ws-title" class="visually-hidden">条件で探す</h2>
        <form class="ws-form" role="search" autocomplete="off">
          <div class="search-bar">
            <svg class="search-bar-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 20 20" /></svg>
            <label class="visually-hidden" for="ws-q">キーワード（タイトル・出演者・メーカー・品番・ジャンル）</label>
            <input id="ws-q" class="search-bar-input" type="search" name="q" placeholder="タイトル・出演者・品番" enterkeyhint="search" />
            <button type="submit" class="search-bar-btn">探す</button>
          </div>

          <fieldset class="seg">
            <legend class="seg-label">発売</legend>
            <div class="seg-row">
              <label class="seg-opt"><input type="radio" name="status" value="" checked /><span>すべて</span></label>
              <label class="seg-opt"><input type="radio" name="status" value="released" /><span>発売中</span></label>
              <label class="seg-opt"><input type="radio" name="status" value="upcoming" /><span>予約</span></label>
            </div>
          </fieldset>

          <fieldset class="seg">
            <legend class="seg-label">並び順</legend>
            <div class="seg-row seg-scroll">
              <label class="seg-opt"><input type="radio" name="sort" value="new" checked /><span>新しい順</span></label>
              <label class="seg-opt"><input type="radio" name="sort" value="popnew" /><span>新着の人気順</span></label>
              <label class="seg-opt"><input type="radio" name="sort" value="pop" /><span>全体の人気順</span></label>
              <label class="seg-opt"><input type="radio" name="sort" value="review" /><span>評価が高い順</span></label>
              <label class="seg-opt"><input type="radio" name="sort" value="old" /><span>古い順</span></label>
            </div>
          </fieldset>

          <fieldset class="seg ws-tags">
            <legend class="seg-label">ジャンル<span class="seg-sub">（選んだものを全部含む作品）</span></legend>
            <ul id="ws-tag-list" class="ws-tag-list" data-first="1">
              {first.tags.map((t) => (
                <li hidden={t.hidden}><button type="button" class="tag-btn" aria-pressed="false" data-n={t.n} data-name={t.name} disabled={t.count === 0}><span class="tag-name">{t.name}</span><span class="tag-count">{t.count}</span></button></li>
              ))}
            </ul>
            <button id="ws-tag-more" type="button" class="tag-more" aria-expanded="false" hidden={!first.tagMore}>すべてのジャンル</button>
          </fieldset>

          <div class="as-actions">
            <VrToggle />
            <button type="reset" class="clear-link">条件をクリア</button>
          </div>
        </form>
        </div>

        <div class="search-main">
        <h2 class="visually-hidden">検索結果</h2>
        {/* 本数は、絞り込んだときだけ（条件なしは「ーー本」。索引は最大3,000本で、掲載している作品の数と誤解されるため。運営者の希望。2026-10-09。
            public/search.js の countHtml と同じ形） */}
        <p id="ws-count" class="as-count ws-count" aria-live="polite">{first.total > 0 && <><span aria-hidden="true"><strong class="ws-num ws-num-blank">{SEARCH_COUNT_BLANK}</strong>本</span><span class="visually-hidden">{SEARCH_COUNT_BLANK_NOTE}</span></>}</p>
        <ul id="ws-list" class="ws-list" data-first="1" data-today={today}>
          {first.rows.map((v) => (
            <li class="ws-row" data-c={v.c} data-vr={v.vr ? '' : undefined} data-solo={v.solo ? '' : undefined}>
              <article class="item">
                <a class="item-cover" href={v.href} tabindex="-1" aria-hidden="true">
                  {v.img && <Thumb src={v.img} kind="tiny" class="item-img is-small" />}
                  {v.status === 'new' && <span class="pop pop-new">新作</span>}
                  {v.status === 'wait' && <span class="pop pop-wait">予約</span>}
                </a>
                <h3 class="item-title"><a class="item-title-link ph-js" href={v.href}>{v.title}</a></h3>
                <p class="item-cast ph-js">
                  {v.cast.length === 0 ? '出演者の記載なし' : v.cast.map((name, i) => <>{i > 0 && '、'}<span class={name.length <= 10 ? 'nb' : undefined}>{name}</span></>)}
                  {v.castMore > 0 && ` ほか${v.castMore}名`}
                </p>
                <p class="item-meta ph-js">{v.date}発売{v.maker && <>・<span class={v.maker.length <= 10 ? 'nb' : undefined}>{v.maker}</span></>}</p>
              </article>
            </li>
          ))}
        </ul>
        <p class="more"><button id="ws-more" type="button" class="btn btn-quiet more-btn" hidden={first.total <= first.rows.length}>もっと見る</button></p>
        <p class="as-coverage">予約中の作品は、ジャンルがまだ載っていないことがあります。</p>
        </div>
      </section>
    )}

    {/* JavaScript が使えないとき（と、索引を読めなかったとき）の案内。使えるときは、はじめから隠す（CSS の html.js。索引を読めなかったら is-fallback で出す） */}
    <section id="ws-fallback" class:list={['section', 'ws-fallback', { 'is-fallback': !hasWorks }]} aria-labelledby="ws-fallback-title">
      <h2 id="ws-fallback-title" class="section-title">ほかの探し方</h2>
      <noscript><p class="empty">検索を使うには、ブラウザのJavaScriptを有効にしてください。</p></noscript>
      <ul class="ws-links">
        <li><a class="spec-link" href={archivePath(1)}>過去の作品を、発売日の新しい順に見る</a></li>
        <li><a class="spec-link" href={ACTRESS_INDEX_PATH}>出演者から探す</a></li>
        <li><a class="spec-link" href={MAKER_INDEX_PATH}>メーカーから探す</a></li>
      </ul>
    </section>
  </div>

  {hasWorks && <script is:inline src={assetUrl('/search.js')} defer></script>}
</Base>
