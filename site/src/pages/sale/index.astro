---
// セール・キャンペーン中の作品（/sale/）。FANZA公式のAPIの campaign・prices から、毎日の更新が保存したもの（lib/sale.js）。
// キャンペーンは終わりが近い順、それぞれ人気の高い作品から SALE_GROUP_LIMIT 本まで。終わった時刻をすぎたものは、ブラウザで隠す（/sale.js）
// 特集ごとに、このサイトの作品から数えた「おもなメーカー・よく出ている女優・多いジャンル」も添える（どんな作品の特集か分かるように。運営者の希望。2026-10-05）
// 検索の入り口（運営者の希望「SEOを上位に」。2026-10-06）: タイトルに「開催中」「○月○日更新」「最大○%OFF」「特集○件」（毎日の数字）。
// 特集の見出しから、特集ごとのページ（/sale/<印>/）へ。「FANZAのセールはいつ？」（/sale/history/）へのリンクも
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VrToggle from '../../components/VrToggle.astro';
import ItemCard from '../../components/ItemCard.astro';
import CampaignFacts from '../../components/CampaignFacts.astro';
import { all, today, sale, contentGenres, saleCampaignBySlug } from '../../lib/data.js';
import { SALE_HISTORY_PATH, SALE_PATH, campaignSlug, endIso, endLabel, endSoonTag, saleAnchor, saleBadge, saleGroups, salePriceNote } from '../../lib/sale.js';
import { listIndexable } from '../../lib/plan.js';
import { SITE_NAME, SITE_URL, breadcrumbLd, dateParts, formatDateJp, filterAttrs } from '../../lib/items.js';

const groups = saleGroups(all, sale, today, undefined, { genres: contentGenres });
// 特集ごとのページ（未成年を連想させる名前の特集には作らない）
const pageOfCamp = (g) => saleCampaignBySlug.get(campaignSlug(g.title))?.path ?? '';
const maxOff = Math.max(0, ...groups.map((g) => g.maxOff ?? 0));
const day = sale.date ? dateParts(sale.date) : null;
const shownItems = groups.flatMap((g) => g.items);
const total = groups.reduce((n, g) => n + g.total, 0);
const trail = [
  { name: 'トップ', path: '/' },
  { name: 'セール・キャンペーン', path: SALE_PATH },
];
// 作品が無い・コメントのある作品が1本も無いあいだは、検索エンジンに出さない
const noindex = shownItems.length === 0 || !listIndexable(shownItems);
const title = groups.length > 0
  ? `FANZAセール開催中の作品一覧【${day ? `${day.m}月${day.d}日` : '毎日'}更新】${maxOff ? `最大${maxOff}%OFF・` : ''}特集${groups.length}件｜${SITE_NAME}`
  : `FANZA動画のセール・キャンペーン中の作品｜${SITE_NAME}`;
const pageLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'FANZAセール開催中の作品一覧', url: SITE_URL + SALE_PATH, ...(sale.date ? { dateModified: sale.date } : {}) };
import { inlineScript } from '../../lib/assets.js';
---

<Base
  title={title}
  description={`FANZA動画で、いま開催中のセール・キャンペーン${groups.length > 0 ? `${groups.length}件（${total}本${maxOff ? `・最大${maxOff}%OFF` : ''}）` : ''}の人気作品を、特集ごとに、終わりが近い順にまとめています。いつまでか・おもなメーカー・よく出ている女優も。毎日、日付が変わったあとに更新します。`}
  path={SALE_PATH}
  noindex={noindex}
  jsonLd={[breadcrumbLd(trail), pageLd]}
>
  {/* セールの「終わったら隠す」（public/sale.js）を、ページの先頭にそのまま入れる。中身が読み込まれるそばから印を付けるので、終わったものが見えてから消えて下がずれない（2026-10-07） */}
  {groups.length > 0 && <script is:inline id="sale-early" set:html={inlineScript('/sale.js')} />}
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">開催中のFANZAセール</h1>
      <p class="hero-lead">
        いまセール中の作品を、終わりが近い順に。{sale.date && `${formatDateJp(sale.date)}の時点の情報です（くわしくはFANZAの作品ページで確かめてください）。`}
      </p>
      <p class="hero-links"><a class="spec-link" href={SALE_HISTORY_PATH}>FANZAのセールはいつ？これまでのセールの履歴</a></p>
    </section>

    {groups.length > 0
      ? (
        <>
          <nav class="sale-jump" aria-label="特集">
            {groups.map((g) => (
              <a class="chip-link" href={`#${saleAnchor(g.k)}`} data-sale-end={endIso(g.end)}>{g.title}</a>
            ))}
          </nav>
          <div class="list-tools">
            <VrToggle />
          </div>
          {groups.map((g, gi) => (
            <section class="section sale-camp" aria-labelledby={saleAnchor(g.k)} data-sale-group data-vr-group>
              <div class="section-head">
                <h2 id={saleAnchor(g.k)} class="section-title">{pageOfCamp(g) ? <a class="title-link" href={pageOfCamp(g)}>{g.title}</a> : g.title}</h2>
                <p class="section-note">
                  {endSoonTag(g.end, today) && <span class="camp-soon">{endSoonTag(g.end, today)}</span>}
                  {endLabel(g.end)}まで{g.maxOff && `・最大${g.maxOff}%OFF`}・{g.total}本{g.total > g.items.length && `（人気の高い${g.items.length}本）`}
                </p>
              </div>
              <CampaignFacts group={g} />
              <ul class="shelf">
                {g.items.map((item, i) => (
                  <li class="shelf-cell" data-sale-end={endIso(g.end)} {...filterAttrs(item)}>
                    <ItemCard item={item} level="h3" badge={saleBadge(item.sale)} note={salePriceNote(item.sale)} eager={gi === 0 && i < 4} />
                  </li>
                ))}
              </ul>
              {pageOfCamp(g) && g.total > g.items.length && (
                <p class="more"><a class="btn btn-quiet" href={pageOfCamp(g)}>「{g.title}」の作品をもっと見る</a></p>
              )}
            </section>
          ))}
          <p class="section-note">本数は、このサイトに載っている作品（ぜんぶで{total}本）から数えています。</p>
        </>
      )
      : <p class="empty">いま、このサイトに載っている作品で、セール・キャンペーン中のものはありません。毎日、日付が変わったあとに更新します。</p>}
  </div>

</Base>
