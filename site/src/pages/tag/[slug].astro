---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VrToggle from '../../components/VrToggle.astro';
import DaySection from '../../components/DaySection.astro';
import CastFaces from '../../components/CastFaces.astro';
import MiniShelf from '../../components/MiniShelf.astro';
import RatedShelf from '../../components/RatedShelf.astro';
import { all, tagGroups, tagByName, contentGenres, genreTops, fanzaGenreTops } from '../../lib/data.js';
import { campaignSummary } from '../../lib/sale.js';
import { relatedGenres } from '../../lib/insights.js';
import { TAG_INDEX_PATH, VR_TAG_NAME, tagPageTitle, tagSummary } from '../../lib/collections.js';
import { TAG_PAGE_LIMIT } from '../../config.js';
import { breadcrumbLd, countByDate, groupByDate, shortSpan, summaryDescription } from '../../lib/items.js';
import { searchPath } from '../../lib/search.js';

// 作品が TAG_MIN_ITEMS 本以上ある、ジャンルごとに1ページ作る（作るジャンルは config.js の TAG_PAGE_GENRES と、VR作品）
export function getStaticPaths() {
  return tagGroups.map((group) => ({ params: { slug: group.slug }, props: { group } }));
}

const { group } = Astro.props;
const isVr = group.name === VR_TAG_NAME;
const summary = tagSummary(group);
const shown = group.items.slice(0, TAG_PAGE_LIMIT); // 新しい順
const groups = groupByDate(shown, countByDate(group.items));
// 内部リンク（2026-10-07）: このジャンルで人気の作品（このサイトの全作品から、FANZAの人気順の上のほう）・よく出ている女優・いっしょに付いていることが多いジャンル
// FANZA全体で人気の作品 TOP20（scripts/genre_tops.py が毎日。2026-10-10）。あれば、このサイトの作品から数えた「人気の作品」の代わりに出す
const fanzaTop = isVr ? null : fanzaGenreTops.get(group.name) ?? null;
const popular = isVr || fanzaTop ? [] : (genreTops.get(group.name) ?? []).slice(0, 6);
const mdOf = (d) => `${Number(d.slice(5, 7))}月${Number(d.slice(8, 10))}日`;
const castFaces = campaignSummary(group.items, { genres: contentGenres, limit: 6 }).actresses.slice(0, 6);
const pages = new Map([...tagByName].map(([name, g]) => [name, g.path]));
const nearGenres = isVr ? [] : relatedGenres(group.items, group.name, contentGenres, pages);
const trail = [
  { name: 'トップ', path: '/' },
  { name: 'ジャンルから探す', path: TAG_INDEX_PATH },
  { name: group.name, path: group.path },
];
---

<Base
  title={tagPageTitle(group, Boolean(fanzaTop))}
  description={summaryDescription(summary)}
  path={group.path}
  jsonLd={[breadcrumbLd(trail)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">{isVr ? 'VR作品' : group.name}の新作・予約作品</h1>
      <p class="page-facts">{group.items.length}本・{shortSpan(group.items)}発売</p>
    </section>

    {fanzaTop && (
      <section class="section" aria-labelledby="fanza-top-title" data-vr-group>
        <div class="section-head">
          <h2 id="fanza-top-title" class="section-title">FANZA全体で人気の{group.name} TOP{fanzaTop.items.length}</h2>
          <p class="section-note">{mdOf(fanzaTop.date)}のFANZAの人気順</p>
        </div>
        <MiniShelf items={fanzaTop.items} rank />
      </section>
    )}

    {popular.length > 0 && (
      <section class="section" aria-labelledby="popular-title" data-vr-group>
        <div class="section-head">
          <h2 id="popular-title" class="section-title">このジャンルで人気の作品</h2>
          <p class="section-note">FANZAの人気順（毎日の更新の時点）</p>
        </div>
        <MiniShelf items={popular} />
      </section>
    )}

    {/* 評価の高い作品（このサイトの全作品から。FANZAのレビューの評価。2026-10-10） */}
    {!isVr && <RatedShelf items={all.filter((i) => i.genres.includes(group.name))} title={`${group.name}の評価の高い作品`} id="rated-title" />}

    {castFaces.length > 0 && (
      <section class="section" aria-labelledby="cast-title">
        <div class="section-head">
          <h2 id="cast-title" class="section-title">よく出ている女優</h2>
          <p class="section-note">このページの作品の本数</p>
        </div>
        <CastFaces rows={castFaces} />
      </section>
    )}

    {nearGenres.length > 0 && (
      <section class="section" aria-labelledby="near-title">
        <div class="section-head">
          <h2 id="near-title" class="section-title">いっしょに付いていることが多いジャンル</h2>
        </div>
        <nav class="sale-jump genre-chips" aria-label={`${group.name}といっしょに付いていることが多いジャンル`}>
          {nearGenres.map((g) => <a class="chip-link" href={g.path}>{g.name}<span class="chip-count">{g.count}本</span></a>)}
        </nav>
      </section>
    )}

    <section class="section" aria-labelledby="works-title">
      <div class="section-head">
        <h2 id="works-title" class="section-title">作品（{group.items.length}本）</h2>
        <p class="section-note">発売日が新しい順</p>
      </div>
      {!isVr && (
        <div class="list-tools">
          <VrToggle />
        </div>
      )}
      <DaySection groups={groups} eagerFirst={2} keepVr={isVr} />
      {group.items.length > shown.length && (
        <p class="more"><a class="btn btn-quiet" href={searchPath(group.name)}>ほかの{group.items.length - shown.length}本は、作品検索で探せます</a></p>
      )}
    </section>
  </div>
</Base>
