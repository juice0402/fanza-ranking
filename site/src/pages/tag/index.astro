---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NameIndex from '../../components/NameIndex.astro';
import { readings, tagGroups } from '../../lib/data.js';
import { kanaIndex } from '../../lib/kana.js';
import { TAG_INDEX_PATH } from '../../lib/collections.js';
import { breadcrumbLd, SITE_NAME } from '../../lib/items.js';

const trail = [
  { name: 'トップ', path: '/' },
  { name: 'ジャンルから探す', path: TAG_INDEX_PATH },
];
// ジャンルの数が多くなれば、50音で探す（読みがなは FANZA公式のAPIから。lib/kana.js）
const index = kanaIndex(tagGroups.map((g) => ({ name: g.name, path: g.path, count: g.items.length, reading: readings.of('video', 'genre', g.name) })));
---

<Base
  title={`ジャンル別のFANZA新作・予約作品一覧｜${SITE_NAME}`}
  description="FANZAの新作・予約作品を、ジャンル（VR・巨乳・美少女・痴女など）ごとにまとめた一覧です。作品数の多い順に並べています。"
  path={TAG_INDEX_PATH}
  jsonLd={[breadcrumbLd(trail)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">ジャンルから探す</h1>
      <p class="hero-lead">作品数の多い順です。ほかの言葉では<a class="spec-link" href="/search/">作品検索</a>で探せます。</p>
    </section>

    <NameIndex index={index} label="ジャンル" prefix="tag-kana" empty="まだ一覧に載せられるジャンルがありません。毎日の更新をお待ちください。" />
  </div>
</Base>
