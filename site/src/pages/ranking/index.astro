---
// 新着の人気ランキング（/ranking/）。最近30日に発売された作品を、その日のFANZAの人気順に（lib/popularity.js）
import Base from '../../layouts/Base.astro';
import RankingList from '../../components/RankingList.astro';
import { all, today, popularity } from '../../lib/data.js';
import { RANKING_PATH, newRanking } from '../../lib/popularity.js';
import { listIndexable } from '../../lib/plan.js';
import { SITE_NAME, breadcrumbLd } from '../../lib/items.js';

const list = newRanking(all, today);
const trail = [
  { name: 'トップ', path: '/' },
  { name: '新着の人気ランキング', path: RANKING_PATH },
];
// 作品が無い・コメントのある作品が1本も無いあいだは、検索エンジンに出さない
const noindex = list.length === 0 || !listIndexable(list);
---

<Base
  title={`FANZA新作の人気ランキング（最近30日の発売）｜${SITE_NAME}`}
  description="最近30日に発売されたFANZA動画の新作を、その日の人気順に並べたランキングです。毎日、日付が変わったあとに更新します。"
  path={RANKING_PATH}
  noindex={noindex}
  jsonLd={[breadcrumbLd(trail)]}
>
  <RankingList kind="new" list={list} date={popularity.date} trail={trail} />
</Base>
