---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VrToggle from '../../components/VrToggle.astro';
import DaySection from '../../components/DaySection.astro';
import { monthGroups } from '../../lib/data.js';
import { MONTH_INDEX_PATH, monthPageTitle, monthSummary, neighborMonths } from '../../lib/collections.js';
import { breadcrumbLd, groupByDate, shortSpan, summaryDescription } from '../../lib/items.js';

// 作品が MONTH_MIN_ITEMS 本以上ある月ごとに1ページ作る
export function getStaticPaths() {
  return monthGroups.map((group) => ({ params: { ym: group.ym }, props: { group } }));
}

const { group } = Astro.props;
const summary = monthSummary(group);
const groups = groupByDate(group.items);
const { newer, older } = neighborMonths(monthGroups, group.ym);
const trail = [
  { name: 'トップ', path: '/' },
  { name: '月ごとの新作', path: MONTH_INDEX_PATH },
  { name: `${group.name}発売`, path: group.path },
];
---

<Base
  title={monthPageTitle(group)}
  description={summaryDescription(summary)}
  path={group.path}
  jsonLd={[breadcrumbLd(trail)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">{group.name}発売のFANZA新作・予約作品</h1>
      <p class="page-facts">{group.items.length}本・{shortSpan(group.items)}発売</p>
    </section>

    <nav class="month-nav" aria-label="ほかの月">
      {older ? <a class="month-nav-link" href={older.path}>← {older.name}</a> : <span></span>}
      <a class="month-nav-link" href={MONTH_INDEX_PATH}>月の一覧</a>
      {newer ? <a class="month-nav-link" href={newer.path}>{newer.name} →</a> : <span></span>}
    </nav>

    <section class="section" aria-labelledby="works-title">
      <div class="section-head">
        <h2 id="works-title" class="section-title">{group.name}発売の作品（{group.items.length}本）</h2>
        <p class="section-note">発売日の早い順</p>
      </div>
      <div class="list-tools">
        <VrToggle />
      </div>
      <DaySection groups={groups} eagerFirst={2} />
    </section>
  </div>
</Base>
