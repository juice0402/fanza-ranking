---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VrToggle from '../../components/VrToggle.astro';
import DaySection from '../../components/DaySection.astro';
import TrendFacts from '../../components/TrendFacts.astro';
import PickCards from '../../components/PickCards.astro';
import { curated, monthGroups, monthlyByMonth, roundups } from '../../lib/data.js';
import { monthlyDescription, monthlyLd } from '../../lib/monthly.js';
import { roundupsInMonth } from '../../lib/insights.js';
import { roundupTitle, weeklyPath } from '../../lib/roundups.js';
import { MONTH_INDEX_PATH, monthPageTitle, monthSummary, neighborMonths } from '../../lib/collections.js';
import { breadcrumbLd, formatDateJp, groupByDate, shortSpan, summaryDescription } from '../../lib/items.js';

// 作品が MONTH_MIN_ITEMS 本以上ある月ごとに1ページ作る
export function getStaticPaths() {
  return monthGroups.map((group) => ({ params: { ym: group.ym }, props: { group } }));
}

const { group } = Astro.props;
const summary = monthSummary(group);
const groups = groupByDate(group.items);
const { newer, older } = neighborMonths(monthGroups, group.ym);
// この月の週のまとめ（週の月曜日がこの月に入る記事。2026-10-07。内部リンク）
const weeks = roundupsInMonth(roundups, group.ym);
// この月のまとめ記事（Claude が翌月1日に書く。2026-10-07 から。lib/monthly.js）
const article = monthlyByMonth.get(group.ym) ?? null;
const byCid = new Map(curated.map((i) => [i.cid, i]));
const picks = article ? article.picks.map((p) => ({ note: p.note, item: byCid.get(p.cid) })).filter((p) => p.item) : [];
const trail = [
  { name: 'トップ', path: '/' },
  { name: '月ごとの新作', path: MONTH_INDEX_PATH },
  { name: `${group.name}発売`, path: group.path },
];
---

<Base
  title={monthPageTitle(group)}
  description={article ? monthlyDescription(article) : summaryDescription(summary)}
  path={group.path}
  jsonLd={article ? [breadcrumbLd(trail), monthlyLd(article)] : [breadcrumbLd(trail)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <section class="hero">
      <h1 class="hero-title">{group.name}発売のFANZA新作・予約作品</h1>
      <p class="page-facts">{group.items.length}本・{shortSpan(group.items)}発売</p>
    </section>

    <nav class="month-nav" aria-label="ほかの月">
      {older ? <a class="month-nav-link" href={older.path}>← {older.name}</a> : <span></span>}
      <a class="month-nav-link" href={MONTH_INDEX_PATH}>月の一覧</a>
      {newer ? <a class="month-nav-link" href={newer.path}>{newer.name} →</a> : <span></span>}
    </nav>

    {article && (
      <article class="month-article" aria-labelledby="month-article-title">
        <h2 id="month-article-title" class="section-title">{group.name}のまとめ</h2>
        <p class="meta"><time datetime={article.written}>{formatDateJp(article.written)}</time>に公開</p>
        <p class="summary">{article.lead}</p>
        <p class="fine">この導入文・傾向・ひとことは、作品情報をもとに自動で作成しています（内容の正確さは保証できません。詳細はFANZAの公式ページで）。</p>
        {article.trend && (
          <section class="section" aria-labelledby="month-trend-title">
            <h2 id="month-trend-title" class="section-title">この月の傾向</h2>
            <p class="trend-text">{article.trend}</p>
            {article.facts && <TrendFacts facts={article.facts} period="この月" prev="前の月" asOf={article.written} id="month-trend" />}
          </section>
        )}
        <PickCards picks={picks} facts={article.facts} id="month-picks-title" title={`${group.name}の注目の作品`} />
      </article>
    )}

    {weeks.length > 0 && (
      <section class="section" aria-labelledby="weeks-title">
        <h2 id="weeks-title" class="section-title">この月の週のまとめ</h2>
        <ul class="side-links">
          {weeks.map((r) => <li><a class="spec-link" href={weeklyPath(r.week_start)}>{roundupTitle(r)}</a></li>)}
        </ul>
      </section>
    )}

    <section class="section" aria-labelledby="works-title">
      <div class="section-head">
        <h2 id="works-title" class="section-title">{group.name}発売の作品（{group.items.length}本）</h2>
        <p class="section-note">発売日の早い順</p>
      </div>
      <div class="list-tools">
        <VrToggle />
      </div>
      <DaySection groups={groups} eagerFirst={2} />
    </section>
  </div>
</Base>
