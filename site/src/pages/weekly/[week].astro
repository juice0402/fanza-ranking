---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { curated, paged, roundups, actressByName, makerByName, monthGroups } from '../../lib/data.js';
import TrendFacts from '../../components/TrendFacts.astro';
import PickCards from '../../components/PickCards.astro';
import { itemHref, OUTBOUND_ATTRS } from '../../lib/plan.js';
import { breadcrumbLd, dateParts, formatDateJp, groupByDate, castLine, CAST_LIMIT } from '../../lib/items.js';
import Thumb from '../../components/Thumb.astro';
import {
  WEEKLY_INDEX_PATH,
  articleLd,
  itemsInWeek,
  neighbours,
  roundupDescription,
  roundupPageTitle,
  roundupTitle,
  weekStats,
  weeklyPath,
} from '../../lib/roundups.js';

// 記事（roundups.json）ごとに1ページ作る
export function getStaticPaths() {
  return roundups.map((roundup) => ({ params: { week: roundup.week_start }, props: { roundup } }));
}

const { roundup } = Astro.props;
const title = roundupTitle(roundup);
const week = itemsInWeek(curated, roundup.week_start);
const stats = weekStats(curated, roundup.week_start);
const byCid = new Map(curated.map((i) => [i.cid, i]));
const picks = roundup.picks.map((p) => ({ note: p.note, item: byCid.get(p.cid) })).filter((p) => p.item);
const { prev, next } = neighbours(roundups, roundup.week_start);
// この週の発売日が入る月のページ（2026-10-07。内部リンク）
const weekMonths = monthGroups.filter((g) => g.ym === roundup.week_start.slice(0, 7) || g.ym === roundup.week_end.slice(0, 7)).sort((a, b) => a.ym.localeCompare(b.ym));
const trail = [
  { name: 'トップ', path: '/' },
  { name: '週のまとめ', path: WEEKLY_INDEX_PATH },
  { name: title, path: weeklyPath(roundup.week_start) },
];
const day = (dateKey) => {
  const p = dateParts(dateKey);
  return `${p.m}月${p.d}日（${p.wd}）`;
};
---

<Base
  title={roundupPageTitle(roundup)}
  description={roundupDescription(roundup)}
  path={weeklyPath(roundup.week_start)}
  jsonLd={[breadcrumbLd(trail), articleLd(roundup)]}
>
  <div class="wrap">
    <Breadcrumb trail={trail} />

    <article>
      <header class="hero">
        <h1 class="hero-title">{title}</h1>
        <p class="meta"><time datetime={roundup.written}>{formatDateJp(roundup.written)}</time>に公開</p>
      </header>

      <p class="summary">{roundup.lead}</p>
      <p class="fine">この導入文・傾向・ひとことは、作品情報をもとに自動で作成しています（内容の正確さは保証できません。詳細はFANZAの公式ページで）。</p>

      {roundup.trend && (
        <section class="section" aria-labelledby="week-trend-title">
          <h2 id="week-trend-title" class="section-title">この週の傾向</h2>
          <p class="trend-text">{roundup.trend}</p>
          {roundup.facts && <TrendFacts facts={roundup.facts} period="この週" prev="前の週" asOf={roundup.written} id="week-trend" />}
        </section>
      )}

      <section class="section" aria-labelledby="stats-title">
        <h2 id="stats-title" class="section-title">この週のデータ</h2>
        <dl class="spec">
          <dt class="spec-term">当サイトで紹介した作品</dt>
          <dd class="spec-desc">{stats.total}本</dd>
          <dt class="spec-term">発売日別</dt>
          <dd class="spec-desc">
            <ul class="chips">
              {stats.per_day.map((d) => <li class="chip">{day(d.date)} {d.count}本</li>)}
            </ul>
          </dd>
          {stats.makers.length > 0 && (
            <>
              <dt class="spec-term">メーカー別</dt>
              <dd class="spec-desc">
                <ul class="stat-list">
                  {stats.makers.map((m) => (
                    <li class="stat">
                      {makerByName.get(m.name) ? <a class="spec-link" href={makerByName.get(m.name).path}>{m.name}</a> : m.name}
                      <span class="stat-n">{m.count}本</span>
                    </li>
                  ))}
                </ul>
              </dd>
            </>
          )}
          {stats.actresses.length > 0 && (
            <>
              <dt class="spec-term">出演が多かった人</dt>
              <dd class="spec-desc">
                <ul class="stat-list">
                  {stats.actresses.map((a) => (
                    <li class="stat">
                      {actressByName.get(a.name) ? <a class="spec-link" href={actressByName.get(a.name).path}>{a.name}</a> : a.name}
                      <span class="stat-n">{a.count}本</span>
                    </li>
                  ))}
                </ul>
              </dd>
            </>
          )}
          {stats.formats.length > 0 && (
            <>
              <dt class="spec-term">形式</dt>
              <dd class="spec-desc">{stats.formats.map((f) => `${f.name} ${f.count}本`).join('、')}</dd>
            </>
          )}
        </dl>
        <p class="fine">数字は当サイトで紹介した作品の数で、FANZA全体の発売本数ではありません。</p>
      </section>

      <PickCards picks={picks} facts={roundup.facts} />

      <section class="section" aria-labelledby="week-list-title">
        <h2 id="week-list-title" class="section-title">この週に発売された作品のうち、当サイトで紹介したもの（{week.length}本）</h2>
        {groupByDate(week).map((g) => (
          <div class="week-day">
            <h3 class="week-day-title">{day(g.dateKey)}</h3>
            {/* 作品検索の結果と同じ「小さな表紙＋タイトル・出演者」の行（スマホ1列・広い画面2列） */}
            <ul class="ws-list week-list">
              {g.items.map((i) => {
                const link = itemHref(i, paged); // 作品ページが無い作品（ほぼ無い）は、FANZAへ
                const outbound = link.external ? OUTBOUND_ATTRS : {};
                return (
                  <li class="ws-row">
                    <article class="item">
                      <a class="item-cover" href={link.href} tabindex="-1" aria-hidden="true" {...outbound}>
                        {i.image_url && <Thumb src={i.image_url} kind="tiny" class="item-img is-small" />}
                      </a>
                      <h4 class="item-title"><a class="item-title-link week-list-link" href={link.href} {...outbound}>{i.title}</a></h4>
                      <p class="item-cast">{castLine(i.actress, CAST_LIMIT, '出演者の記載なし')}</p>
                    </article>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </section>
    </article>

    {weekMonths.length > 0 && (
      <p class="side-more">{weekMonths.map((g, i) => <>{i > 0 && '・'}<a class="spec-link" href={g.path}>{g.name}発売の作品をすべて見る</a></>)}</p>
    )}

    {(prev || next) && (
      <nav aria-label="前後の週のまとめ">
        <ul class="pager">
          {prev && <li><a class="pager-link" href={weeklyPath(prev.week_start)} rel="prev">前の週</a></li>}
          <li><a class="pager-link" href={WEEKLY_INDEX_PATH}>一覧</a></li>
          {next && <li><a class="pager-link" href={weeklyPath(next.week_start)} rel="next">次の週</a></li>}
        </ul>
      </nav>
    )}
  </div>
</Base>
