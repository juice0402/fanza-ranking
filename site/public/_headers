# Cloudflare Pages が、全ページに付ける「応答ヘッダー」（ビルドの結果にそのままコピーされる）
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# ビルドで名前に「中身の印（ハッシュ）」が付くファイル（CSS など）。中身が変わると名前も変わるので、1年間ブラウザに置いてよい
# （毎回「新しくなっていないか」を確かめに行かなくなり、2ページ目からの表示が速くなる）
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 名前が変わらないスクリプト・検索の索引は、10分だけ置く（更新したときに、古いものが長く残らないように）
/actress-search.js
  Cache-Control: public, max-age=600
/favorites.js
  Cache-Control: public, max-age=600
/lightbox.js
  Cache-Control: public, max-age=600
/movie.js
  Cache-Control: public, max-age=600
/search.js
  Cache-Control: public, max-age=600
/vr-filter.js
  Cache-Control: public, max-age=600
/data/*
  Cache-Control: public, max-age=600

# アイコン（めったに変わらない）は1週間
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
